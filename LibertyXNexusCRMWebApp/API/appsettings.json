{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;AttachDbFilename=[DataPath]\\RatulCompDb.mdf;Database=RatulCompDb;Integrated Security=True;MultipleActiveResultSets=true",
    "BlobStorage": "UseDevelopmentStorage=true"

  },
  "BlobStorage": {
    "ContainerName": "client-documents"
  },
  "Jwt": {
    "Issuer": "LibertyXNexus.API",
    "Audience": "LibertyXNexus.Clients",
    "ExpiryMinutes": 60
  },
  "AllowedHosts": "*"
}
