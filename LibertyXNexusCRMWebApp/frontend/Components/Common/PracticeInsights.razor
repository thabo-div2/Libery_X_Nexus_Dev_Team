@using frontend.Services
@using Shared.DTOs.Insights
@inject InsightsService Api

@* Headline numbers for the advisor dashboard: what needs doing today and how the book is progressing. *@
<section class="insights-strip" aria-label="Practice at a glance">
    @if (Error is not null)
    {
        <p class="wf-error" role="alert">@Error</p>
    }
    else
    {
        <a class="insight-tile @(Data?.OverdueTasks > 0 ? "insight-alert" : "")" href="/tasks">
            <span class="insight-label">Open tasks</span>
            <strong class="insight-value">@Show(Data?.OpenTasks)</strong>
            <span class="insight-sub">@(Data is null ? "…" : $"{Data.OverdueTasks} overdue · {Data.DueTodayTasks} due today")</span>
        </a>

        <a class="insight-tile" href="/documents">
            <span class="insight-label">Waiting on clients</span>
            <strong class="insight-value">@Show(Data?.DocumentsWaitingOnClients)</strong>
            <span class="insight-sub">@(Data is null ? "…" : $"{Data.DocumentsToReview} uploaded, waiting for your review")</span>
        </a>

        <a class="insight-tile" href="/clients">
            <span class="insight-label">Fully onboarded</span>
            <strong class="insight-value">@(Data is null ? "–" : $"{Data.ClientsOnboarded} of {Data.ClientsTotal}")</strong>
            <span class="insight-meter" aria-hidden="true"><span style="width:@OnboardedPercent%"></span></span>
            <span class="insight-sub">@(Data is null ? "…" : $"{OnboardedPercent}% of your clients")</span>
        </a>

        <a class="insight-tile @(Data?.RenewalsNext30Days > 0 ? "insight-warn" : "")" href="advisor#renewals">
            <span class="insight-label">Renewals next 30 days</span>
            <strong class="insight-value">@Show(Data?.RenewalsNext30Days)</strong>
            <span class="insight-sub">@(Data is null ? "…" : $"{Data.RenewalsNext90Days} within 90 days")</span>
        </a>
    }
</section>
<RealtimeRefresh OnChanged="Load" />

@code {
    PracticeInsightsDto? Data;
    string? Error;

    int OnboardedPercent => Data is null || Data.ClientsTotal == 0 ? 0 : (int)Math.Round(100.0 * Data.ClientsOnboarded / Data.ClientsTotal);

    static string Show(int? value) => value?.ToString() ?? "–";

    protected override Task OnInitializedAsync() => Load();

    async Task Load()
    {
        var (value, error) = await Api.GetDashboardAsync();
        Data = value ?? Data;
        Error = value is null ? error : null;
    }
}
