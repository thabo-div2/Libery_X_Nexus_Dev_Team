@using frontend.Services
@inject CurrentUserService CurrentUser
@inject AuthService Auth
@inject NavigationManager NavigationManager

@* Add the render mode to ensure C# event handlers like @onclick are active *@
@rendermode InteractiveServer

<div class="nav-menu">

    <!-- BRAND -->
    <a class="brand" href="@(IsClientView ? "/client" : "/advisor")">

        <span class="brand-mark">N</span>

        <span class="brand-copy">
            <strong>Nexus</strong>
            <small>@(IsClientView ? "Client Portal" : "Advisor Portal")</small>
        </span>

    </a>


    <!-- NAVIGATION -->
    <nav class="nav-links">

        @if (IsClientView)
        {
            <NavLink class="nav-item"
                     href="/client"
                     Match="NavLinkMatch.All">

                <span class="nav-icon dashboard-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9.5 12 3l9 6.5V20a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z"/></svg></span>
                <span class="nav-text">Client view</span>

            </NavLink>

            <NavLink class="nav-item"
                     href="/client-messages">

                <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span>
                <span class="nav-text">Messages</span>

            </NavLink>


            <NavLink class="nav-item"
                     href="/client-chatbot">

                <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"/></svg></span>
                <span class="nav-text">AI assistant</span>

            </NavLink>

            <NavLink class="nav-item"
                     href="/client-faqs">

                <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></span>
                <span class="nav-text">FAQs</span>

            </NavLink>
        }
        else
        {
            <NavLink class="nav-item"
                     href="/advisor"
                     Match="NavLinkMatch.All">

                <span class="nav-icon dashboard-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg></span>
                <span class="nav-text">Dashboard</span>

            </NavLink>


            <NavLink class="nav-item"
                     href="/clients">

                <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
                <span class="nav-text">Clients</span>

            </NavLink>


            <NavLink class="nav-item"
                     href="/documents">

                <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg></span>
                <span class="nav-text">Documents</span>

            </NavLink>


            <NavLink class="nav-item"
                     href="/calendar">

                <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg></span>
                <span class="nav-text">Calendar</span>

            </NavLink>


            <NavLink class="nav-item"
                     href="/messages">

                <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span>
                <span class="nav-text">Messages</span>

            </NavLink>


            <NavLink class="nav-item"
                     href="/chatbot">

                <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"/></svg></span>
                <span class="nav-text">AI assistant</span>

            </NavLink>

            <NavLink class="nav-item"
                     href="/faqs">

                <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></span>
                <span class="nav-text">FAQs</span>

            </NavLink>
        }

    </nav>


    <div class="nav-spacer"></div>


    <!-- PROFILE -->
    <div class="profile-section">

        <div class="profile-avatar">
            @ProfileInitials
        </div>

        <div class="profile-details">
            <strong>@ProfileName</strong>
            <span>@ProfileRole</span>
        </div>

        <button type="button"
                class="logout-button"
                title="Sign out"
                aria-label="Sign out"
                @onclick="LogoutAsync">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </button>

    </div>
</div>

@code {
    [Parameter]
    public bool IsClientView { get; set; }

    private string ProfileName => !string.IsNullOrWhiteSpace(CurrentUser.FirstName) || !string.IsNullOrWhiteSpace(CurrentUser.LastName)
            ? $"{CurrentUser.FirstName} {CurrentUser.LastName}".Trim()
            : (IsClientView ? "My Account" : "Financial Advisor");

    private string ProfileRole => IsClientView ? "Client" : "Financial Advisor";

    private string ProfileInitials
    {
        get
        {
            var first = CurrentUser.FirstName?.Trim();
            var last = CurrentUser.LastName?.Trim();

            if (string.IsNullOrEmpty(first) && string.IsNullOrEmpty(last))
            {
                return IsClientView ? "ME" : "FA";
            }

            var initials = $"{(first?.Length > 0 ? first[0] : ' ')}{(last?.Length > 0 ? last[0] : ' ')}".Trim();
            return initials.Length > 0 ? initials.ToUpperInvariant() : (IsClientView ? "ME" : "FA");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.EnsureRestoredAsync();
    }

    private async Task LogoutAsync()
    {
        try
        {
            await Auth.LogoutAsync();
            // Force load ensures the browser fully reloads to clear auth state
            NavigationManager.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Logout failed: {ex.Message}");
        }
    }
}