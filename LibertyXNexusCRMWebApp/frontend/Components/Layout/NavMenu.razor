<div class="nav-menu">

    <!-- BRAND -->
    <a class="brand" href="@(IsClientView ? "/client" : "/advisor")">

        <span class="brand-mark">N</span>

        <span class="brand-copy">
            <strong>Nexus</strong>
            <small>@(IsClientView ? "Client Portal" : "Advisor Portal")</small>
        </span>

    </a>


    <!-- NAVIGATION -->
    <nav class="nav-links">

        @if (IsClientView)
        {
            <NavLink class="nav-item"
                     href="/client"
                     Match="NavLinkMatch.All">

                <span class="nav-icon dashboard-icon">▧</span>
                <span class="nav-text">Client view</span>

            </NavLink>

            <NavLink class="nav-item"
                     href="/client-messages">

                <span class="nav-icon">▱</span>
                <span class="nav-text">Messages</span>

            </NavLink>
        }
        else
        {
            <NavLink class="nav-item"
                     href="/advisor"
                     Match="NavLinkMatch.All">

                <span class="nav-icon dashboard-icon">▧</span>
                <span class="nav-text">Dashboard</span>

            </NavLink>


            <NavLink class="nav-item"
                     href="/clients">

                <span class="nav-icon">♧</span>
                <span class="nav-text">Clients</span>

            </NavLink>


            <NavLink class="nav-item"
                     href="/documents">

                <span class="nav-icon">♧</span>
                <span class="nav-text">Documents</span>

            </NavLink>


            <NavLink class="nav-item"
                     href="/calendar">

                <span class="nav-icon">□</span>
                <span class="nav-text">Calendar</span>

            </NavLink>


            <NavLink class="nav-item"
                     href="/messages">

                <span class="nav-icon">▱</span>
                <span class="nav-text">Messages</span>

            </NavLink>


            <NavLink class="nav-item"
                     href="/chatbot">

                <span class="nav-icon">⌘</span>
                <span class="nav-text">AI assistant</span>

            </NavLink>
        }

    </nav>


    <div class="nav-spacer"></div>


    <!-- PROFILE -->
    <div class="profile-section">

        <div class="profile-avatar">
            @ProfileInitials
        </div>

        <div class="profile-details">
            <strong>@ProfileName</strong>
            <span>@ProfileRole</span>
        </div>

        <a href="/"
           class="logout-button"
           title="Sign out"
           aria-label="Sign out">

            ↪

        </a>

    </div>

</div>

@code {
    [Parameter]
    public bool IsClientView { get; set; }

    private string ProfileName => IsClientView ? "My Account" : "Rudolf Bekker";
    private string ProfileRole => IsClientView ? "Client" : "Financial Advisor";
    private string ProfileInitials => IsClientView ? "ME" : "RB";
}
