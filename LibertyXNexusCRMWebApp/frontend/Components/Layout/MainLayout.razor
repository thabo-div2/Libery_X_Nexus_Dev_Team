@inherits LayoutComponentBase
@inject NavigationManager Navigation
@using frontend.Services
@inject CurrentUserService CurrentUser

<div class="nexus-app">

    <aside class="nexus-sidebar">
        <NavMenu IsClientView="@IsClientRoute" />
    </aside>

    <main class="nexus-main">
        @Body
    </main>

</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        // The /chatbot route is shared by clients and advisors, so the
        // sidebar for it is decided by who's actually logged in rather
        // than the URL alone.
        await CurrentUser.EnsureRestoredAsync();
    }

    private bool IsClientRoute
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].ToLowerInvariant();

            if (path == "client" || path == "client-messages")
            {
                return true;
            }

            if (path == "chatbot")
            {
                return CurrentUser.IsClient;
            }

            return false;
        }
    }
}
