@inherits LayoutComponentBase
@inject NavigationManager Navigation
@using frontend.Services
@inject CurrentUserService CurrentUser

@* First thing a keyboard user reaches: jumps past the sidebar links straight to the page content.
   Hidden until it gets keyboard focus. *@
<a href="#main-content"
   class="skip-link"
   onclick="document.getElementById('main-content')?.focus()">Skip to main content</a>

<div class="nexus-app">

    <aside class="nexus-sidebar" aria-label="Main navigation">
        <NavMenu IsClientView="@IsClientRoute" />
    </aside>

    <main id="main-content" class="nexus-main" tabindex="-1">
        @if (_accessChecked && _accessGranted)
        {
            @Body
        }
    </main>

</div>

@code {
    // The chatbot and FAQs pages used to be single shared routes whose
    // sidebar was decided by CurrentUser.IsClient/IsAdvisor at render time.
    // That depended on ProtectedSessionStorage restoration finishing before
    // the layout rendered, which isn't guaranteed (prerendering/circuit
    // reconnects could render once before restoration completed) and could
    // flash the advisor sidebar - and its "/advisor" links - to a client.
    // Each role now has its own dedicated route instead, so this is pure
    // URL matching with no dependency on restoration timing.
    private static readonly string[] ClientPaths =
    {
        "client", "client-messages", "client-chatbot", "client-faqs"
    };

    private static readonly string[] AdvisorPaths =
    {
        "advisor", "clients", "new-client", "chatbot", "calendar", "messages", "faqs"
    };

    //routes that never require a signed in user.
    private static readonly string[] PublicPaths =
    {
        "home", "not-found", "error"
    };

    private bool IsClientRoute
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].ToLowerInvariant();
            return ClientPaths.Contains(path);
        }
    }

    private bool _accessChecked;
    private bool _accessGranted;

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        await InvokeAsync(async () =>
        {
            await CheckAccessAsync();
            StateHasChanged();
        });
    }

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CheckAccessAsync();
            StateHasChanged();
        }
    }

    private async Task CheckAccessAsync()
    {
        _accessChecked = false;
        _accessGranted = false;

        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].ToLowerInvariant();

        if (PublicPaths.Contains(path))
        {
            _accessChecked = true;
            _accessGranted = true;
            return;
        }

        await CurrentUser.EnsureRestoredAsync();

        Console.WriteLine(
            $"[AUTH DEBUG] Path={path}, " +
            $"IdPresent={CurrentUser.Id is not null}, " +
            $"IsAdvisor={CurrentUser.IsAdvisor}, " +
            $"IsClient={CurrentUser.IsClient}");

        if (CurrentUser.Id is null)
        {
            _accessChecked = true;
            Navigation.NavigateTo("/", forceLoad: false);
            return;
        }

        var requiresClient = ClientPaths.Contains(path);
        var requiresAdvisor = AdvisorPaths.Contains(path);

        if (requiresClient && !CurrentUser.IsClient)
        {
            _accessChecked = true;
            Navigation.NavigateTo(CurrentUser.IsAdvisor ? "/advisor" : "/", forceLoad: false);
            return;
        }

        if (requiresAdvisor && !CurrentUser.IsAdvisor)
        {
            _accessChecked = true;
            Navigation.NavigateTo(CurrentUser.IsClient ? "/client" : "/", forceLoad: false);
            return;
        }

        _accessChecked = true;
        _accessGranted = true;
    }

    public void Dispose()

    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}

@* //-----------------------------------------------------------------------------0o0o0o End of File 0o0o0o0o0o-------------------------------------------------------------------------------------------------// *@
