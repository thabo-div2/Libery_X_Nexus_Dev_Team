@page "/clients"
@layout MainLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using frontend.Services
@inject ClientService ClientDirectory
@inject CurrentUserService CurrentUser
@using Microsoft.AspNetCore.Components
@inject CaseService CaseDirectory
@inject PolicyService PolicyDirectory
@using Shared.Models.Enums

<PageTitle>Clients | Nexus</PageTitle>

<ErrorBoundary>
<ChildContent>
<div class="clients-page">

    <header class="clients-header">

        <div class="clients-heading">
            <h1>Clients</h1>
            <p>Search your client base and open a profile for the full picture.</p>
        </div>

        <div class="header-actions">

            <div class="search-box" role="search">
                <span class="search-icon" aria-hidden="true">⌕</span>

                <input aria-label="Search by name, email or status" type="text"
                       @bind="SearchText"
                       @bind:event="oninput"
                       placeholder="Search by name, email or status" />
            </div>

            @* Filter the list by lifecycle status (FR-11). Works together with the search box. *@
            <select class="status-filter"
                    aria-label="Filter clients by status"
                    @bind="StatusFilter">
                <option value="">All statuses</option>
                @foreach (var status in Enum.GetValues<ClientStatus>())
                {
                    <option value="@status">@status</option>
                }
            </select>

            <NotificationBell />

        </div>

    </header>

    @if (!string.IsNullOrEmpty(LoadError))
    {
        <p class="clients-error">@LoadError</p>
    }

    <main class="clients-content">

        <section class="clients-list-panel">

            <div class="panel-heading">
                <h2>@(IsLoading ? "Clients" : $"Clients ({FilteredClients.Count()})")</h2>
            </div>

            @if (!string.IsNullOrEmpty(ListMessage))
            {
                <p class="nx-alert nx-alert-success clients-list-alert" role="status">@ListMessage</p>
            }

            <div class="clients-list">

                @if (IsLoading)
                {
                    <div class="clients-empty-state">
                        <span>Loading clients…</span>
                    </div>
                }
                else if (!FilteredClients.Any())
                {
                    <div class="clients-empty-state">
                        <span>@(HasActiveFilters ? "No clients match your search or filter." : "No clients found.")</span>
                    </div>
                }
                else
                {
                    @foreach (var client in FilteredClients)
                    {
                        <button type="button"
                                class="client-item @(SelectedClient?.ClientId == client.ClientId ? "selected" : "")"
                                        @onclick="() => SelectClient(client)">

                            <div class="client-item-top">
                                <strong>@client.FirstName @client.LastName</strong>
                                <span class="client-status-badge">@client.Status</span>
                            </div>

                            <span class="client-item-email">@client.Email</span>

                        </button>
                    }
                }

            </div>

        </section>

        <section class="client-detail-panel">

            @if (SelectedClient is null)
            {
                <div class="client-empty-state">
                    <div class="empty-client-icon">◍</div>
                    <strong>No client selected</strong>
                    <span>Choose a client from the list to see their profile.</span>
                </div>
            }
            else
            {
                <div class="client-detail-header">

                    <div class="client-detail-heading">
                        <h2>@SelectedClient.FirstName @SelectedClient.LastName</h2>

                        <span class="case-status">
                            <span class="status-dot" aria-hidden="true"></span>
                            @SelectedClient.Status
                        </span>
                    </div>

                    @if (!IsEditing)
                    {
                        <div class="client-detail-actions">
                            <a class="nx-btn nx-btn-secondary nx-btn-sm"
                               href="@($"/meeting-prep?clientId={SelectedClient.ClientId}")">
                                Prep sheet
                            </a>

                            <button type="button"
                                    class="nx-btn nx-btn-secondary nx-btn-sm"
                                    aria-label="Edit @SelectedClient.FirstName @SelectedClient.LastName"
                                    @ref="EditButton"
                                    @onclick="StartEditing">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                                Edit
                            </button>

                            <button type="button"
                                    class="nx-btn nx-btn-danger-outline nx-btn-sm"
                                    aria-label="Delete @SelectedClient.FirstName @SelectedClient.LastName"
                                    @ref="DeleteButton"
                                    @onclick="AskToDelete"
                                    disabled="@ConfirmingDelete">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
                                Delete
                            </button>
                        </div>
                    }

                </div>

                @if (!string.IsNullOrEmpty(DetailMessage))
                {
                    <p class="nx-alert nx-alert-success client-detail-alert" role="status">@DetailMessage</p>
                }

                @if (ConfirmingDelete)
                {
                    <div class="client-delete-confirm"
                         role="alertdialog"
                         aria-labelledby="delete-confirm-title"
                         aria-describedby="delete-confirm-text"
                         @onkeydown="HandleDeleteKeyDown">

                        <strong id="delete-confirm-title">Delete @SelectedClient.FirstName @SelectedClient.LastName?</strong>

                        <p id="delete-confirm-text">
                            This permanently removes their profile, login, policies, cases, meetings, messages, documents and stored files.
                            It can't be undone.
                        </p>

                        @if (!string.IsNullOrEmpty(DeleteError))
                        {
                            <p class="client-delete-error" role="alert">@DeleteError</p>
                        }

                        <div class="client-delete-actions">
                            <button type="button"
                                    class="nx-btn nx-btn-secondary nx-btn-sm"
                                    @ref="KeepClientButton"
                                    @onclick="CancelDelete"
                                    disabled="@IsDeleting">
                                Keep client
                            </button>
                            <button type="button"
                                    class="nx-btn nx-btn-danger nx-btn-sm"
                                    @onclick="DeleteClientAsync"
                                    disabled="@IsDeleting">
                                @(IsDeleting ? "Deleting…" : "Delete client")
                            </button>
                        </div>
                    </div>
                }

                @if (IsEditing)
                {
                    <div class="client-detail-body" @onkeydown="HandleEditKeyDown">

                        <EditForm Model="EditModel" OnValidSubmit="SaveClientAsync" class="client-edit-form" novalidate>
                            <DataAnnotationsValidator />

                            <p class="client-edit-intro">Update @SelectedClient.FirstName's details. Email and status can't be changed here.</p>

                            @if (!string.IsNullOrEmpty(EditError))
                            {
                                <p class="clients-error client-edit-error" role="alert">@EditError</p>
                            }

                            <div class="client-edit-row">
                                <div class="client-edit-field">
                                    <label class="nx-label" for="edit-first-name">First name</label>
                                    <InputText id="edit-first-name"
                                               class="nx-input"
                                               autocomplete="off"
                                               @ref="FirstNameInput"
                                               @bind-Value="EditModel.FirstName" />
                                    <ValidationMessage For="() => EditModel.FirstName" />
                                </div>

                                <div class="client-edit-field">
                                    <label class="nx-label" for="edit-last-name">Last name</label>
                                    <InputText id="edit-last-name"
                                               class="nx-input"
                                               autocomplete="off"
                                               @bind-Value="EditModel.LastName" />
                                    <ValidationMessage For="() => EditModel.LastName" />
                                </div>
                            </div>

                            <div class="client-edit-field">
                                <label class="nx-label" for="edit-email">Email</label>
                                <input id="edit-email" class="nx-input" type="email" value="@SelectedClient.Email" disabled />
                            </div>

                            <div class="client-edit-field">
                                <label class="nx-label" for="edit-phone">Phone <span class="client-edit-optional">(optional)</span></label>
                                <InputText id="edit-phone"
                                           class="nx-input"
                                           type="tel"
                                           placeholder="+27 82 000 0000"
                                           @bind-Value="EditModel.Phone" />
                                <ValidationMessage For="() => EditModel.Phone" />
                            </div>

                            <div class="client-edit-field">
                                <label class="nx-label" for="edit-id-number">ID number <span class="client-edit-optional">(optional)</span></label>
                                <InputText id="edit-id-number"
                                           class="nx-input"
                                           inputmode="numeric"
                                           placeholder="9001015800086"
                                           @bind-Value="EditModel.IdentificationNumber" />
                                <ValidationMessage For="() => EditModel.IdentificationNumber" />
                            </div>

                            <div class="client-edit-field">
                                <label class="nx-label" for="edit-risk">Risk profile <span class="client-edit-optional">(optional)</span></label>
                                <InputSelect id="edit-risk" class="nx-input" @bind-Value="EditModel.RiskProfile">
                                    <option value="">Not set</option>
                                    @foreach (var option in RiskOptionsFor(SelectedClient.RiskProfile))
                                    {
                                        <option value="@option">@option</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="client-edit-actions">
                                <button type="button" class="nx-btn nx-btn-secondary" @onclick="CancelEditingAsync" disabled="@IsSaving">
                                    Cancel
                                </button>
                                <button type="submit" class="nx-btn nx-btn-primary" disabled="@IsSaving">
                                    @(IsSaving ? "Saving…" : "Save changes")
                                </button>
                            </div>
                        </EditForm>

                    </div>
                }
                else
                {
                <div class="client-detail-body">

                    <div class="detail-field">
                        <span class="detail-label">Email</span>
                        <span class="detail-value">@SelectedClient.Email</span>
                    </div>

                    <div class="detail-field">
                        <span class="detail-label">Phone</span>
                        <span class="detail-value">@(string.IsNullOrWhiteSpace(SelectedClient.Phone) ? "—" : SelectedClient.Phone)</span>
                    </div>

                    <div class="detail-field">
                        <span class="detail-label">ID number</span>
                        <span class="detail-value">@(string.IsNullOrWhiteSpace(SelectedClient.IdentificationNumber) ? "—" : SelectedClient.IdentificationNumber)</span>
                    </div>

                    <div class="detail-field">
                        <span class="detail-label">Risk profile</span>
                        <span class="detail-value">@(string.IsNullOrWhiteSpace(SelectedClient.RiskProfile) ? "—" : SelectedClient.RiskProfile)</span>
                    </div>

                    <div class="detail-field">
                        <span class="detail-label">Client since</span>
                        <span class="detail-value">@SelectedClient.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</span>
                    </div>

                    <div class="case-progress">

                        <span class="detail-label">Policies and application progress</span>

                           @if (!string.IsNullOrEmpty(CaseError))
                           {
                             <p class="clients-error">@CaseError</p>
                           }

                           @* One row per policy. Each policy has its own case, so picking one shows its progress below. *@
                           @if (ClientCases.Count > 0)
                           {
                               <div class="policy-list">
                                   @foreach (var policyCase in ClientCases)
                                   {
                                       var isSelected = SelectedCase?.CaseId == policyCase.CaseId;

                                       <button type="button"
                                               class="policy-row @(isSelected ? "is-selected" : "")"
                                               aria-pressed="@(isSelected ? "true" : "false")"
                                               disabled="@IsMarkingStep"
                                               @key="policyCase.CaseId"
                                               @onclick="() => SelectCase(policyCase)">
                                           <span class="policy-row-name">@(string.IsNullOrWhiteSpace(policyCase.PolicyName) ? $"Policy {policyCase.PolicyId}" : policyCase.PolicyName)</span>
                                           <span class="policy-row-progress">@CountCompletedSteps(policyCase) of @CaseSteps.Length steps</span>
                                       </button>
                                   }
                               </div>
                           }

                           @if (SelectedCase is not null)
                           {
                               <PolicyStatusPanel @key="SelectedCase.PolicyId" PolicyId="SelectedCase.PolicyId" IssuedAt="SelectedCase.PolicyIssuedAt" OnChanged="ReloadPolicyStatusAsync" />
                           }

                           <div class="policy-actions">
                               <button type="button"
                                       class="nx-btn nx-btn-secondary nx-btn-sm"
                                       aria-expanded="@(ShowAddPolicy ? "true" : "false")"
                                       @onclick="ToggleAddPolicyAsync">
                                   @(ShowAddPolicy ? "Cancel" : "Add policy")
                               </button>

                               @if (SelectedCase is not null && !ShowAddPolicy)
                               {
                                   <button type="button"
                                           class="nx-btn nx-btn-danger-outline nx-btn-sm"
                                           disabled="@(ConfirmingPolicyRemoval || IsRemovingPolicy)"
                                           @onclick="AskToRemovePolicy">
                                       Remove this policy
                                   </button>
                               }
                           </div>

                           @if (!string.IsNullOrEmpty(PolicyMessage))
                           {
                               <p class="nx-alert nx-alert-success" role="status">@PolicyMessage</p>
                           }

                           @if (!string.IsNullOrEmpty(PolicyError))
                           {
                               <p class="nx-alert nx-alert-danger" role="alert">@PolicyError</p>
                           }

                           @if (ConfirmingPolicyRemoval && SelectedCase is not null)
                           {
                               <div class="policy-remove-confirm" role="alertdialog" aria-label="Remove policy">
                                   <span>
                                       Remove @(SelectedCase.PolicyName ?? "this policy") and its application progress? This can't be undone.
                                   </span>
                                   <div class="policy-actions">
                                       <button type="button" class="nx-btn nx-btn-secondary nx-btn-sm" disabled="@IsRemovingPolicy" @onclick="CancelRemovePolicy">Keep policy</button>
                                       <button type="button" class="nx-btn nx-btn-danger nx-btn-sm" disabled="@IsRemovingPolicy" @onclick="RemovePolicyAsync">
                                           @(IsRemovingPolicy ? "Removing…" : "Remove policy")
                                       </button>
                                   </div>
                               </div>
                           }

                           @if (ShowAddPolicy)
                           {
                               <div class="policy-form" role="region" aria-label="Add a policy">

                                   @if (PolicyCatalogue.Count > 0)
                                   {
                                       <div class="client-edit-field">
                                           <label class="nx-label" for="new-policy-catalogue">Start from the catalogue <span class="client-edit-optional">(optional)</span></label>
                                           <select id="new-policy-catalogue" class="nx-input" @onchange="OnCataloguePicked" disabled="@IsAddingPolicy">
                                               <option value="0">Enter the details myself</option>
                                               @foreach (var item in PolicyCatalogue)
                                               {
                                                   <option value="@item.PolicyId">@item.PolicyName (@item.Provider)</option>
                                               }
                                           </select>
                                       </div>
                                   }

                                   <div class="client-edit-field">
                                       <label class="nx-label" for="new-policy-name">Policy name</label>
                                       <input id="new-policy-name" class="nx-input" type="text" maxlength="200" @bind="NewPolicyName" disabled="@IsAddingPolicy" />
                                   </div>

                                   <div class="client-edit-field">
                                       <label class="nx-label" for="new-policy-provider">Provider</label>
                                       <input id="new-policy-provider" class="nx-input" type="text" maxlength="150" placeholder="e.g. Liberty" @bind="NewPolicyProvider" disabled="@IsAddingPolicy" />
                                   </div>

                                   <div class="client-edit-row">
                                       <div class="client-edit-field">
                                           <label class="nx-label" for="new-policy-premium">Monthly premium <span class="client-edit-optional">(optional)</span></label>
                                           <input id="new-policy-premium" class="nx-input" type="number" min="0" step="0.01" @bind="NewPolicyPremium" disabled="@IsAddingPolicy" />
                                       </div>

                                       <div class="client-edit-field">
                                           <label class="nx-label" for="new-policy-cover">Cover amount <span class="client-edit-optional">(optional)</span></label>
                                           <input id="new-policy-cover" class="nx-input" type="number" min="0" step="0.01" @bind="NewPolicyCover" disabled="@IsAddingPolicy" />
                                       </div>
                                   </div>

                                   <div class="client-edit-row">
                                       <div class="client-edit-field">
                                           <label class="nx-label" for="new-policy-start">Start date <span class="client-edit-optional">(optional)</span></label>
                                           <input id="new-policy-start" class="nx-input" type="date" @bind="NewPolicyStart" disabled="@IsAddingPolicy" />
                                       </div>

                                       <div class="client-edit-field">
                                           <label class="nx-label" for="new-policy-end">End date <span class="client-edit-optional">(optional)</span></label>
                                           <input id="new-policy-end" class="nx-input" type="date" @bind="NewPolicyEnd" disabled="@IsAddingPolicy" />
                                       </div>
                                   </div>

                                   <button type="button" class="nx-btn nx-btn-primary nx-btn-sm" disabled="@IsAddingPolicy" @onclick="AddPolicyAsync">
                                       @(IsAddingPolicy ? "Adding…" : "Add policy")
                                   </button>

                               </div>
                           }

                           @if (SelectedCase is null)
                           {
                              <span class="detail-value">This client has no policies yet. Add one to start tracking their application.</span>
                           }
                            else
                             {
                               @* The key rebuilds the list when the case changes or a save fails, so a tick box
                                  can never be left showing a tick that was not saved. *@
                               <ul class="case-step-list" @key="(SelectedCase.CaseId, CaseStepsVersion)">
                                     @foreach (var (step, label) in CaseSteps)
                                     {
                                         var complete = IsStepComplete(step);
                                         var locked = !complete && IsStepLocked(step);
                                         var stepDate = GetStepDate(step);
                                         <li class="case-step-row @(complete ? "is-complete" : "") @(locked ? "is-locked" : "")"
                                             title="@(locked ? "Complete the earlier steps first." : null)">
                                             <label class="case-step-check">
                                                 <input type="checkbox"
                                                        class="case-step-input"
                                                        checked="@complete"
                                                        disabled="@(complete || locked || IsMarkingStep || IsPolicyClosed)"
                                                        @onchange="() => MarkStep(step)" />
                                                 <span class="case-step-box">
                                                       <svg class="case-step-tick" viewBox="0 0 16 16">
                                                          <path d="M3 8.5L6.5 12L13 4.5" />
                                                       </svg>
                                                 </span>

                                                 <span class="case-step-text">
                                                       <span class="case-step-label">@label</span>
                                                        @if (stepDate is not null)
                                                        {
                                                          <span class="case-step-date">@stepDate</span>
                                                        }
                                                 </span>
                                             </label>
                                         </li>
                                     }
                               </ul>
                            }

                    </div>

                    @* Sibling keys must be unique across both panel types. Including the client
                       still gives each client fresh panels when the selection changes. *@
                    <ClientDocumentRequests @key="(typeof(ClientDocumentRequests), SelectedClient.ClientId)" ClientId="SelectedClient.ClientId" />

                    <ClientNotes @key="(typeof(ClientNotes), SelectedClient.ClientId)" ClientId="SelectedClient.ClientId" />

                </div>
                }
            }

        </section>

    </main>

</div>
</ChildContent>
<ErrorContent>
    <div class="clients-page">
        <p class="clients-error">Something went wrong loading this page. Please refresh and try again.</p>
    </div>
</ErrorContent>
</ErrorBoundary>

@code {
    private List<ClientProfile> ClientResults = new();
    private ClientProfile? SelectedClient;
    private string SearchText = "";
    private string? LoadError;
    private bool IsLoading = true;
    private CaseSummary? SelectedCase;

    // Every case the selected client has: one per policy. SelectedCase is the one whose steps are showing.
    private List<CaseSummary> ClientCases = new();

    // Add / remove policy
    private bool ShowAddPolicy;
    private bool IsAddingPolicy;
    private bool ConfirmingPolicyRemoval;
    private bool IsRemovingPolicy;
    private string? PolicyError;
    private string? PolicyMessage;
    private List<PolicySummary> PolicyCatalogue = new();
    private string NewPolicyName = string.Empty;
    private string NewPolicyProvider = string.Empty;
    private double? NewPolicyPremium;
    private double? NewPolicyCover;
    private DateTime? NewPolicyStart;
    private DateTime? NewPolicyEnd;
    private string? CaseError;

    // True while a step is being saved, so a second click can't send the same step twice.
    private bool IsMarkingStep;

    // Goes up whenever the tick boxes need rebuilding from what is actually saved.
    private int CaseStepsVersion;

    /// <summary>
    /// The status chosen in the filter dropdown. Empty means "All statuses".
    /// </summary>
    private string StatusFilter = "";

    private bool HasActiveFilters => !string.IsNullOrEmpty(SearchText) || !string.IsNullOrEmpty(StatusFilter);

    private IEnumerable<ClientProfile> FilteredClients => ClientResults
    .Where(c => string.IsNullOrEmpty(StatusFilter) ||
                string.Equals(c.Status, StatusFilter, StringComparison.OrdinalIgnoreCase))
    .Where(c => string.IsNullOrWhiteSpace(SearchText) ||
                $"{c.FirstName} {c.LastName}".Contains(SearchText.Trim(), StringComparison.OrdinalIgnoreCase) ||
                $"{c.LastName} {c.FirstName}".Contains(SearchText.Trim(), StringComparison.OrdinalIgnoreCase) ||
                c.Email.Contains(SearchText.Trim(), StringComparison.OrdinalIgnoreCase) ||
                c.Status.Contains(SearchText.Trim(), StringComparison.OrdinalIgnoreCase));

    [Parameter]
    [SupplyParameterFromQuery(Name = "search")]
    public string? SearchQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.EnsureRestoredAsync();
        await Search();
    }

    /// <summary>
    /// The ?search= value that has already been copied into the search box.
    /// The page re-receives its parameters on every re-render (e.g. when the layout updates),
    /// and the old code copied ?search= into the box each time, wiping what the user had typed.
    /// Now the URL value is only applied when it actually changes, e.g. a new search from the dashboard.
    /// </summary>
    private string? _appliedSearchQuery;

    protected override void OnParametersSet()
    {
        if (SearchQuery == _appliedSearchQuery)
        {
            return;
        }

        _appliedSearchQuery = SearchQuery;
        SearchText = SearchQuery ?? string.Empty;
    }

    /// <summary>
    /// Loads all of the advisor's clients once. Typing in the search box then filters
    /// this list instantly on the page (see FilteredClients), so clearing the box always
    /// brings every client back, even when the page was opened with ?search= from the dashboard.
    /// </summary>
    private async Task Search()
    {
        IsLoading = true;
        LoadError = null;

        var (clients, error) = await ClientDirectory.SearchAsync(null, null);
        ClientResults = clients;
        LoadError = error;
        IsLoading = false;

        if (SelectedClient is not null && ClientResults.All(c => c.ClientId != SelectedClient.ClientId))
        {
            SelectedClient = null;
        }
    }

    private static readonly (CaseStep Step, string Label)[] CaseSteps = new[]
    {
        (CaseStep.DetailsSubmitted, "Details submitted"),
        (CaseStep.AdviserReview, "Adviser review"),
        (CaseStep.FicaVerification, "FICA verification"),
        (CaseStep.SubmittedToLiberty, "Submitted to Liberty"),
        (CaseStep.PolicyIssued, "Policy issued"),
    };

    private async Task SelectClient(ClientProfile client)
    {
        // Picking another client leaves edit mode (and any delete question) without saving.
        IsEditing = false;
        ConfirmingDelete = false;
        DeleteError = null;
        EditError = null;
        DetailMessage = null;

        SelectedClient = client;
        ResetPolicyPanel();

        // Fetch the full profile Phone, ID number, Risk profile
        var (fullClient, error) = await ClientDirectory.GetByIdAsync(client.ClientId);
        if (fullClient is not null)
        {
            SelectedClient = fullClient;
        }

        await LoadCaseForSelectedClient();
    }

    /// <summary>
    /// Loads every case for the selected client (one per policy). Keeps the same policy selected
    /// if it is still there, otherwise shows the first one.
    /// </summary>
    private async Task LoadCaseForSelectedClient(int? selectPolicyId = null)
    {
        var previousCaseId = SelectedCase?.CaseId;

        SelectedCase = null;
        ClientCases = new();
        CaseError = null;

        if (SelectedClient is null)
        {
            return;
        }

        var clientId = SelectedClient.ClientId;
        var (cases, error) = await CaseDirectory.GetForClientAsync(clientId);

        // The advisor may have clicked onto another client while this was loading.
        if (SelectedClient is null || SelectedClient.ClientId != clientId)
        {
            return;
        }

        CaseError = error;

        // Oldest policy first, so the list doesn't reorder itself every time a step is ticked.
        ClientCases = cases.OrderBy(c => c.CreatedAt).ThenBy(c => c.CaseId).ToList();

        SelectedCase =
            (selectPolicyId is int policyId ? ClientCases.FirstOrDefault(c => c.PolicyId == policyId) : null)
            ?? ClientCases.FirstOrDefault(c => c.CaseId == previousCaseId)
            ?? ClientCases.FirstOrDefault();

        CaseStepsVersion++;
    }

    private void SelectCase(CaseSummary policyCase)
    {
        if (IsMarkingStep)
        {
            return;
        }

        SelectedCase = policyCase;
        CaseError = null;
        PolicyError = null;
        PolicyMessage = null;
        ConfirmingPolicyRemoval = false;
    }

    private static int CountCompletedSteps(CaseSummary policyCase)
    {
        return new[]
        {
            policyCase.DetailsSubmittedAt, policyCase.AdviserReviewAt, policyCase.FicaVerifiedAt,
            policyCase.SubmittedToLibertyAt, policyCase.PolicyIssuedAt
        }.Count(when => when.HasValue);
    }

    /// <summary>
    /// Keeps the policy list in step after a case changes, so its "x of 5 steps" count is right.
    /// </summary>
    private void ReplaceCaseInList(CaseSummary updated)
    {
        var index = ClientCases.FindIndex(c => c.CaseId == updated.CaseId);

        if (index >= 0)
        {
            ClientCases[index] = updated;
        }
    }

    private void ResetPolicyPanel()
    {
        ShowAddPolicy = false;
        ConfirmingPolicyRemoval = false;
        PolicyError = null;
        PolicyMessage = null;
        ClearNewPolicyForm();
    }

    private void ClearNewPolicyForm()
    {
        NewPolicyName = string.Empty;
        NewPolicyProvider = string.Empty;
        NewPolicyPremium = null;
        NewPolicyCover = null;
        NewPolicyStart = null;
        NewPolicyEnd = null;
    }

    /// <summary>
    /// Opens or closes the add policy form. The catalogue is loaded the first time it opens;
    /// if that fails the advisor can still type the details in.
    /// </summary>
    private async Task ToggleAddPolicyAsync()
    {
        ShowAddPolicy = !ShowAddPolicy;
        ConfirmingPolicyRemoval = false;
        PolicyError = null;
        PolicyMessage = null;

        if (!ShowAddPolicy)
        {
            ClearNewPolicyForm();
            return;
        }

        if (PolicyCatalogue.Count == 0)
        {
            var (catalogue, _) = await PolicyDirectory.GetCatalogueAsync();
            PolicyCatalogue = catalogue ?? new List<PolicySummary>();
        }
    }

    /// <summary>
    /// Fills the form in from the catalogue item the advisor picked. They can still change anything.
    /// </summary>
    private void OnCataloguePicked(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var policyId) || policyId <= 0)
        {
            return;
        }

        var item = PolicyCatalogue.FirstOrDefault(p => p.PolicyId == policyId);

        if (item is null)
        {
            return;
        }

        NewPolicyName = item.PolicyName;
        NewPolicyProvider = item.Provider;
        NewPolicyPremium = item.PremiumAmount;
        NewPolicyCover = item.CoverAmount;
    }

    /// <summary>
    /// Gives the client another policy. The API creates the policy and its case together.
    /// </summary>
    private async Task AddPolicyAsync()
    {
        if (IsAddingPolicy || SelectedClient is null)
        {
            return;
        }

        PolicyError = null;
        PolicyMessage = null;

        var name = NewPolicyName.Trim();
        var provider = NewPolicyProvider.Trim();

        if (name.Length == 0 || provider.Length == 0)
        {
            PolicyError = "Enter the policy name and the provider.";
            return;
        }

        if (NewPolicyPremium < 0 || NewPolicyCover < 0)
        {
            PolicyError = "The premium and cover amount can't be negative.";
            return;
        }

        if (NewPolicyStart.HasValue && NewPolicyEnd.HasValue && NewPolicyEnd < NewPolicyStart)
        {
            PolicyError = "The end date can't be before the start date.";
            return;
        }

        var clientId = SelectedClient.ClientId;
        IsAddingPolicy = true;

        try
        {
            var request = new CreateClientPolicyRequest(name, provider, null, NewPolicyPremium, NewPolicyCover, NewPolicyStart, NewPolicyEnd);
            var (policy, error) = await PolicyDirectory.CreateClientPolicyAsync(clientId, request);

            if (policy is null)
            {
                PolicyError = error ?? "The policy couldn't be added. Please try again.";
                return;
            }

            // The advisor may have clicked onto another client while this was saving.
            if (SelectedClient is null || SelectedClient.ClientId != clientId)
            {
                return;
            }

            ShowAddPolicy = false;
            ClearNewPolicyForm();
            await LoadCaseForSelectedClient(policy.PolicyId);
            PolicyMessage = $"{policy.PolicyName} was added.";
        }
        finally
        {
            IsAddingPolicy = false;
        }
    }

    private void AskToRemovePolicy()
    {
        ConfirmingPolicyRemoval = true;
        PolicyError = null;
        PolicyMessage = null;
    }

    private void CancelRemovePolicy()
    {
        ConfirmingPolicyRemoval = false;
    }

    private async Task RemovePolicyAsync()
    {
        if (IsRemovingPolicy || SelectedCase is null || SelectedClient is null)
        {
            return;
        }

        var removing = SelectedCase;
        var clientId = SelectedClient.ClientId;

        PolicyError = null;
        PolicyMessage = null;
        IsRemovingPolicy = true;

        try
        {
            var error = await PolicyDirectory.DeleteAsync(removing.PolicyId);

            if (error is not null)
            {
                // e.g. the policy still has documents filed under it.
                PolicyError = error;
                return;
            }

            ConfirmingPolicyRemoval = false;

            if (SelectedClient is null || SelectedClient.ClientId != clientId)
            {
                return;
            }

            await LoadCaseForSelectedClient();
            PolicyMessage = $"{removing.PolicyName ?? "The policy"} was removed.";
        }
        finally
        {
            IsRemovingPolicy = false;
        }
    }

    private bool IsStepComplete(CaseStep step)
    {
        if (SelectedCase is null)
        {
            return false;
        }

        return step switch
        {
            CaseStep.DetailsSubmitted => SelectedCase.DetailsSubmittedAt.HasValue,
            CaseStep.AdviserReview => SelectedCase.AdviserReviewAt.HasValue,
            CaseStep.FicaVerification => SelectedCase.FicaVerifiedAt.HasValue,
            CaseStep.SubmittedToLiberty => SelectedCase.SubmittedToLibertyAt.HasValue,
            CaseStep.PolicyIssued => SelectedCase.PolicyIssuedAt.HasValue,
            _ => false
        };
    }

    /// <summary>
    /// Steps happen in order, so a step can't be ticked until the one before it is done.
    /// </summary>
    private bool IsStepLocked(CaseStep step)
    {
        return step != CaseStep.DetailsSubmitted && !IsStepComplete((CaseStep)((int)step - 1));
    }

    private bool IsPolicyClosed => SelectedCase?.PolicyStatus is "Cancelled" or "Matured" or "Lapsed";

    private async Task ReloadPolicyStatusAsync() => await LoadCaseForSelectedClient();

    private async Task MarkStep(CaseStep step)
    {
        if (SelectedCase is null || IsMarkingStep || IsPolicyClosed)
        {
            return;
        }

        if (IsStepComplete(step) || IsStepLocked(step))
        {
            // Shouldn't be clickable, but put the tick box back if it was.
            CaseStepsVersion++;
            return;
        }

        var caseId = SelectedCase.CaseId;
        IsMarkingStep = true;

        try
        {
            var (updated, error) = await CaseDirectory.MarkStepCompleteAsync(caseId, step);

            // The advisor may have clicked onto another client while this was saving.
            if (SelectedCase is null || SelectedCase.CaseId != caseId)
            {
                return;
            }

            if (error is not null || updated is null)
            {
                CaseError = error ?? "The step couldn't be saved. Please try again.";

                // Load what is actually saved, in case the step went through before the error.
                if (SelectedClient is not null)
                {
                    var (cases, reloadError) = await CaseDirectory.GetForClientAsync(SelectedClient.ClientId);
                    var saved = cases.FirstOrDefault(c => c.CaseId == caseId);

                    if (reloadError is null && saved is not null && SelectedCase?.CaseId == caseId)
                    {
                        SelectedCase = saved;
                        ReplaceCaseInList(saved);
                    }
                }

                // The browser already ticked the box, so rebuild the list to match what is saved.
                CaseStepsVersion++;
                return;
            }

            SelectedCase = updated;
            ReplaceCaseInList(updated);
            CaseError = null;
        }
        finally
        {
            IsMarkingStep = false;
        }
    }

    private string? GetStepDate(CaseStep step)
    {
        if (SelectedCase is null)
        {
            return null;
        }

        var when = step switch
        {
            CaseStep.DetailsSubmitted => SelectedCase.DetailsSubmittedAt,
            CaseStep.AdviserReview => SelectedCase.AdviserReviewAt,
            CaseStep.FicaVerification => SelectedCase.FicaVerifiedAt,
            CaseStep.SubmittedToLiberty => SelectedCase.SubmittedToLibertyAt,
            CaseStep.PolicyIssued => SelectedCase.PolicyIssuedAt,
            _ => null
        };
        return when?.ToString("dd MMM yyyy");
    }


    // ---------------------------------------------------------
    // Editing a client
    // ---------------------------------------------------------

    /// <summary>
    /// Same choices as the New Client wizard.
    /// </summary>
    private static readonly string[] RiskOptions = { "Conservative", "Moderate", "Balanced", "Aggressive" };

    private bool IsEditing;
    private bool IsSaving;
    private string? EditError;
    private EditClientForm EditModel = new();

    /// <summary>
    /// A short green confirmation under the panel header, e.g. "Client updated".
    /// </summary>
    private string? DetailMessage;

    private ElementReference EditButton;
    private InputText? FirstNameInput;
    private bool FocusFirstField;
    private bool FocusEditButton;

    /// <summary>
    /// Keeps a risk profile that isn't one of the standard options (older data) selectable.
    /// </summary>
    private static IEnumerable<string> RiskOptionsFor(string? current) =>
        string.IsNullOrWhiteSpace(current) || RiskOptions.Contains(current)
            ? RiskOptions
            : RiskOptions.Append(current);

    private void StartEditing()
    {
        if (SelectedClient is null)
        {
            return;
        }

        EditModel = new EditClientForm
        {
            FirstName = SelectedClient.FirstName,
            LastName = SelectedClient.LastName,
            Phone = SelectedClient.Phone,
            IdentificationNumber = SelectedClient.IdentificationNumber,
            RiskProfile = SelectedClient.RiskProfile
        };

        EditError = null;
        DetailMessage = null;
        ConfirmingDelete = false;
        IsEditing = true;
        FocusFirstField = true;
    }

    private Task CancelEditingAsync()
    {
        IsEditing = false;
        EditError = null;
        FocusEditButton = true;
        return Task.CompletedTask;
    }

    /// <summary>
    /// Escape leaves the form without saving, like the other panels in the app.
    /// </summary>
    private async Task HandleEditKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && !IsSaving)
        {
            await CancelEditingAsync();
        }
    }

    /// <summary>
    /// Runs only when every field passes its rules (EditForm OnValidSubmit).
    /// </summary>
    private async Task SaveClientAsync()
    {
        if (SelectedClient is null)
        {
            return;
        }

        IsSaving = true;
        EditError = null;

        // Empty optional boxes are sent as null: the API's [Phone] rule rejects an empty string.
        static string? OrNull(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

        var request = new Shared.DTOs.Clients.UpdateClientRequest
        {
            FirstName = EditModel.FirstName.Trim(),
            LastName = EditModel.LastName.Trim(),
            Phone = OrNull(EditModel.Phone),
            IdentificationNumber = OrNull(EditModel.IdentificationNumber),
            RiskProfile = OrNull(EditModel.RiskProfile)
        };

        var (updated, error) = await ClientDirectory.UpdateAsync(SelectedClient.ClientId, request);

        IsSaving = false;

        if (updated is null)
        {
            EditError = error ?? "The client could not be saved.";
            return;
        }

        // Keep the list on the left in step with the panel.
        var index = ClientResults.FindIndex(c => c.ClientId == updated.ClientId);
        if (index >= 0)
        {
            ClientResults[index] = updated;
        }

        SelectedClient = updated;
        IsEditing = false;
        FocusEditButton = true;
        ShowDetailMessage($"{updated.FirstName} {updated.LastName}'s details were updated.");
    }

    /// <summary>
    /// Shows a confirmation for a few seconds, then hides it.
    /// </summary>
    private void ShowDetailMessage(string message)
    {
        DetailMessage = message;

        _ = Task.Delay(4000).ContinueWith(_ => InvokeAsync(() =>
        {
            if (DetailMessage == message)
            {
                DetailMessage = null;
                StateHasChanged();
            }
        }));
    }


    // ---------------------------------------------------------
    // Deleting a client
    // ---------------------------------------------------------

    private bool ConfirmingDelete;
    private bool IsDeleting;
    private string? DeleteError;

    /// <summary>
    /// Shown above the list after a delete, since the detail panel closes.
    /// </summary>
    private string? ListMessage;

    private ElementReference DeleteButton;
    private ElementReference KeepClientButton;
    private bool FocusKeepButton;
    private bool FocusDeleteButton;

    private void AskToDelete()
    {
        DetailMessage = null;
        DeleteError = null;
        ConfirmingDelete = true;
        // Focus starts on "Keep client", so a stray Enter never deletes anyone.
        FocusKeepButton = true;
    }

    private void CancelDelete()
    {
        ConfirmingDelete = false;
        DeleteError = null;
        FocusDeleteButton = true;
    }

    private void HandleDeleteKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && !IsDeleting)
        {
            CancelDelete();
        }
    }

    private async Task DeleteClientAsync()
    {
        if (SelectedClient is null)
        {
            return;
        }

        IsDeleting = true;
        DeleteError = null;

        var deleted = SelectedClient;
        var error = await ClientDirectory.DeleteAsync(deleted.ClientId);

        IsDeleting = false;

        if (error is not null)
        {
            DeleteError = error;
            return;
        }

        ClientResults.RemoveAll(c => c.ClientId == deleted.ClientId);
        ConfirmingDelete = false;
        SelectedClient = null;
        SelectedCase = null;
        ClientCases = new();
        ResetPolicyPanel();
        ShowListMessage($"{deleted.FirstName} {deleted.LastName} was deleted.");
    }

    private void ShowListMessage(string message)
    {
        ListMessage = message;

        _ = Task.Delay(5000).ContinueWith(_ => InvokeAsync(() =>
        {
            if (ListMessage == message)
            {
                ListMessage = null;
                StateHasChanged();
            }
        }));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Move keyboard focus to the right place after the panel switches mode.
        if (FocusFirstField && FirstNameInput?.Element is ElementReference first)
        {
            FocusFirstField = false;
            await first.FocusAsync();
        }
        else if (FocusEditButton && !IsEditing)
        {
            FocusEditButton = false;
            try { await EditButton.FocusAsync(); } catch (Exception) { }
        }
        else if (FocusKeepButton && ConfirmingDelete)
        {
            FocusKeepButton = false;
            try { await KeepClientButton.FocusAsync(); } catch (Exception) { }
        }
        else if (FocusDeleteButton && !ConfirmingDelete)
        {
            FocusDeleteButton = false;
            try { await DeleteButton.FocusAsync(); } catch (Exception) { }
        }
    }
}

