@page "/clients"
@layout MainLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using frontend.Services
@inject ClientService ClientDirectory
@inject CurrentUserService CurrentUser
@using Microsoft.AspNetCore.Components
@inject CaseService CaseDirectory
@using Shared.Models.Enums

<PageTitle>Clients | Nexus</PageTitle>

<ErrorBoundary>
<ChildContent>
<div class="clients-page">

    <header class="clients-header">

        <div class="clients-heading">
            <h1>Clients</h1>
            <p>Search your client base and open a profile for the full picture.</p>
        </div>

        <div class="header-actions">

            <div class="search-box" role="search">
                <span class="search-icon" aria-hidden="true">⌕</span>

                <input aria-label="Search by name, email or status" type="text"
                       @bind="SearchText"
                       @bind:event="oninput"
                       placeholder="Search by name, email or status" />
            </div>

            @* Filter the list by lifecycle status (FR-11). Works together with the search box. *@
            <select class="status-filter"
                    aria-label="Filter clients by status"
                    @bind="StatusFilter">
                <option value="">All statuses</option>
                @foreach (var status in Enum.GetValues<ClientStatus>())
                {
                    <option value="@status">@status</option>
                }
            </select>

            <NotificationBell />

        </div>

    </header>

    @if (!string.IsNullOrEmpty(LoadError))
    {
        <p class="clients-error">@LoadError</p>
    }

    <main class="clients-content">

        <section class="clients-list-panel">

            <div class="panel-heading">
                <h2>@(IsLoading ? "Clients" : $"Clients ({FilteredClients.Count()})")</h2>
            </div>

            <div class="clients-list">

                @if (IsLoading)
                {
                    <div class="clients-empty-state">
                        <span>Loading clients…</span>
                    </div>
                }
                else if (!FilteredClients.Any())
                {
                    <div class="clients-empty-state">
                        <span>@(HasActiveFilters ? "No clients match your search or filter." : "No clients found.")</span>
                    </div>
                }
                else
                {
                    @foreach (var client in FilteredClients)
                    {
                        <button type="button"
                                class="client-item @(SelectedClient?.ClientId == client.ClientId ? "selected" : "")"
                                        @onclick="() => SelectClient(client)">

                            <div class="client-item-top">
                                <strong>@client.FirstName @client.LastName</strong>
                                <span class="client-status-badge">@client.Status</span>
                            </div>

                            <span class="client-item-email">@client.Email</span>

                        </button>
                    }
                }

            </div>

        </section>

        <section class="client-detail-panel">

            @if (SelectedClient is null)
            {
                <div class="client-empty-state">
                    <div class="empty-client-icon">◍</div>
                    <strong>No client selected</strong>
                    <span>Choose a client from the list to see their profile.</span>
                </div>
            }
            else
            {
                <div class="client-detail-header">

                    <div class="client-detail-heading">
                        <h2>@SelectedClient.FirstName @SelectedClient.LastName</h2>

                        <span class="case-status">
                            <span class="status-dot" aria-hidden="true"></span>
                            @SelectedClient.Status
                        </span>
                    </div>

                    @if (!IsEditing)
                    {
                        <div class="client-detail-actions">
                            <button type="button"
                                    class="nx-btn nx-btn-secondary nx-btn-sm"
                                    aria-label="Edit @SelectedClient.FirstName @SelectedClient.LastName"
                                    @ref="EditButton"
                                    @onclick="StartEditing">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                                Edit
                            </button>
                        </div>
                    }

                </div>

                @if (!string.IsNullOrEmpty(DetailMessage))
                {
                    <p class="nx-alert nx-alert-success client-detail-alert" role="status">@DetailMessage</p>
                }

                @if (IsEditing)
                {
                    <div class="client-detail-body" @onkeydown="HandleEditKeyDown">

                        <EditForm Model="EditModel" OnValidSubmit="SaveClientAsync" class="client-edit-form" novalidate>
                            <DataAnnotationsValidator />

                            <p class="client-edit-intro">Update @SelectedClient.FirstName's details. Email and status can't be changed here.</p>

                            @if (!string.IsNullOrEmpty(EditError))
                            {
                                <p class="clients-error client-edit-error" role="alert">@EditError</p>
                            }

                            <div class="client-edit-row">
                                <div class="client-edit-field">
                                    <label class="nx-label" for="edit-first-name">First name</label>
                                    <InputText id="edit-first-name"
                                               class="nx-input"
                                               autocomplete="off"
                                               @ref="FirstNameInput"
                                               @bind-Value="EditModel.FirstName" />
                                    <ValidationMessage For="() => EditModel.FirstName" />
                                </div>

                                <div class="client-edit-field">
                                    <label class="nx-label" for="edit-last-name">Last name</label>
                                    <InputText id="edit-last-name"
                                               class="nx-input"
                                               autocomplete="off"
                                               @bind-Value="EditModel.LastName" />
                                    <ValidationMessage For="() => EditModel.LastName" />
                                </div>
                            </div>

                            <div class="client-edit-field">
                                <label class="nx-label" for="edit-email">Email</label>
                                <input id="edit-email" class="nx-input" type="email" value="@SelectedClient.Email" disabled />
                            </div>

                            <div class="client-edit-field">
                                <label class="nx-label" for="edit-phone">Phone <span class="client-edit-optional">(optional)</span></label>
                                <InputText id="edit-phone"
                                           class="nx-input"
                                           type="tel"
                                           placeholder="+27 82 000 0000"
                                           @bind-Value="EditModel.Phone" />
                                <ValidationMessage For="() => EditModel.Phone" />
                            </div>

                            <div class="client-edit-field">
                                <label class="nx-label" for="edit-id-number">ID number <span class="client-edit-optional">(optional)</span></label>
                                <InputText id="edit-id-number"
                                           class="nx-input"
                                           inputmode="numeric"
                                           placeholder="9001015800086"
                                           @bind-Value="EditModel.IdentificationNumber" />
                                <ValidationMessage For="() => EditModel.IdentificationNumber" />
                            </div>

                            <div class="client-edit-field">
                                <label class="nx-label" for="edit-risk">Risk profile <span class="client-edit-optional">(optional)</span></label>
                                <InputSelect id="edit-risk" class="nx-input" @bind-Value="EditModel.RiskProfile">
                                    <option value="">Not set</option>
                                    @foreach (var option in RiskOptionsFor(SelectedClient.RiskProfile))
                                    {
                                        <option value="@option">@option</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="client-edit-actions">
                                <button type="button" class="nx-btn nx-btn-secondary" @onclick="CancelEditingAsync" disabled="@IsSaving">
                                    Cancel
                                </button>
                                <button type="submit" class="nx-btn nx-btn-primary" disabled="@IsSaving">
                                    @(IsSaving ? "Saving…" : "Save changes")
                                </button>
                            </div>
                        </EditForm>

                    </div>
                }
                else
                {
                <div class="client-detail-body">

                    <div class="detail-field">
                        <span class="detail-label">Email</span>
                        <span class="detail-value">@SelectedClient.Email</span>
                    </div>

                    <div class="detail-field">
                        <span class="detail-label">Phone</span>
                        <span class="detail-value">@(string.IsNullOrWhiteSpace(SelectedClient.Phone) ? "—" : SelectedClient.Phone)</span>
                    </div>

                    <div class="detail-field">
                        <span class="detail-label">ID number</span>
                        <span class="detail-value">@(string.IsNullOrWhiteSpace(SelectedClient.IdentificationNumber) ? "—" : SelectedClient.IdentificationNumber)</span>
                    </div>

                    <div class="detail-field">
                        <span class="detail-label">Risk profile</span>
                        <span class="detail-value">@(string.IsNullOrWhiteSpace(SelectedClient.RiskProfile) ? "—" : SelectedClient.RiskProfile)</span>
                    </div>

                    <div class="detail-field">
                        <span class="detail-label">Client since</span>
                        <span class="detail-value">@SelectedClient.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</span>
                    </div>

                    <div class="case-progress">

                        <span class="detail-label">Application progress</span>

                           @if (!string.IsNullOrEmpty(CaseError))
                           {
                             <p class="clients-error">@CaseError</p>
                           }

                           @if (SelectedCase is null)
                           {
                              <span class="detail-value">No case on file for this client yet.</span>
                           }
                            else
                             {
                               <ul class="case-step-list">
                                     @foreach (var (step, label) in CaseSteps)
                                     {
                                         var complete = IsStepComplete(step);
                                         var stepDate = GetStepDate(step);
                                         <li class="case-step-row @(complete? "is-complete" : "")">
                                             <label class="case-step-check">
                                                 <input type="checkbox"
                                                        class="case-step-input"
                                                        checked="@complete"
                                                        disabled="@complete"
                                                        @onchange="() => MarkStep(step)" />
                                                 <span class="case-step-box">
                                                       <svg class="case-step-tick" viewBox="0 0 16 16">
                                                          <path d="M3 8.5L6.5 12L13 4.5" />
                                                       </svg>
                                                 </span>

                                                 <span class="case-step-text">
                                                       <span class="case-step-label">@label</span>
                                                        @if (stepDate is not null)
                                                        {
                                                          <span class="case-step-date">@stepDate</span>
                                                        }
                                                 </span>
                                             </label>
                                         </li>
                                     }
                               </ul>
                            }

                    </div>

                </div>
                }
            }

        </section>

    </main>

</div>
</ChildContent>
<ErrorContent>
    <div class="clients-page">
        <p class="clients-error">Something went wrong loading this page. Please refresh and try again.</p>
    </div>
</ErrorContent>
</ErrorBoundary>

@code {
    private List<ClientProfile> ClientResults = new();
    private ClientProfile? SelectedClient;
    private string SearchText = "";
    private string? LoadError;
    private bool IsLoading = true;
    private CaseSummary? SelectedCase;
    private string? CaseError;

    /// <summary>
    /// The status chosen in the filter dropdown. Empty means "All statuses".
    /// </summary>
    private string StatusFilter = "";

    private bool HasActiveFilters => !string.IsNullOrEmpty(SearchText) || !string.IsNullOrEmpty(StatusFilter);

    private IEnumerable<ClientProfile> FilteredClients => ClientResults
    .Where(c => string.IsNullOrEmpty(StatusFilter) ||
                string.Equals(c.Status, StatusFilter, StringComparison.OrdinalIgnoreCase))
    .Where(c => string.IsNullOrWhiteSpace(SearchText) ||
                $"{c.FirstName} {c.LastName}".Contains(SearchText.Trim(), StringComparison.OrdinalIgnoreCase) ||
                $"{c.LastName} {c.FirstName}".Contains(SearchText.Trim(), StringComparison.OrdinalIgnoreCase) ||
                c.Email.Contains(SearchText.Trim(), StringComparison.OrdinalIgnoreCase) ||
                c.Status.Contains(SearchText.Trim(), StringComparison.OrdinalIgnoreCase));

    [Parameter]
    [SupplyParameterFromQuery(Name = "search")]
    public string? SearchQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.EnsureRestoredAsync();
        await Search();
    }

    /// <summary>
    /// The ?search= value that has already been copied into the search box.
    /// The page re-receives its parameters on every re-render (e.g. when the layout updates),
    /// and the old code copied ?search= into the box each time, wiping what the user had typed.
    /// Now the URL value is only applied when it actually changes, e.g. a new search from the dashboard.
    /// </summary>
    private string? _appliedSearchQuery;

    protected override void OnParametersSet()
    {
        if (SearchQuery == _appliedSearchQuery)
        {
            return;
        }

        _appliedSearchQuery = SearchQuery;
        SearchText = SearchQuery ?? string.Empty;
    }

    /// <summary>
    /// Loads all of the advisor's clients once. Typing in the search box then filters
    /// this list instantly on the page (see FilteredClients), so clearing the box always
    /// brings every client back, even when the page was opened with ?search= from the dashboard.
    /// </summary>
    private async Task Search()
    {
        IsLoading = true;
        LoadError = null;

        var (clients, error) = await ClientDirectory.SearchAsync(null, null);
        ClientResults = clients;
        LoadError = error;
        IsLoading = false;

        if (SelectedClient is not null && ClientResults.All(c => c.ClientId != SelectedClient.ClientId))
        {
            SelectedClient = null;
        }
    }

    private static readonly (CaseStep Step, string Label)[] CaseSteps = new[]
    {
        (CaseStep.DetailsSubmitted, "Details submitted"),
        (CaseStep.AdviserReview, "Adviser review"),
        (CaseStep.FicaVerification, "FICA verification"),
        (CaseStep.SubmittedToLiberty, "Submitted to Liberty"),
        (CaseStep.PolicyIssued, "Policy issued"),
    };

    private async Task SelectClient(ClientProfile client)
    {
        // Picking another client leaves edit mode without saving.
        IsEditing = false;
        EditError = null;
        DetailMessage = null;

        SelectedClient = client;

        // Fetch the full profile Phone, ID number, Risk profile
        var (fullClient, error) = await ClientDirectory.GetByIdAsync(client.ClientId);
        if (fullClient is not null)
        {
            SelectedClient = fullClient;
        }

        await LoadCaseForSelectedClient();
    }

    private async Task LoadCaseForSelectedClient()
    {
        SelectedCase = null;
        CaseError = null;

        if (SelectedClient is null)
        {
            return;
        }

        var (cases, error) = await CaseDirectory.GetForClientAsync(SelectedClient.ClientId);
        CaseError = error;
        SelectedCase = cases.FirstOrDefault();
    }

    private bool IsStepComplete(CaseStep step)
    {
        if (SelectedCase is null)
        {
            return false;
        }

        return step switch
        {
            CaseStep.DetailsSubmitted => SelectedCase.DetailsSubmittedAt.HasValue,
            CaseStep.AdviserReview => SelectedCase.AdviserReviewAt.HasValue,
            CaseStep.FicaVerification => SelectedCase.FicaVerifiedAt.HasValue,
            CaseStep.SubmittedToLiberty => SelectedCase.SubmittedToLibertyAt.HasValue,
            CaseStep.PolicyIssued => SelectedCase.PolicyIssuedAt.HasValue,
            _ => false
        };
    }

    private async Task MarkStep(CaseStep step)
    {
        if (SelectedCase is null)
        {
            return;
        }

        var (updated, error) = await CaseDirectory.MarkStepCompleteAsync(SelectedCase.CaseId, step);

        if (error is not null)
        {
            CaseError = error;
            return;
        }

        SelectedCase = updated;
        CaseError = null;
    }

    private string? GetStepDate(CaseStep step)
    {
        if (SelectedCase is null)
        {
            return null;
        }

        var when = step switch
        {
            CaseStep.DetailsSubmitted => SelectedCase.DetailsSubmittedAt,
            CaseStep.AdviserReview => SelectedCase.AdviserReviewAt,
            CaseStep.FicaVerification => SelectedCase.FicaVerifiedAt,
            CaseStep.SubmittedToLiberty => SelectedCase.SubmittedToLibertyAt,
            CaseStep.PolicyIssued => SelectedCase.PolicyIssuedAt,
            _ => null
        };
        return when?.ToString("dd MMM yyyy");
    }


    // ---------------------------------------------------------
    // Editing a client
    // ---------------------------------------------------------

    /// <summary>
    /// Same choices as the New Client wizard.
    /// </summary>
    private static readonly string[] RiskOptions = { "Conservative", "Moderate", "Balanced", "Aggressive" };

    private bool IsEditing;
    private bool IsSaving;
    private string? EditError;
    private EditClientForm EditModel = new();

    /// <summary>
    /// A short green confirmation under the panel header, e.g. "Client updated".
    /// </summary>
    private string? DetailMessage;

    private ElementReference EditButton;
    private InputText? FirstNameInput;
    private bool FocusFirstField;
    private bool FocusEditButton;

    /// <summary>
    /// Keeps a risk profile that isn't one of the standard options (older data) selectable.
    /// </summary>
    private static IEnumerable<string> RiskOptionsFor(string? current) =>
        string.IsNullOrWhiteSpace(current) || RiskOptions.Contains(current)
            ? RiskOptions
            : RiskOptions.Append(current);

    private void StartEditing()
    {
        if (SelectedClient is null)
        {
            return;
        }

        EditModel = new EditClientForm
        {
            FirstName = SelectedClient.FirstName,
            LastName = SelectedClient.LastName,
            Phone = SelectedClient.Phone,
            IdentificationNumber = SelectedClient.IdentificationNumber,
            RiskProfile = SelectedClient.RiskProfile
        };

        EditError = null;
        DetailMessage = null;
        IsEditing = true;
        FocusFirstField = true;
    }

    private Task CancelEditingAsync()
    {
        IsEditing = false;
        EditError = null;
        FocusEditButton = true;
        return Task.CompletedTask;
    }

    /// <summary>
    /// Escape leaves the form without saving, like the other panels in the app.
    /// </summary>
    private async Task HandleEditKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && !IsSaving)
        {
            await CancelEditingAsync();
        }
    }

    /// <summary>
    /// Runs only when every field passes its rules (EditForm OnValidSubmit).
    /// </summary>
    private async Task SaveClientAsync()
    {
        if (SelectedClient is null)
        {
            return;
        }

        IsSaving = true;
        EditError = null;

        // Empty optional boxes are sent as null: the API's [Phone] rule rejects an empty string.
        static string? OrNull(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

        var request = new Shared.DTOs.Clients.UpdateClientRequest
        {
            FirstName = EditModel.FirstName.Trim(),
            LastName = EditModel.LastName.Trim(),
            Phone = OrNull(EditModel.Phone),
            IdentificationNumber = OrNull(EditModel.IdentificationNumber),
            RiskProfile = OrNull(EditModel.RiskProfile)
        };

        var (updated, error) = await ClientDirectory.UpdateAsync(SelectedClient.ClientId, request);

        IsSaving = false;

        if (updated is null)
        {
            EditError = error ?? "The client could not be saved.";
            return;
        }

        // Keep the list on the left in step with the panel.
        var index = ClientResults.FindIndex(c => c.ClientId == updated.ClientId);
        if (index >= 0)
        {
            ClientResults[index] = updated;
        }

        SelectedClient = updated;
        IsEditing = false;
        FocusEditButton = true;
        ShowDetailMessage($"{updated.FirstName} {updated.LastName}'s details were updated.");
    }

    /// <summary>
    /// Shows a confirmation for a few seconds, then hides it.
    /// </summary>
    private void ShowDetailMessage(string message)
    {
        DetailMessage = message;

        _ = Task.Delay(4000).ContinueWith(_ => InvokeAsync(() =>
        {
            if (DetailMessage == message)
            {
                DetailMessage = null;
                StateHasChanged();
            }
        }));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Move keyboard focus to the right place after the panel switches mode.
        if (FocusFirstField && FirstNameInput?.Element is ElementReference first)
        {
            FocusFirstField = false;
            await first.FocusAsync();
        }
        else if (FocusEditButton && !IsEditing)
        {
            FocusEditButton = false;
            try { await EditButton.FocusAsync(); } catch (Exception) { }
        }
    }
}

