@page "/clients"
@layout MainLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using frontend.Services
@inject ClientService ClientDirectory
@inject CurrentUserService CurrentUser
@using Microsoft.AspNetCore.Components

<PageTitle>Clients | Nexus</PageTitle>

<ErrorBoundary>
<ChildContent>
<div class="clients-page">

    <header class="clients-header">

        <div class="clients-heading">
            <h1>Clients</h1>
            <p>Search your client base and open a profile for the full picture.</p>
        </div>

        <div class="header-actions">

            <div class="search-box">
                <span class="search-icon">⌕</span>

                <input type="text"
                       value="@SearchText"
                       @oninput="OnSearchInput"
                       placeholder="Search by name, email or status" />
            </div>

            <button type="button"
                    class="notification-button"
                    aria-label="Notifications">
                ♧
            </button>

        </div>

    </header>

    @if (!string.IsNullOrEmpty(LoadError))
    {
        <p class="clients-error">@LoadError</p>
    }

    <main class="clients-content">

        <section class="clients-list-panel">

            <div class="panel-heading">
                <h2>@(IsLoading ? "Clients" : $"Clients ({ClientResults.Count})")</h2>
            </div>

            <div class="clients-list">

                @if (IsLoading)
                {
                    <div class="clients-empty-state">
                        <span>Loading clients…</span>
                    </div>
                }
                else if (ClientResults.Count == 0)
                {
                    <div class="clients-empty-state">
                        <span>No clients found.</span>
                    </div>
                }
                else
                {
                    @foreach (var client in ClientResults)
                    {
                        <button type="button"
                                class="client-item @(SelectedClient?.ClientId == client.ClientId ? "selected" : "")"
                                @onclick="() => SelectedClient = client">

                            <div class="client-item-top">
                                <strong>@client.FirstName @client.LastName</strong>
                                <span class="client-status-badge">@client.Status</span>
                            </div>

                            <span class="client-item-email">@client.Email</span>

                        </button>
                    }
                }

            </div>

        </section>

        <section class="client-detail-panel">

            @if (SelectedClient is null)
            {
                <div class="client-empty-state">
                    <div class="empty-client-icon">◍</div>
                    <strong>No client selected</strong>
                    <span>Choose a client from the list to see their profile.</span>
                </div>
            }
            else
            {
                <div class="client-detail-header">

                    <div class="client-detail-heading">
                        <h2>@SelectedClient.FirstName @SelectedClient.LastName</h2>
                    </div>

                    <span class="case-status">
                        <span class="status-dot"></span>
                        @SelectedClient.Status
                    </span>

                </div>

                <div class="client-detail-body">

                    <div class="detail-field">
                        <span class="detail-label">Email</span>
                        <span class="detail-value">@SelectedClient.Email</span>
                    </div>

                    <div class="detail-field">
                        <span class="detail-label">Phone</span>
                        <span class="detail-value">@(SelectedClient.Phone ?? "—")</span>
                    </div>

                    <div class="detail-field">
                        <span class="detail-label">ID number</span>
                        <span class="detail-value">@(SelectedClient.IdentityNumber ?? "—")</span>
                    </div>

                    <div class="detail-field">
                        <span class="detail-label">Risk profile</span>
                        <span class="detail-value">@(SelectedClient.RiskProfile ?? "—")</span>
                    </div>

                    <div class="detail-field">
                        <span class="detail-label">Client since</span>
                        <span class="detail-value">@SelectedClient.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</span>
                    </div>

                </div>

            }

        </section>

    </main>

</div>
</ChildContent>
<ErrorContent>
    <div class="clients-page">
        <p class="clients-error">Something went wrong loading this page. Please refresh and try again.</p>
    </div>
</ErrorContent>
</ErrorBoundary>

@code {
    private List<ClientProfile> ClientResults = new();
    private ClientProfile? SelectedClient;
    private string SearchText = string.Empty;
    private string? LoadError;
    private bool IsLoading = true;

    [Parameter]
    [SupplyParameterFromQuery(Name = "search")]
    public string? SearchQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.EnsureRestoredAsync();
        await Search();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString() ?? string.Empty;
        SearchText = SearchQuery ?? string.Empty;
        await Search();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (SearchQuery is not null && SearchQuery != SearchText)
        {
            SearchText = SearchQuery;
            await Search();
        }
    }

    private async Task Search()
    {
        IsLoading = true;
        LoadError = null;

        var (clients, error) = await ClientDirectory.SearchAsync(SearchText);
        ClientResults = clients;
        LoadError = error;
        IsLoading = false;

        if (SelectedClient is not null && ClientResults.All(c => c.ClientId != SelectedClient.ClientId))
        {
            SelectedClient = null;
        }
    }
}
