@page "/new-client"
@layout MainLayout
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@using Shared.Models.Enums
@using frontend.Services
@using System.Text.Json
@inject ClientService Clients
@inject PolicyService Policies
@inject DocumentService Documents
@inject CurrentUserService CurrentUser
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>New Client | Nexus</PageTitle>

<div class="new-client-page">

    <!-- PAGE HEADER -->
    <header class="page-header">

        <div class="page-heading">
            <h1>New client</h1>
            <p>Step @CurrentStep of 4 · @StepNames[CurrentStep - 1] · Details captured here populate every document</p>
        </div>

        <div class="header-actions">

            <div class="search-box">
                <span class="search-icon">⌕</span>
                <input type="text" placeholder="Search clients, cases, documents" />
            </div>

            <NotificationBell />

        </div>

    </header>


    <!-- PAGE BODY -->
    <main class="new-client-content">

        <div class="content-column">

            <!-- STEP INDICATOR -->
            <section class="stepper-card">
                @for (var i = 1; i <= 4; i++)
                {
                    var stepIndex = i;
                    <div class="step @(stepIndex == CurrentStep ? "active" : "") @(stepIndex < CurrentStep ? "complete" : "")"
                         @onclick="() => TryJumpToStep(stepIndex)" style="cursor:pointer">
                        <span class="step-number">@(stepIndex < CurrentStep ? "✓" : stepIndex.ToString())</span>
                        <span class="step-name">@StepNames[stepIndex - 1]</span>
                    </div>
                    if (i < 4)
                    {
                        <div class="step-line"></div>
                    }
                }
            </section>

            @if (!string.IsNullOrEmpty(StepError))
            {
                <p class="invite-error">@StepError</p>
            }

            @if (ShowDraftBanner && PendingDraft is not null)
            {
                <div class="draft-banner">
                    <div class="draft-banner-text">
                        <strong>Unfinished client intake found</strong>
                        <span>
                            @(string.IsNullOrWhiteSpace(PendingDraft.FirstName) && string.IsNullOrWhiteSpace(PendingDraft.LastName)
                                ? "You have a saved draft"
                                : $"Draft for {PendingDraft.FirstName} {PendingDraft.LastName}") ·
                            saved @PendingDraft.SavedAt.ToLocalTime().ToString("d MMM, HH:mm")
                            @(PendingDraft.HadDocuments ? " · documents will need to be re-attached" : "")
                        </span>
                    </div>
                    <div class="draft-banner-actions">
                        <button type="button" class="secondary-button" @onclick="DiscardDraftAsync">Start over</button>
                        <button type="button" class="primary-button" @onclick="ResumeDraft">Resume</button>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(DraftSavedMessage))
            {
                <p class="draft-saved-message">@DraftSavedMessage</p>
            }

            @if (CurrentStep == 1)
            {
                <!-- PERSONAL DETAILS -->
                <section class="form-card">
                    <div class="card-heading"><h2>Personal details</h2></div>
                    <div class="form-body">
                        <div class="form-grid">

                            <div class="form-group @ErrorClass(nameof(Model.FirstName))">
                                <label for="firstName">First name</label>
                                <input id="firstName" type="text" @bind="Model.FirstName" @bind:after="() => ClearFieldError(nameof(Model.FirstName))" placeholder="Thandi" />
                                @FieldError(nameof(Model.FirstName))
                            </div>

                            <div class="form-group @ErrorClass(nameof(Model.LastName))">
                                <label for="lastName">Last name</label>
                                <input id="lastName" type="text" @bind="Model.LastName" @bind:after="() => ClearFieldError(nameof(Model.LastName))" placeholder="Mokoena" />
                                @FieldError(nameof(Model.LastName))
                            </div>

                            <div class="form-group @ErrorClass(nameof(Model.IdentificationNumber))">
                                <label for="idNumber">ID number</label>
                                <input id="idNumber" type="text" @bind="Model.IdentificationNumber" @bind:after="() => ClearFieldError(nameof(Model.IdentificationNumber))" placeholder="9001015800086" />
                                @FieldError(nameof(Model.IdentificationNumber))
                            </div>

                            <div class="form-group @ErrorClass(nameof(Model.DateOfBirth))">
                                <label for="dateOfBirth">Date of birth</label>
                                <input id="dateOfBirth" type="date" @bind="Model.DateOfBirth" @bind:after="() => ClearFieldError(nameof(Model.DateOfBirth))" />
                                @FieldError(nameof(Model.DateOfBirth))
                            </div>

                            <div class="form-group @ErrorClass(nameof(Model.Email))">
                                <label for="email">Email</label>
                                <input id="email" type="email" @bind="Model.Email" @bind:after="() => ClearFieldError(nameof(Model.Email))" placeholder="thandi@example.co.za" />
                                @FieldError(nameof(Model.Email))
                            </div>

                            <div class="form-group @ErrorClass(nameof(Model.Phone))">
                                <label for="mobile">Mobile</label>
                                <input id="mobile" type="tel" @bind="Model.Phone" @bind:after="() => ClearFieldError(nameof(Model.Phone))" placeholder="+27 82 000 0000" />
                                @FieldError(nameof(Model.Phone))
                            </div>

                            <div class="form-group full-width @ErrorClass(nameof(Model.ResidentialAddress))">
                                <label for="address">Residential address</label>
                                <input id="address" type="text" @bind="Model.ResidentialAddress" @bind:after="() => ClearFieldError(nameof(Model.ResidentialAddress))" placeholder="12 Rivonia Road, Sandton" />
                                @FieldError(nameof(Model.ResidentialAddress))
                            </div>

                            <div class="form-group">
                                <label for="maritalStatus">Marital status</label>
                                <select id="maritalStatus" @bind="Model.MaritalStatus">
                                    <option value="">Select marital status</option>
                                    <option>Single</option>
                                    <option>Married in community of property</option>
                                    <option>Married out of community of property</option>
                                    <option>Divorced</option>
                                    <option>Widowed</option>
                                </select>
                            </div>

                            <div class="form-group @ErrorClass(nameof(Model.Dependants))">
                                <label for="dependants">Dependants</label>
                                <input id="dependants" type="number" min="0" @bind="Model.Dependants" @bind:after="() => ClearFieldError(nameof(Model.Dependants))" placeholder="0" />
                                @FieldError(nameof(Model.Dependants))
                            </div>

                        </div>
                    </div>
                </section>

                <!-- ASSIGN CASE -->
                <section class="form-card assign-card">
                    <div class="card-heading"><h2>Assign case</h2></div>
                    <div class="form-body">
                        <div class="form-grid">

                            <div class="form-group @ErrorClass(nameof(Model.Institution))">
                                <label for="institution">Institution</label>
                                <select id="institution" @bind="Model.Institution" @bind:after="() => ClearFieldError(nameof(Model.Institution))">
                                    <option value="">Select institution</option>
                                    <option>Liberty</option>
                                    <option>Standard Bank</option>
                                </select>
                                @FieldError(nameof(Model.Institution))
                            </div>

                            <div class="form-group @ErrorClass(nameof(Model.Product))">
                                <label for="product">Product</label>
                                <select id="product" @bind="Model.Product" @bind:after="() => ClearFieldError(nameof(Model.Product))">
                                    <option value="">Select product</option>
                                    <option>Retirement Annuity</option>
                                    <option>Life Cover</option>
                                    <option>Investment Plan</option>
                                    <option>Tax-Free Savings</option>
                                    <option>Disability Cover</option>
                                    <option>Estate Review</option>
                                </select>
                                @FieldError(nameof(Model.Product))
                            </div>

                            <div class="form-group">
                                <label for="adviser">Adviser</label>
                                <select id="adviser" disabled>
                                    <option>@(string.IsNullOrWhiteSpace(CurrentUser.FirstName) ? "You" : $"{CurrentUser.FirstName} {CurrentUser.LastName}") (you)</option>
                                </select>
                            </div>

                            <div class="form-group @ErrorClass(nameof(Model.TargetSubmissionDate))">
                                <label for="submissionDate">Target submission date</label>
                                <input id="submissionDate" type="date" @bind="Model.TargetSubmissionDate" @bind:after="() => ClearFieldError(nameof(Model.TargetSubmissionDate))" />
                                @FieldError(nameof(Model.TargetSubmissionDate))
                            </div>

                        </div>

                        <div class="form-actions">
                            <button type="button" class="secondary-button" @onclick="SaveDraftAsync">Save draft</button>
                            <button type="button" class="primary-button" @onclick="() => GoToStep(2)">Continue to financial profile</button>
                        </div>
                    </div>
                </section>
            }
            else if (CurrentStep == 2)
            {
                <!-- FINANCIAL PROFILE -->
                <section class="form-card">
                    <div class="card-heading"><h2>Employment &amp; income</h2></div>
                    <div class="form-body">
                        <div class="form-grid">

                            <div class="form-group">
                                <label for="employmentStatus">Employment status</label>
                                <select id="employmentStatus" @bind="Model.EmploymentStatus">
                                    <option value="">Select status</option>
                                    <option>Employed</option>
                                    <option>Self-employed</option>
                                    <option>Unemployed</option>
                                    <option>Retired</option>
                                    <option>Student</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="occupation">Occupation</label>
                                <input id="occupation" type="text" @bind="Model.Occupation" placeholder="Engineer" />
                            </div>

                            <div class="form-group">
                                <label for="employer">Employer</label>
                                <input id="employer" type="text" @bind="Model.Employer" placeholder="Sasol Ltd" />
                            </div>

                            <div class="form-group @ErrorClass(nameof(Model.GrossMonthlyIncome))">
                                <label for="grossIncome">Gross monthly income</label>
                                <input id="grossIncome" type="number" step="0.01" @bind="Model.GrossMonthlyIncome" @bind:after="() => ClearFieldError(nameof(Model.GrossMonthlyIncome))" placeholder="65000" />
                                @FieldError(nameof(Model.GrossMonthlyIncome))
                            </div>

                            <div class="form-group @ErrorClass(nameof(Model.NetMonthlyIncome))">
                                <label for="netIncome">Net monthly income</label>
                                <input id="netIncome" type="number" step="0.01" @bind="Model.NetMonthlyIncome" @bind:after="() => ClearFieldError(nameof(Model.NetMonthlyIncome))" placeholder="46500" />
                                @FieldError(nameof(Model.NetMonthlyIncome))
                            </div>

                            <div class="form-group @ErrorClass(nameof(Model.MonthlyExpenses))">
                                <label for="monthlyExpenses">Monthly expenses</label>
                                <input id="monthlyExpenses" type="number" step="0.01" @bind="Model.MonthlyExpenses" @bind:after="() => ClearFieldError(nameof(Model.MonthlyExpenses))" placeholder="32000" />
                                @FieldError(nameof(Model.MonthlyExpenses))
                            </div>

                            <div class="form-group">
                                <label for="sourceOfFunds">Source of funds</label>
                                <select id="sourceOfFunds" @bind="Model.SourceOfFunds">
                                    <option value="">Select source</option>
                                    <option>Salary</option>
                                    <option>Business income</option>
                                    <option>Investments</option>
                                    <option>Inheritance</option>
                                    <option>Other</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="taxNumber">Tax number</label>
                                <input id="taxNumber" type="text" @bind="Model.TaxNumber" placeholder="0123456789" />
                            </div>

                        </div>
                    </div>
                </section>

                <section class="form-card">
                    <div class="card-heading"><h2>Assets &amp; liabilities</h2></div>
                    <div class="form-body">
                        <div class="form-grid">

                            <div class="form-group @ErrorClass(nameof(Model.PropertyValue))">
                                <label for="propertyValue">Property value</label>
                                <input id="propertyValue" type="number" step="0.01" @bind="Model.PropertyValue" @bind:after="() => ClearFieldError(nameof(Model.PropertyValue))" placeholder="2400000" />
                                @FieldError(nameof(Model.PropertyValue))
                            </div>

                            <div class="form-group @ErrorClass(nameof(Model.ExistingInvestments))">
                                <label for="existingInvestments">Existing investments</label>
                                <input id="existingInvestments" type="number" step="0.01" @bind="Model.ExistingInvestments" @bind:after="() => ClearFieldError(nameof(Model.ExistingInvestments))" placeholder="380000" />
                                @FieldError(nameof(Model.ExistingInvestments))
                            </div>

                            <div class="form-group @ErrorClass(nameof(Model.RetirementSavings))">
                                <label for="retirementSavings">Retirement savings</label>
                                <input id="retirementSavings" type="number" step="0.01" @bind="Model.RetirementSavings" @bind:after="() => ClearFieldError(nameof(Model.RetirementSavings))" placeholder="412800" />
                                @FieldError(nameof(Model.RetirementSavings))
                            </div>

                            <div class="form-group @ErrorClass(nameof(Model.OutstandingDebt))">
                                <label for="outstandingDebt">Outstanding debt</label>
                                <input id="outstandingDebt" type="number" step="0.01" @bind="Model.OutstandingDebt" @bind:after="() => ClearFieldError(nameof(Model.OutstandingDebt))" placeholder="1150000" />
                                @FieldError(nameof(Model.OutstandingDebt))
                            </div>

                        </div>
                    </div>
                </section>

                <section class="form-card">
                    <div class="card-heading"><h2>Goals &amp; risk profile</h2></div>
                    <div class="form-body">
                        <div class="form-grid">

                            <div class="form-group">
                                <label for="primaryGoal">Primary goal</label>
                                <select id="primaryGoal" @bind="Model.PrimaryGoal">
                                    <option value="">Select goal</option>
                                    <option>Retirement</option>
                                    <option>Education</option>
                                    <option>Wealth growth</option>
                                    <option>Protection</option>
                                    <option>Estate planning</option>
                                </select>
                            </div>

                            <div class="form-group @ErrorClass(nameof(Model.InvestmentHorizonYears))">
                                <label for="investmentHorizon">Investment horizon (years)</label>
                                <input id="investmentHorizon" type="number" min="0" @bind="Model.InvestmentHorizonYears" @bind:after="() => ClearFieldError(nameof(Model.InvestmentHorizonYears))" placeholder="25" />
                                @FieldError(nameof(Model.InvestmentHorizonYears))
                            </div>

                        </div>

                        <div class="form-group full-width @ErrorClass(nameof(Model.RiskProfile))">
                            <label>Risk appetite</label>
                            <div class="pipeline-filters">
                                @foreach (var option in RiskOptions)
                                {
                                    <button type="button"
                                            class="filter-pill @(Model.RiskProfile == option ? "active" : "")"
                                            @onclick="() => SelectRiskProfile(option)">
                                        @option
                                    </button>
                                }
                            </div>
                            @FieldError(nameof(Model.RiskProfile))
                        </div>

                        <div class="form-actions">
                            <button type="button" class="secondary-button" @onclick="() => GoToStep(1)">Back</button>
                            <button type="button" class="primary-button" @onclick="() => GoToStep(3)">Continue to documents</button>
                        </div>
                    </div>
                </section>
            }
            else if (CurrentStep == 3)
            {
                <!-- DOCUMENTS -->
                <section class="form-card">
                    <div class="card-heading"><h2>Document checklist</h2></div>
                    <div class="form-body">

                        @foreach (var slot in DocumentSlots)
                        {
                            <div class="deadline-item @ErrorClass(DocKey(slot.Type))">
                                <div class="deadline-details">
                                    <span class="deadline-title">@slot.Label @(slot.Required ? "" : "(optional)")</span>
                                    <span class="deadline-client">@slot.Hint · PDF, JPG or PNG, max 30MB</span>
                                    @FieldError(DocKey(slot.Type))
                                </div>

                                @if (PickedFiles.ContainsKey(slot.Type))
                                {
                                    <span class="picked-file">
                                        <span class="requirement complete">
                                            <span class="requirement-icon">✓</span>
                                            <span>@PickedFiles[slot.Type].Name</span>
                                        </span>
                                        @if (!UploadedDocs.Contains(slot.Type))
                                        {
                                            <button type="button" class="remove-file-button" title="Remove file" aria-label="Remove @PickedFiles[slot.Type].Name" @onclick="() => RemoveFile(slot.Type)">×</button>
                                        }
                                    </span>
                                }
                                else
                                {
                                    <label class="upload-button">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                                        <span>Upload file</span>
                                        <InputFile OnChange="@(e => OnFileSelected(e, slot.Type))" accept=".pdf,.jpg,.jpeg,.png" />
                                    </label>
                                }
                            </div>
                        }

                    </div>
                </section>

                <div class="form-actions">
                    <button type="button" class="secondary-button" @onclick="() => GoToStep(2)">Back</button>
                    <button type="button" class="primary-button" @onclick="() => GoToStep(4)">Continue to summary</button>
                </div>
            }
            else if (CurrentStep == 4)
            {
                <!-- SUMMARY -->
                <section class="form-card">
                    <div class="card-heading"><h2>Review &amp; submit</h2></div>
                    <div class="form-body">

                        <div class="summary-grid form-grid">
                            <div class="form-group">
                                <label>Client</label>
                                <strong>@Model.FirstName @Model.LastName</strong>
                            </div>
                            <div class="form-group">
                                <label>Contact</label>
                                <span>@Model.Email · @Model.Phone</span>
                            </div>
                            <div class="form-group">
                                <label>Product</label>
                                <span>@(string.IsNullOrWhiteSpace(Model.Product) ? "Not assigned" : $"{Model.Product} · {Model.Institution}")</span>
                            </div>
                            <div class="form-group">
                                <label>Risk profile</label>
                                <span>@(string.IsNullOrWhiteSpace(Model.RiskProfile) ? "Not set" : Model.RiskProfile)</span>
                            </div>
                            <div class="form-group">
                                <label>Documents</label>
                                <span>@PickedFiles.Count of @DocumentSlots.Count uploaded</span>
                            </div>
                        </div>

                        <div class="form-group full-width @ErrorClass(nameof(Model.PopiaConsent))" style="margin-top:1rem">
                            <label style="display:flex;align-items:flex-start;gap:0.5rem">
                                <input type="checkbox" @bind="Model.PopiaConsent" @bind:after="() => ClearFieldError(nameof(Model.PopiaConsent))" />
                                <span>Client consents to processing of personal information (POPIA) and receipt of the service package for digital signature.</span>
                            </label>
                            @FieldError(nameof(Model.PopiaConsent))
                        </div>

                        @if (!string.IsNullOrEmpty(SubmitError))
                        {
                            <div class="submit-alert" role="alert">
                                <strong>The client wasn't created</strong>
                                <span>@SubmitError</span>
                                <span>Nothing you entered was lost. Check the details and try again.</span>
                            </div>
                        }

                        @if (PartialProblems.Count > 0)
                        {
                            <div class="partial-result" role="alert">
                                <strong>@Model.FirstName @Model.LastName was saved, but a few things didn't finish:</strong>
                                <ul>
                                    @foreach (var problem in PartialProblems)
                                    {
                                        <li>@problem</li>
                                    }
                                </ul>
                                <div class="partial-result-actions">
                                    <button type="button" class="secondary-button" @onclick='() => Nav.NavigateTo("/clients")'>Go to clients</button>
                                    <button type="button" class="primary-button" @onclick="SubmitAsync" disabled="@IsSubmitting">
                                        @(IsSubmitting ? "Retrying…" : "Try again")
                                    </button>
                                </div>
                            </div>
                        }

                        <div class="form-actions">
                            <button type="button" class="secondary-button" @onclick="() => GoToStep(3)" disabled="@IsSubmitting">Back</button>
                            @if (PartialProblems.Count == 0)
                            {
                                <button type="button" class="primary-button" @onclick="SubmitAsync" disabled="@IsSubmitting">
                                    @(IsSubmitting ? "Creating client…" : "Create client")
                                </button>
                            }
                        </div>
                    </div>
                </section>
            }

        </div>


        <!-- RIGHT SIDEBAR -->
        <aside class="side-column">
            <section class="side-card">
                <div class="side-card-heading"><h2>Required to submit</h2></div>
                <div class="requirements-list">
                    <div class="requirement @(HasIdentityDetails ? "complete" : "pending")">
                        <span class="requirement-icon">@(HasIdentityDetails ? "✓" : "")</span>
                        <span>Identity details</span>
                    </div>
                    <div class="requirement @(HasContactDetails ? "complete" : "pending")">
                        <span class="requirement-icon">@(HasContactDetails ? "✓" : "")</span>
                        <span>Contact details</span>
                    </div>
                    <div class="requirement @(HasAddress ? "complete" : "pending")">
                        <span class="requirement-icon">@(HasAddress ? "✓" : "")</span>
                        <span>Address</span>
                    </div>
                    <div class="requirement @(HasRequiredDocuments ? "complete" : "pending")">
                        <span class="requirement-icon">@(HasRequiredDocuments ? "✓" : "")</span>
                        <span>FICA documents</span>
                    </div>
                    <div class="requirement @(HasRiskProfile ? "complete" : "pending")">
                        <span class="requirement-icon">@(HasRiskProfile ? "✓" : "")</span>
                        <span>Risk profile</span>
                    </div>
                </div>
            </section>
        </aside>

    </main>

</div>

@code {

    private sealed class DocumentSlot
    {
        public DocumentType Type { get; init; }
        public string Label { get; init; } = string.Empty;
        public string Hint { get; init; } = string.Empty;
        public bool Required { get; init; }
    }

    private readonly string[] StepNames = { "Personal details", "Financial profile", "Documents", "Summary" };
    private readonly string[] RiskOptions = { "Conservative", "Moderate", "Balanced", "Aggressive" };

    private readonly List<DocumentSlot> DocumentSlots = new()
    {
        new() { Type = DocumentType.CertifiedIdCopy, Label = "Certified ID copy", Hint = "Not older than 3 months", Required = true },
        new() { Type = DocumentType.ProofOfAddress, Label = "Proof of address", Hint = "Utility bill or bank letter, last 3 months", Required = true },
        new() { Type = DocumentType.BankStatement, Label = "Latest bank statement", Hint = "3 months", Required = false },
        new() { Type = DocumentType.Payslip, Label = "Latest payslip", Hint = "Most recent month", Required = false },
        new() { Type = DocumentType.TaxCertificate, Label = "Tax certificate (IRP5)", Hint = "Optional", Required = false },
    };

    private sealed record PickedFile(string Name, string ContentType, byte[] Content);
    private readonly Dictionary<DocumentType, PickedFile> PickedFiles = new();

    private sealed class NewClientModel
    {
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string? Phone { get; set; }
        public string? IdentificationNumber { get; set; }
        public DateTime? DateOfBirth { get; set; }
        public string? ResidentialAddress { get; set; }
        public string? MaritalStatus { get; set; }
        public int? Dependants { get; set; }

        public string? Institution { get; set; }
        public string? Product { get; set; }
        public DateTime? TargetSubmissionDate { get; set; }

        public string? EmploymentStatus { get; set; }
        public string? Occupation { get; set; }
        public string? Employer { get; set; }
        public decimal? GrossMonthlyIncome { get; set; }
        public decimal? NetMonthlyIncome { get; set; }
        public decimal? MonthlyExpenses { get; set; }
        public string? SourceOfFunds { get; set; }
        public string? TaxNumber { get; set; }
        public decimal? PropertyValue { get; set; }
        public decimal? ExistingInvestments { get; set; }
        public decimal? RetirementSavings { get; set; }
        public decimal? OutstandingDebt { get; set; }
        public string? PrimaryGoal { get; set; }
        public int? InvestmentHorizonYears { get; set; }

        public string RiskProfile { get; set; } = string.Empty;
        public bool PopiaConsent { get; set; }
    }

    private readonly NewClientModel Model = new();

    private int CurrentStep = 1;
    private string? StepError;
    private string? SubmitError;
    private bool IsSubmitting;

    // ---------------------------------------------------------
    // Error handling
    // ---------------------------------------------------------

    /// <summary>
    /// Errors for each field, e.g. "Email" -> "Enter a valid email address".
    /// </summary>
    private readonly Dictionary<string, string> FieldErrors = new();

    /// <summary>
    /// Set when the page should jump to the first field with an error after it redraws.
    /// </summary>
    private bool FocusFirstError;

    /// <summary>
    /// Remembers what was already saved, so "Try again" doesn't create the client twice.
    /// </summary>
    private int? CreatedClientId;
    private int? CreatedPolicyId;
    private readonly HashSet<DocumentType> UploadedDocs = new();

    /// <summary>
    /// Things that didn't finish after the client was saved (e.g. an upload that failed).
    /// </summary>
    private readonly List<string> PartialProblems = new();

    private static readonly string[] AllowedFileTypes = { ".pdf", ".jpg", ".jpeg", ".png" };
    private const long MaxFileSize = 30_000_000;

    private static readonly System.Text.RegularExpressions.Regex EmailPattern =
        new(@"^[^@\s]+@[^@\s]+\.[^@\s]+$", System.Text.RegularExpressions.RegexOptions.Compiled);

    private static string DocKey(DocumentType type) => $"Doc_{type}";

    private string ErrorClass(string field) => FieldErrors.ContainsKey(field) ? "has-error" : string.Empty;

    private string? GetFieldError(string field) => FieldErrors.TryGetValue(field, out var message) ? message : null;

    /// <summary>
    /// Shows a small red message under a field, if it has an error.
    /// </summary>
    private RenderFragment FieldError(string field) => __builder =>
    {
        var message = GetFieldError(field);
        if (message is not null)
        {
            <span class="field-error" role="alert">@message</span>
        }
    };

    /// <summary>
    /// Removes a field's error as soon as the user changes it.
    /// </summary>
    private void ClearFieldError(string field)
    {
        FieldErrors.Remove(field);
    }

    private void SelectRiskProfile(string option)
    {
        Model.RiskProfile = option;
        ClearFieldError(nameof(Model.RiskProfile));
    }

    /// <summary>
    /// Checks every field on one step and records what's wrong. Returns true if the step is fine.
    /// </summary>
    private bool ValidateStep(int step)
    {
        void Error(string field, string message) => FieldErrors[field] = message;

        if (step == 1)
        {
            if (string.IsNullOrWhiteSpace(Model.FirstName)) Error(nameof(Model.FirstName), "Enter the client's first name.");
            if (string.IsNullOrWhiteSpace(Model.LastName)) Error(nameof(Model.LastName), "Enter the client's last name.");

            var id = (Model.IdentificationNumber ?? string.Empty).Replace(" ", "");
            if (id.Length == 0) Error(nameof(Model.IdentificationNumber), "Enter the client's ID number.");
            else if (id.Length != 13 || !id.All(char.IsDigit)) Error(nameof(Model.IdentificationNumber), "A South African ID number must be 13 digits.");
            else if (!PassesLuhnCheck(id)) Error(nameof(Model.IdentificationNumber), "This ID number isn't valid. Check for a typo.");

            if (Model.DateOfBirth is DateTime dob)
            {
                if (dob.Date > DateTime.Today) Error(nameof(Model.DateOfBirth), "Date of birth can't be in the future.");
                else if (dob.Date < DateTime.Today.AddYears(-120)) Error(nameof(Model.DateOfBirth), "Check the date of birth.");
            }

            if (string.IsNullOrWhiteSpace(Model.Email)) Error(nameof(Model.Email), "Enter the client's email address.");
            else if (!EmailPattern.IsMatch(Model.Email.Trim())) Error(nameof(Model.Email), "Enter a valid email address, e.g. name@example.co.za.");

            var phoneDigits = new string((Model.Phone ?? string.Empty).Where(char.IsDigit).ToArray());
            if (string.IsNullOrWhiteSpace(Model.Phone)) Error(nameof(Model.Phone), "Enter the client's mobile number.");
            else if (phoneDigits.Length < 10 || phoneDigits.Length > 15 || (Model.Phone ?? "").Any(c => !char.IsDigit(c) && " +-()".IndexOf(c) < 0))
                Error(nameof(Model.Phone), "Enter a valid mobile number, e.g. +27 82 000 0000.");

            if (string.IsNullOrWhiteSpace(Model.ResidentialAddress)) Error(nameof(Model.ResidentialAddress), "Enter the client's residential address.");
            else if (Model.ResidentialAddress.Trim().Length < 5) Error(nameof(Model.ResidentialAddress), "Enter the full address.");

            if (Model.Dependants is int dependants && (dependants < 0 || dependants > 20)) Error(nameof(Model.Dependants), "Dependants must be between 0 and 20.");

            // Documents are filed against the case, so the case has to be assigned.
            if (string.IsNullOrWhiteSpace(Model.Institution)) Error(nameof(Model.Institution), "Choose an institution so documents can be filed against the case.");
            if (string.IsNullOrWhiteSpace(Model.Product)) Error(nameof(Model.Product), "Choose a product for this case.");

            if (Model.TargetSubmissionDate is DateTime target && target.Date < DateTime.Today)
                Error(nameof(Model.TargetSubmissionDate), "The target submission date can't be in the past.");
        }
        else if (step == 2)
        {
            void NotNegative(decimal? value, string field)
            {
                if (value is decimal amount && amount < 0) Error(field, "This amount can't be negative.");
            }

            NotNegative(Model.GrossMonthlyIncome, nameof(Model.GrossMonthlyIncome));
            NotNegative(Model.NetMonthlyIncome, nameof(Model.NetMonthlyIncome));
            NotNegative(Model.MonthlyExpenses, nameof(Model.MonthlyExpenses));
            NotNegative(Model.PropertyValue, nameof(Model.PropertyValue));
            NotNegative(Model.ExistingInvestments, nameof(Model.ExistingInvestments));
            NotNegative(Model.RetirementSavings, nameof(Model.RetirementSavings));
            NotNegative(Model.OutstandingDebt, nameof(Model.OutstandingDebt));

            if (Model.GrossMonthlyIncome is decimal gross && Model.NetMonthlyIncome is decimal net && net > gross && !FieldErrors.ContainsKey(nameof(Model.NetMonthlyIncome)))
                Error(nameof(Model.NetMonthlyIncome), "Net income can't be more than gross income.");

            if (Model.InvestmentHorizonYears is int years && (years < 1 || years > 60))
                Error(nameof(Model.InvestmentHorizonYears), "Enter a horizon between 1 and 60 years.");

            if (string.IsNullOrWhiteSpace(Model.RiskProfile)) Error(nameof(Model.RiskProfile), "Choose the client's risk appetite.");
        }
        else if (step == 3)
        {
            foreach (var slot in DocumentSlots.Where(s => s.Required && !PickedFiles.ContainsKey(s.Type)))
            {
                Error(DocKey(slot.Type), $"Upload the {slot.Label.ToLowerInvariant()}. It's needed for FICA.");
            }
        }
        else if (step == 4)
        {
            if (!Model.PopiaConsent) Error(nameof(Model.PopiaConsent), "The client's POPIA consent is needed before you can create their profile.");
        }

        return !HasErrorsForStep(step);
    }

    /// <summary>
    /// Checks if any field on a step still has an error.
    /// </summary>
    private bool HasErrorsForStep(int step)
    {
        string[] stepOne = { nameof(Model.FirstName), nameof(Model.LastName), nameof(Model.IdentificationNumber), nameof(Model.DateOfBirth), nameof(Model.Email), nameof(Model.Phone), nameof(Model.ResidentialAddress), nameof(Model.Dependants), nameof(Model.Institution), nameof(Model.Product), nameof(Model.TargetSubmissionDate) };
        string[] stepTwo = { nameof(Model.GrossMonthlyIncome), nameof(Model.NetMonthlyIncome), nameof(Model.MonthlyExpenses), nameof(Model.PropertyValue), nameof(Model.ExistingInvestments), nameof(Model.RetirementSavings), nameof(Model.OutstandingDebt), nameof(Model.InvestmentHorizonYears), nameof(Model.RiskProfile) };

        return step switch
        {
            1 => stepOne.Any(FieldErrors.ContainsKey),
            2 => stepTwo.Any(FieldErrors.ContainsKey),
            3 => FieldErrors.Keys.Any(k => k.StartsWith("Doc_")),
            4 => FieldErrors.ContainsKey(nameof(Model.PopiaConsent)),
            _ => false
        };
    }

    /// <summary>
    /// SA ID numbers end with a check digit (Luhn), so this catches most typos.
    /// </summary>
    private static bool PassesLuhnCheck(string digits)
    {
        var sum = 0;
        var doubleIt = false;

        for (var i = digits.Length - 1; i >= 0; i--)
        {
            var d = digits[i] - '0';
            if (doubleIt)
            {
                d *= 2;
                if (d > 9) d -= 9;
            }
            sum += d;
            doubleIt = !doubleIt;
        }

        return sum % 10 == 0;
    }

    /// <summary>
    /// Lets the user take a picked file off before submitting.
    /// </summary>
    private void RemoveFile(DocumentType type)
    {
        PickedFiles.Remove(type);
    }

    private bool HasIdentityDetails =>
        !string.IsNullOrWhiteSpace(Model.FirstName) &&
        !string.IsNullOrWhiteSpace(Model.LastName) &&
        !string.IsNullOrWhiteSpace(Model.IdentificationNumber);

    private bool HasContactDetails =>
        !string.IsNullOrWhiteSpace(Model.Email) && !string.IsNullOrWhiteSpace(Model.Phone);

    private bool HasAddress => !string.IsNullOrWhiteSpace(Model.ResidentialAddress);

    private bool HasRiskProfile => !string.IsNullOrWhiteSpace(Model.RiskProfile);

    private bool HasRequiredDocuments =>
        DocumentSlots.Where(s => s.Required).All(s => PickedFiles.ContainsKey(s.Type));

        private const string DraftStorageKey = "nexus-new-client-draft";

    private bool ShowDraftBanner;
    private DraftPayload? PendingDraft;
    private string? DraftSavedMessage;

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.EnsureRestoredAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CheckForDraftAsync();
            StateHasChanged();
        }

        if (FocusFirstError)
        {
            FocusFirstError = false;

            try
            {
                await JS.InvokeVoidAsync("focusFirstError");
            }
            catch
            {
                // Not important if this fails, the red fields are still showing.
            }
        }
    }

    private async Task CheckForDraftAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", DraftStorageKey);

            if (!string.IsNullOrWhiteSpace(json))
            {
                var draft = JsonSerializer.Deserialize<DraftPayload>(json);

                if (draft is not null)
                {
                    PendingDraft = draft;
                    ShowDraftBanner = true;
                }
            }
        }
        catch
        {
            // Local storage may be unavailable (private browsing, blocked storage) — just skip the prompt.
        }
    }

    private void ResumeDraft()
    {
        FieldErrors.Clear();
        if (PendingDraft is null) return;

        Model.FirstName = PendingDraft.FirstName;
        Model.LastName = PendingDraft.LastName;
        Model.Email = PendingDraft.Email;
        Model.Phone = PendingDraft.Phone;
        Model.IdentificationNumber = PendingDraft.IdentificationNumber;
        Model.DateOfBirth = PendingDraft.DateOfBirth;
        Model.ResidentialAddress = PendingDraft.ResidentialAddress;
        Model.MaritalStatus = PendingDraft.MaritalStatus;
        Model.Dependants = PendingDraft.Dependants;
        Model.Institution = PendingDraft.Institution;
        Model.Product = PendingDraft.Product;
        Model.TargetSubmissionDate = PendingDraft.TargetSubmissionDate;
        Model.EmploymentStatus = PendingDraft.EmploymentStatus;
        Model.Occupation = PendingDraft.Occupation;
        Model.Employer = PendingDraft.Employer;
        Model.GrossMonthlyIncome = PendingDraft.GrossMonthlyIncome;
        Model.NetMonthlyIncome = PendingDraft.NetMonthlyIncome;
        Model.MonthlyExpenses = PendingDraft.MonthlyExpenses;
        Model.SourceOfFunds = PendingDraft.SourceOfFunds;
        Model.TaxNumber = PendingDraft.TaxNumber;
        Model.PropertyValue = PendingDraft.PropertyValue;
        Model.ExistingInvestments = PendingDraft.ExistingInvestments;
        Model.RetirementSavings = PendingDraft.RetirementSavings;
        Model.OutstandingDebt = PendingDraft.OutstandingDebt;
        Model.PrimaryGoal = PendingDraft.PrimaryGoal;
        Model.InvestmentHorizonYears = PendingDraft.InvestmentHorizonYears;
        Model.RiskProfile = PendingDraft.RiskProfile;

        CurrentStep = PendingDraft.CurrentStep is >= 1 and <= 4 ? PendingDraft.CurrentStep : 1;

        if (PendingDraft.HadDocuments)
        {
            StepError = "This draft had documents attached — please re-select them before submitting; files aren't saved in a draft.";
        }

        ShowDraftBanner = false;
        PendingDraft = null;
    }

    private async Task DiscardDraftAsync()
    {
        FieldErrors.Clear();
        ShowDraftBanner = false;
        PendingDraft = null;
        await ClearDraftStorageAsync();
    }

    private DraftPayload BuildDraftPayload() => new()
    {
        CurrentStep = CurrentStep,
        FirstName = Model.FirstName,
        LastName = Model.LastName,
        Email = Model.Email,
        Phone = Model.Phone,
        IdentificationNumber = Model.IdentificationNumber,
        DateOfBirth = Model.DateOfBirth,
        ResidentialAddress = Model.ResidentialAddress,
        MaritalStatus = Model.MaritalStatus,
        Dependants = Model.Dependants,
        Institution = Model.Institution,
        Product = Model.Product,
        TargetSubmissionDate = Model.TargetSubmissionDate,
        EmploymentStatus = Model.EmploymentStatus,
        Occupation = Model.Occupation,
        Employer = Model.Employer,
        GrossMonthlyIncome = Model.GrossMonthlyIncome,
        NetMonthlyIncome = Model.NetMonthlyIncome,
        MonthlyExpenses = Model.MonthlyExpenses,
        SourceOfFunds = Model.SourceOfFunds,
        TaxNumber = Model.TaxNumber,
        PropertyValue = Model.PropertyValue,
        ExistingInvestments = Model.ExistingInvestments,
        RetirementSavings = Model.RetirementSavings,
        OutstandingDebt = Model.OutstandingDebt,
        PrimaryGoal = Model.PrimaryGoal,
        InvestmentHorizonYears = Model.InvestmentHorizonYears,
        RiskProfile = Model.RiskProfile,
        HadDocuments = PickedFiles.Count > 0,
        SavedAt = DateTime.UtcNow
    };

    private async Task SaveDraftAsync()
    {
        try
        {
            var payload = BuildDraftPayload();
            var json = JsonSerializer.Serialize(payload);
            await JS.InvokeVoidAsync("localStorage.setItem", DraftStorageKey, json);
            DraftSavedMessage = $"Draft saved at {DateTime.Now:HH:mm} — you can safely come back to this later.";
        }
        catch
        {
            StepError = "Couldn't save a draft on this device — your browser may be blocking local storage.";
        }
    }

    private async Task ClearDraftStorageAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", DraftStorageKey);
        }
        catch
        {
            // Nothing to do — the draft will just sit there unused.
        }
    }

