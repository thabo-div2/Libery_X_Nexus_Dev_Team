@page "/new-client"


<NexusShell Title="New client"
            Subtitle="Step 1 of 4 · Details captured once populate every document">
    <div class="new-client-layout">
        <section>
            <div class="stepper card">
                <div class="step active"><span>1</span>Personal details</div>
                <div class="step"><span>2</span>Financial profile</div>
                <div class="step"><span>3</span>Documents</div>
                <div class="step"><span>4</span>Service package</div>
            </div>

            <section class="card form-card">
                <h3>Personal details</h3>
                <div class="form-grid two">
                    <div><label>First name</label><input value="Thandi" /></div>
                    <div><label>Last name</label><input value="Mokoena" /></div>
                    <div><label>ID number</label><input value="9001015800086" /></div>
                    <div><label>Date of birth</label><input value="01/01/1990" /></div>
                    <div><label>Email</label><input value="thandi@example.co.za" /></div>
                    <div><label>Mobile</label><input value="+27 82 000 0000" /></div>
                </div>
                <label>Residential address</label>
                <input value="12 Rivonia Road, Sandton" />
                <div class="form-grid two">
                    <div><label>Marital status</label><input value="Married in community of property" /></div>
                    <div><label>Dependants</label><input value="2" /></div>
                </div>
            </section>

            <section class="card form-card">
                <h3>Assign case</h3>
                <div class="form-grid two">
                    <div><label>Institution</label><input value="Liberty" /></div>
                    <div><label>Product</label><input value="Retirement Annuity" /></div>
                    <div><label>Advisor</label><input value="Rudolf Beukes" /></div>
                    <div><label>Target submission date</label><input value="20/08/2026" /></div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-secondary">Save draft</button>
                    <button class="btn btn-primary">Continue to financial profile</button>
                </div>
            </section>
        </section>

        <aside class="right-stack">
            <section class="card">
                <h3>Required to submit</h3>
                <div class="check-list">
                    <div class="done">✓ Identity details</div>
                    <div class="done">✓ Contact details</div>
                    <div>○ Address</div>
                    <div>○ FICA documents</div>
                    <div>○ Risk profile</div>
                </div>
            </section>

            <section class="card">
                <h3>Quick upload</h3>
                <div class="upload-box">
                    <div class="upload-icon">⇧</div>
                    <strong>Drop FICA documents</strong>
                    <span>PDF, JPG or PNG up to 10 MB</span>
                </div>
            </section>
        </aside>
    </div>
</NexusShell>
