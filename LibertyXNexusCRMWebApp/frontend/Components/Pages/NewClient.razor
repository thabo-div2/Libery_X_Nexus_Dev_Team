    private async Task OnFileSelected(InputFileChangeEventArgs e, DocumentType type)
    {
        var key = DocKey(type);
        ClearFieldError(key);

        var file = e.File;
        var extension = Path.GetExtension(file.Name).ToLowerInvariant();

        if (!AllowedFileTypes.Contains(extension))
        {
            FieldErrors[key] = $"'{file.Name}' isn't a PDF, JPG or PNG file.";
            return;
        }

        if (file.Size == 0)
        {
            FieldErrors[key] = $"'{file.Name}' is empty. Choose another file.";
            return;
        }

        if (file.Size > MaxFileSize)
        {
            FieldErrors[key] = $"'{file.Name}' is {file.Size / 1_000_000.0:0.#}MB. The limit is 30MB.";
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(MaxFileSize);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);

            PickedFiles[type] = new PickedFile(
                file.Name,
                string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
                memory.ToArray());
        }
        catch (Exception)
        {
            FieldErrors[key] = $"'{file.Name}' couldn't be read. Try choosing it again.";
        }
    }

    private void TryJumpToStep(int step)
    {
        // Only allow jumping backwards freely; forward jumps go through GoToStep's validation.
        if (step <= CurrentStep)
        {
            CurrentStep = step;
            StepError = null;
        }
    }

        private async Task GoToStep(int step)
    {
        StepError = null;
        DraftSavedMessage = null;

        if (step > CurrentStep)
        {
            // Check every step between here and where we're going.
            for (var s = CurrentStep; s < step; s++)
            {
                if (!ValidateStep(s))
                {
                    CurrentStep = s;
                    FocusFirstError = true;
                    return;
                }
            }
        }

        CurrentStep = step;

        // Auto-save progress on every step change so a closed tab or crash doesn't lose the form.
        await SaveDraftAsync();
        DraftSavedMessage = null;
    }

    private async Task SubmitAsync()
    {
        SubmitError = null;

        // Check every step again in case something was changed.
        for (var s = 1; s <= 4; s++)
        {
            if (!ValidateStep(s))
            {
                CurrentStep = s;
                FocusFirstError = true;
                return;
            }
        }

        IsSubmitting = true;
        PartialProblems.Clear();

        try
        {
            // 1. Create the client (skipped if it was already created on an earlier try).
            if (CreatedClientId is null)
            {
                var request = new CreateClientRequest
                {
                    FirstName = Model.FirstName.Trim(),
                    LastName = Model.LastName.Trim(),
                    Email = Model.Email.Trim(),
                    Phone = Model.Phone?.Trim(),
                    IdentificationNumber = Model.IdentificationNumber?.Replace(" ", ""),
                    DateOfBirth = Model.DateOfBirth,
                    ResidentialAddress = Model.ResidentialAddress?.Trim(),
                    MaritalStatus = Model.MaritalStatus,
                    Dependants = Model.Dependants,
                    EmploymentStatus = Model.EmploymentStatus,
                    Occupation = Model.Occupation,
                    Employer = Model.Employer,
                    GrossMonthlyIncome = Model.GrossMonthlyIncome,
                    NetMonthlyIncome = Model.NetMonthlyIncome,
                    MonthlyExpenses = Model.MonthlyExpenses,
                    SourceOfFunds = Model.SourceOfFunds,
                    TaxNumber = Model.TaxNumber,
                    PropertyValue = Model.PropertyValue,
                    ExistingInvestments = Model.ExistingInvestments,
                    RetirementSavings = Model.RetirementSavings,
                    OutstandingDebt = Model.OutstandingDebt,
                    PrimaryGoal = Model.PrimaryGoal,
                    InvestmentHorizonYears = Model.InvestmentHorizonYears,
                    RiskProfile = Model.RiskProfile,
                    PopiaConsent = Model.PopiaConsent
                };

                var (client, clientError) = await Clients.CreateAsync(request);

                if (client is null)
                {
                    var error = clientError ?? string.Empty;

                    // The email is already used: send the user straight to that field.
                    if (error.Contains("already exists", StringComparison.OrdinalIgnoreCase))
                    {
                        FieldErrors[nameof(Model.Email)] = "A client with this email already exists.";
                        CurrentStep = 1;
                        FocusFirstError = true;
                        return;
                    }

                    SubmitError = string.IsNullOrWhiteSpace(error) ? "The server didn't respond as expected." : error;
                    return;
                }

                CreatedClientId = client.ClientId;
            }

            // 2. Assign the case.
            if (CreatedPolicyId is null && !string.IsNullOrWhiteSpace(Model.Institution) && !string.IsNullOrWhiteSpace(Model.Product))
            {
                var policyRequest = new CreateClientPolicyRequest(
                    PolicyName: Model.Product!,
                    Provider: Model.Institution!,
                    Description: null,
                    PremiumAmount: null,
                    CoverAmount: null,
                    StartDate: null,
                    EndDate: null,
                    TargetSubmissionDate: Model.TargetSubmissionDate);

                var (policy, policyError) = await Policies.CreateClientPolicyAsync(CreatedClientId.Value, policyRequest);

                if (policy is not null)
                {
                    CreatedPolicyId = policy.PolicyId;
                }
                else
                {
                    PartialProblems.Add($"The {Model.Product} case with {Model.Institution} couldn't be assigned ({policyError ?? "no reason given"}).");
                }
            }

            // 3. Upload the documents (only the ones that haven't gone through yet).
            if (CreatedPolicyId is not null)
            {
                var uploaderName = $"{CurrentUser.FirstName} {CurrentUser.LastName}".Trim();
                if (string.IsNullOrWhiteSpace(uploaderName))
                {
                    uploaderName = CurrentUser.Email ?? "Advisor";
                }

                foreach (var (type, file) in PickedFiles.Where(f => !UploadedDocs.Contains(f.Key)).ToList())
                {
                    var (document, uploadError) = await Documents.UploadAsync(CreatedClientId.Value, CreatedPolicyId.Value, type, uploaderName, file.Name, file.ContentType, file.Content);

                    if (document is not null)
                    {
                        UploadedDocs.Add(type);
                    }
                    else
                    {
                        PartialProblems.Add($"'{file.Name}' couldn't be uploaded ({uploadError ?? "no reason given"}).");
                    }
                }
            }
            else if (PickedFiles.Count > 0)
            {
                PartialProblems.Add("The documents weren't uploaded because the case couldn't be assigned.");
            }

            // The client exists now, so the draft isn't needed any more.
            await ClearDraftStorageAsync();

            if (PartialProblems.Count == 0)
            {
                Nav.NavigateTo("/clients");
            }
        }
        catch (Exception)
        {
            SubmitError = CreatedClientId is null
                ? "Something unexpected went wrong while saving."
                : "The client was saved, but something unexpected went wrong afterwards.";
        }
        finally
        {
            // Never leave the button stuck on "Creating client…".
            IsSubmitting = false;
        }
    }

