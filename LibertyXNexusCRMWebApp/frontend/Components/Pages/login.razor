@page "/"
@layout EmptyLayout

<PageTitle>Login | Nexus</PageTitle>

<div class="login-page">

    <!-- LEFT SIDE -->
    <section class="brand-panel">

        <div class="brand-logo">
            <div class="brand-mark">N</div>
            <span class="brand-name">Nexus</span>
        </div>

        <div class="brand-content">
            <h1>
                One place for your<br />
                policies, paperwork and<br />
                adviser.
            </h1>

            <p class="brand-description">
                Track every case from intake to issue, sign documents digitally,
                and get answers the moment you need them.
            </p>

            <div class="benefits">

                <div class="benefit-item">
                    <span class="benefit-icon">⌾</span>
                    <span>Live case status across Liberty &amp; Standard Bank</span>
                </div>

                <div class="benefit-item">
                    <span class="benefit-icon">⌾</span>
                    <span>Prepopulated, e-signable documents</span>
                </div>

                <div class="benefit-item">
                    <span class="benefit-icon">⌾</span>
                    <span>AI assistant with adviser handoff</span>
                </div>

            </div>
        </div>

        <div class="brand-footer">
            FSCA compliant · POPIA aligned · Audit logged
        </div>

    </section>


    <!-- RIGHT SIDE -->
    <section class="form-panel">

        <div class="login-form">

            <div class="login-heading">
                <h2>Welcome back</h2>
                <p>Sign in to your Nexus account.</p>
            </div>

            <form>
                <!-- Add functionality-->
                <div class="form-group">
                    <label for="email">Email address</label>

                    <input id="email"
                           type="email"
                           value="you@example.co.za"
                           autocomplete="email" />
                </div>

                <!-- Add functionality-->
                <div class="form-group">
                    <label for="password">Password</label>

                    <input id="password"
                           type="password"
                           value="password"
                           autocomplete="current-password" />
                </div>


                <div class="form-options">

                    <label class="remember-me">
                        <input type="checkbox" />
                        <span>Keep me signed in</span>
                    </label>

                    <a href="#" class="forgot-password">
                        Forgot password?
                    </a>

                </div>

                <!-- takes you to advisor dashboard-->
                <a href="/advisor" class="sign-in-button">
                    <span>Sign in</span>
                    <span class="button-arrow">→</span>
                </a>



                @* <button type="submit" class="sign-in-button">
                    <span>Sign in</span>
                    <span class="button-arrow">→</span>
                </button> *@

                <!--takes you to client dashboard-->
                <a href="/client" class="client-button">
                    Continue as client
                </a>


                <div class="register-text">
                    <span>New here?</span>
                    <a href="/register">Create an account</a>
                </div>

            </form>

        </div>

    </section>

</div>