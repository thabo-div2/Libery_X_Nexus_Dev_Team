@page "/"
@layout EmptyLayout
@rendermode InteractiveServer
@using frontend.Services
@using Microsoft.AspNetCore.Components
@inject AuthService Auth
@inject CurrentUserService CurrentUser
@inject NavigationManager Navigation

<PageTitle>Login | Nexus</PageTitle>

<ErrorBoundary>
<ChildContent>
<div class="login-page">

    <!-- LEFT SIDE -->
    <section class="login-brand-panel">

        <div class="brand-logo">
            <div class="brand-icon">N</div>
            <span>NEXUS</span>
        </div>

        <div class="brand-content">
            <h1>
                One place for your<br />
                policies, paperwork and<br />
                adviser.
            </h1>

            <p class="brand-description">
                Track every case from intake to issue, sign documents digitally,
                and get answers the moment you need them.
            </p>

            <div class="brand-features">

                <div class="feature-item">
                    <span class="feature-icon">▢</span>
                    <span>Live case status across Liberty &amp; Standard Bank</span>
                </div>

                <div class="feature-item">
                    <span class="feature-icon">▣</span>
                    <span>Pre-populated, e-signable documents</span>
                </div>

                <div class="feature-item">
                    <span class="feature-icon">◇</span>
                    <span>AI assistant with adviser handoff</span>
                </div>

            </div>
        </div>

        <div class="brand-footer">
            FSP-compliant · POPIA-aligned · Audit logged
        </div>

    </section>


    <!-- RIGHT SIDE -->
    <section class="login-form-panel">

        <div class="login-card">

            <div class="login-heading">
                <h2>Welcome back</h2>
                <p>Sign in to your Nexus account.</p>
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <p class="login-error">@ErrorMessage</p>
            }

            <div class="form-group">
                <label for="email">Email address</label>

                <input id="email"
                       type="email"
                       placeholder="you@example.co.za"
                       autocomplete="email"
                       @bind="Email" />
            </div>

            <div class="form-group">
                <label for="password">Password</label>

                <input id="password"
                       type="password"
                       placeholder="••••••••"
                       autocomplete="current-password"
                       @bind="Password" />
            </div>

            <div class="form-options">

                <label class="remember-me">
                    <input type="checkbox" />
                    <span>Keep me signed in</span>
                </label>

                <button type="button" class="forgot-password">
                    Forgot password?
                </button>

            </div>

            <button type="button" class="sign-in-button" @onclick="HandleLogin">
                <span>Sign in</span>
                <span class="arrow">→</span>
            </button>

            <a href="/client" class="client-button">
                Continue as client
            </a>

            <div class="register-section">
                <span>New here?</span>
                <a href="/register">Create an account</a>
            </div>

        </div>

    </section>

</div>
</ChildContent>
<ErrorContent>
    <div class="login-page">
        <p class="login-error">Something went wrong loading this page. Please refresh and try again.</p>
    </div>
</ErrorContent>
</ErrorBoundary>

@code {
    private string Email = string.Empty;
    private string Password = string.Empty;
    private string? ErrorMessage;

    private async Task HandleLogin()
    {
        var result = await Auth.LoginAsync(Email, Password);
        if (!result.Success)
        {
            ErrorMessage = result.Message;
            return;
        }

        await CurrentUser.SignInAsync(result);
        Navigation.NavigateTo(result.Role == "FinancialAdviser" ? "/advisor" : "/client");
    }
}
