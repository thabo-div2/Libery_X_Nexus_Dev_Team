@page "/advisor"
@layout MainLayout
@rendermode InteractiveServer
@using Shared.DTOs.Advisor
@using frontend.Services
@using Microsoft.AspNetCore.Components.Web
@inject InvitationService Invite
@inject AdvisorService Advisors
@inject InsightsService InsightsApi
@inject IJSRuntime JS
@using Microsoft.JSInterop
@implements IAsyncDisposable

<PageTitle>Advisor Dashboard | Nexus</PageTitle>

<ErrorBoundary>
    <ChildContent>
        <div class="advisor-page">

            <!-- HEADER -->
            <header class="advisor-header">

                <div class="header-greeting">
                    <span class="header-eyebrow">@DateTime.Today.ToString("dddd, d MMMM")</span>
                    <h1>
                        <text>@Greeting</text>
                        @if (!string.IsNullOrWhiteSpace(AdvisorFirstName))
                        {
                            <text>, <em class="greeting-name">@AdvisorFirstName</em></text>
                        }
                    </h1>

                    <p>
                        @if (Dashboard?.ActiveCases is not null || Dashboard?.WaitingOnClient is not null)
                        {
                            <span>
                                @(Dashboard?.ActiveCases ?? 0) active cases ·
                                @(Dashboard?.WaitingOnClient ?? 0) waiting on client action
                            </span>
                        }
                        else
                        {
                            <span>Your case overview and upcoming work</span>
                        }
                    </p>
                </div>

                <div class="header-actions">

                    <div class="search-box" role="search">
                        <span class="search-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></span>

                        <input aria-label="Search clients, cases, documents" type="text"
                               @bind="SearchText"
                               @bind:event="oninput"
                               @onkeydown="HandleSearchKeyDown"
                               placeholder="Search clients, cases, documents" />
                    </div>

                    <NotificationBell />

                    <button type="button"
                            class="new-client-button secondary"
                            aria-expanded="@(ShowInvitePanel ? "true" : "false")"
                            aria-controls="invite-panel"
                            @ref="InviteToggleButton"
                            @onclick="ToggleInvitePanel">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                        Invite client
                    </button>

                    <a href="/new-client" class="new-client-button new-client-primary">
                        New client
                        <span class="new-client-plus" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M12 5.5v13M5.5 12h13"/></svg>
                        </span>
                    </a>

                </div>

            </header>

            @if (ShowInvitePanel)
            {
                <section id="invite-panel" class="invite-panel" aria-label="Invite a client" @onkeydown="HandleInvitePanelKeyDown">
                    <div class="invite-panel-card">
                        <h3>Invite a client</h3>
                        <p>Enter your client's email address and Nexus will send them a registration link.</p>

                        <EditForm Model="InviteModel" OnValidSubmit="GenerateInviteLink" novalidate>
                        <DataAnnotationsValidator />

                        <div class="invite-panel-row">
                            <div class="invite-email-field">
                                <label for="invite-email" class="visually-hidden">Client email address</label>
                                <InputText id="invite-email"
                                           type="email"
                                           autocomplete="off"
                                           @bind-Value="InviteModel.Email"
                                           placeholder="client@example.co.za" />

                                <ValidationMessage For="() => InviteModel.Email" />
                            </div>

                            <button type="submit" class="new-client-button" disabled="@IsSendingInvite">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                                @(IsSendingInvite ? "Sending..." : "Send invitation")
                            </button>
                        </div>
                        </EditForm>

                        @if (!string.IsNullOrEmpty(InviteLink))
                        {
                            <input class="invite-link-output" readonly value="@InviteLink" onfocus="this.select()" />
                        }

                        @if (!string.IsNullOrEmpty(InviteMessage))
                        {
                            <p class="invite-success">@InviteMessage</p>
                        }

                        @if (!string.IsNullOrEmpty(InviteError))
                        {
                            <p class="invite-error" role="alert">@InviteError</p>
                        }
                    </div>
                </section>
            }


            <!-- DASHBOARD CONTENT -->
            <main class="advisor-content">

                <!-- DASHBOARD: two columns that each stack their own panels -->
                <section class="dashboard-grid">

                    <!-- LEFT: what needs doing, then the pipeline. Stacked so a short list never leaves a gap. -->
                    <div class="left-column">

                    <AttentionList />

                    <!-- CASE PIPELINE -->
                    <article class="dashboard-card pipeline-card">

                        <div class="card-header">

                            <div class="card-heading">
                                <h2>Case pipeline</h2>
                                <span class="card-sub">Applications by institution, most recently updated first</span>
                            </div>

                            @{
                                var institutionTabs = PipelineInstitutions.ToList();
                                var selectedTab = Math.Max(0, institutionTabs.IndexOf(SelectedInstitution));
                            }
                            <div class="pipeline-filters" @ref="PipelineFilters" role="group" aria-label="Filter cases by institution"
                                 style="--n:@institutionTabs.Count;--i:@selectedTab">
                                <span class="seg-thumb" aria-hidden="true"></span>
                                @foreach (var institution in institutionTabs)
                                {
                                    <button type="button" class="filter-pill @(SelectedInstitution == institution ? "active" : "")"
                                            aria-pressed="@(SelectedInstitution == institution)"
                                            @onclick="() => SetInstitutionFilter(institution)">
                                        <span class="filter-label">@institution</span>
                                        <span class="filter-count">@CaseCount(institution)</span>
                                    </button>
                                }
                            </div>

                        </div>


                        <div class="table-container">
                            <table class="pipeline-table">
                                <caption class="visually-hidden">Client cases and their current application status</caption>
                                <thead><tr><th scope="col">Client / product</th><th scope="col">Institution</th><th scope="col">Stage</th><th scope="col" class="updated-heading">Updated</th></tr></thead>
                                <tbody @key="SelectedInstitution">
                                    @if (isLoading)
                                    {
                                        @* Placeholder rows shaped like the table while it loads. *@
                                        @for (var row = 0; row < 4; row++)
                                        {
                                            <tr class="pipeline-skeleton" aria-hidden="true">
                                                <td><span class="nx-skeleton" style="width:70%"></span></td>
                                                <td><span class="nx-skeleton" style="width:60%"></span></td>
                                                <td><span class="nx-skeleton" style="width:50%"></span></td>
                                                <td><span class="nx-skeleton" style="width:60%"></span></td>
                                            </tr>
                                        }
                                    }
                                    else if (!string.IsNullOrWhiteSpace(LoadError) || !FilteredCases.Any())
                                    {
                                        <tr>
                                            <td colspan="4" class="pipeline-empty" role="status">
                                                @if (!string.IsNullOrWhiteSpace(LoadError))
                                                {
                                                    @LoadError
                                                }
                                                else if ((Dashboard?.Cases?.Count ?? 0) == 0)
                                                {
                                                    <span>No cases yet. A case starts when you add a policy to a client.</span>
                                                    <a href="/new-client" class="pipeline-empty-action">Add a client</a>
                                                }
                                                else
                                                {
                                                    <span>No cases with @SelectedInstitution yet.</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var caseItem in FilteredCases)
                                        {
                                            <tr>
                                                <td><div class="pipeline-client"><span class="pipeline-avatar" aria-hidden="true">@GetInitials(caseItem.ClientName)</span><div><strong>@caseItem.ClientName</strong><span class="pipeline-product">@caseItem.Product</span></div></div></td>
                                                <td><span class="pipeline-provider"><span class="inst-chip inst-c@(InstitutionSlot(caseItem.Institution))" aria-hidden="true">@InstitutionCode(caseItem.Institution)</span>@caseItem.Institution</span></td>
                                                <td><span class="status-badge @GetStatusClass(caseItem.Status)"><span class="status-dot" aria-hidden="true"></span>@FormatStatus(caseItem.Status)</span></td>
                                                <td class="updated-cell">@caseItem.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="pipeline-footer">
                            <span class="pipeline-footer-count">Showing @FilteredCases.Count() of @(Dashboard?.Cases?.Count ?? 0) cases</span>
                            <a href="/clients" class="pipeline-footer-link">
                                View all cases
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                            </a>
                        </div>


                    </article>
                    </div>


                    <!-- RIGHT COLUMN -->
                    <aside class="right-column">
                        <section class="month-panel" aria-labelledby="month-title" aria-busy="@(isLoading ? "true" : "false")">
                            <div class="month-head">
                                <div>
                                    <span class="month-eyebrow">@DateTime.Today.ToString("MMMM yyyy")</span>
                                    <h2 id="month-title">This month</h2>
                                </div>
                                <a href="/clients">All clients <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
                            </div>

                            <div class="month-metrics">
                                <div class="month-metric">
                                    <span class="month-icon icon-blue" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3.5" y="7.5" width="17" height="12" rx="3" /><path d="M9 7.5V6a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v1.5M3.5 12.5h17" /></svg></span>
                                    <span class="month-label">Active cases</span>
                                    @if (isLoading) { <span class="nx-skeleton month-skeleton"></span> }
                                    else { <strong class="month-value">@(Dashboard?.ActiveCases ?? 0)</strong> }
                                    <span class="month-change @GetChangeClass(Dashboard?.ActiveCasesChange)">@Dashboard?.ActiveCasesChange</span>
                                </div>

                                <div class="month-metric">
                                    <span class="month-icon icon-orange" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 17l5-5 4 4 7-8" /><path d="M14 8h6v6" /></svg></span>
                                    <span class="month-label">Pipeline value</span>
                                    @if (isLoading) { <span class="nx-skeleton month-skeleton"></span> }
                                    else { <strong class="month-value">@FormatRand(Dashboard?.PipelineValue)</strong> }
                                    <span class="month-change @GetChangeClass(Dashboard?.PipelineValueChange)">@Dashboard?.PipelineValueChange</span>
                                </div>

                                <div class="month-metric">
                                    <span class="month-icon icon-green" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="15.5" rx="3" /><path d="M3.5 10h17M8 3v4M16 3v4" /></svg></span>
                                    <span class="month-label">Meetings this week</span>
                                    @if (isLoading) { <span class="nx-skeleton month-skeleton"></span> }
                                    else { <strong class="month-value">@(Dashboard?.MeetingsThisWeek ?? 0)</strong> }
                                    <span class="month-change @GetChangeClass(Dashboard?.MeetingsChange)">@Dashboard?.MeetingsChange</span>
                                </div>

                                <div class="month-metric month-metric-ring">
                                    <span class="month-label">Fully onboarded</span>
                                    @if (Insights is null) { <span class="nx-skeleton month-skeleton"></span> }
                                    else
                                    {
                                        <strong class="month-value">@Insights.ClientsOnboarded<span class="month-of"> of @Insights.ClientsTotal</span></strong>
                                        <span class="month-change">active clients</span>
                                        @* Progress ring: the circle's length is 100, so the dash length is the percentage. *@
                                        <span class="month-ring" role="img" aria-label="@OnboardedPercent percent of active clients fully onboarded">
                                            <svg viewBox="0 0 36 36" aria-hidden="true">
                                                <circle class="ring-track" cx="18" cy="18" r="15.9155" />
                                                @if (OnboardedPercent > 0)
                                                {
                                                    @* Skipped at 0%: a round line cap would still draw a dot. *@
                                                    <circle class="ring-fill" cx="18" cy="18" r="15.9155" stroke-dasharray="@OnboardedPercent 100" />
                                                }
                                            </svg>
                                            <b>@OnboardedPercent%</b>
                                        </span>
                                    }
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(LoadError))
                            {
                                <p class="month-error" role="alert">@LoadError</p>
                            }
                        </section>

                        <RenewalsCard />

                        <!-- CASES BY INSTITUTION -->
                        <article class="dashboard-card institutions-card">

                            <div class="card-header">
                                <h2>Cases by institution</h2>
                                @if (Dashboard?.Institutions is not null && Dashboard.Institutions.Any())
                                {
                                    <span class="card-count">@Dashboard.Institutions.Sum(i => i.CaseCount) total</span>
                                }
                            </div>

                            <div class="institution-list">

                                @if (Dashboard?.Institutions is not null && Dashboard.Institutions.Any())
                                {
                                    var institutionRows = Dashboard.Institutions.ToList();
                                    var institutionSummary = string.Join(", ", institutionRows.Select(i => i.Name + " " + i.CaseCount));

                                    <div class="institution-bar" role="img" aria-label="Cases by institution: @institutionSummary">
                                        @for (var i = 0; i < institutionRows.Count; i++)
                                        {
                                            <div class="institution-segment inst-c@(i % 4)" style="flex: @Math.Max(institutionRows[i].CaseCount, 1) 1 0"></div>
                                        }
                                    </div>

                                    <ul class="institution-legend">
                                        @for (var i = 0; i < institutionRows.Count; i++)
                                        {
                                            <li>
                                                <span class="legend-name"><span class="legend-swatch inst-c@(i % 4)" aria-hidden="true"></span>@institutionRows[i].Name</span>
                                                <span class="legend-count">@institutionRows[i].CaseCount @(institutionRows[i].CaseCount == 1 ? "case" : "cases")</span>
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <div class="empty-note is-info">
                                        <span class="empty-note-icon" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="7.5" width="17" height="12" rx="3"/><path d="M9 7.5V6a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v1.5M3.5 12.5h17"/></svg>
                                        </span>
                                        <div class="empty-note-text">
                                            <strong>No institution data yet</strong>
                                            <span>Cases appear here once they are opened.</span>
                                        </div>
                                    </div>
                                }

                            </div>

                        </article>


                        <!-- AI ASSISTANT -->
                        <a href="/chatbot" class="assistant-card">

                            <div class="assistant-text">
                                <span class="assistant-eyebrow">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 3.5c.6 3.8 2.2 5.4 6 6-3.8.6-5.4 2.2-6 6-.6-3.8-2.2-5.4-6-6 3.8-.6 5.4-2.2 6-6z"/></svg>
                                    Nexus assistant
                                </span>

                                <strong>Ask the Nexus assistant</strong>

                                <span class="assistant-sub">
                                    Draft a service package or summarise a case
                                </span>
                            </div>

                            <span class="assistant-arrow" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M9 7h8v8"/></svg>
                            </span>
                        </a>

                    </aside>

                </section>

            </main>

        </div>
    </ChildContent>
    <ErrorContent>
        <div class="advisor-page">
            <p class="dashboard-error">Something went wrong loading this page. Please refresh and try again.</p>
        </div>
    </ErrorContent>
</ErrorBoundary>


<RealtimeRefresh OnChanged="OnInitializedAsync" />

@code {

    // Drag support for the institution switch (see wwwroot/js/segmented-drag.js).
    private ElementReference PipelineFilters;
    private IJSObjectReference? DragModule;
    private IDisposable? SelfRef;
    private bool DragBound;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (DragBound || PipelineFilters.Context is null) return;
        DragBound = true;
        try
        {
            DragModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/segmented-drag.js");
            var selfRef = DotNetObjectReference.Create(this);
            SelfRef = selfRef;
            await DragModule.InvokeVoidAsync("init", PipelineFilters, selfRef);
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
    }

    [JSInvokable]
    public async Task SetInstitutionByIndex(int index)
    {
        var tabs = PipelineInstitutions.ToList();
        if (index < 0 || index >= tabs.Count) return;
        SelectedInstitution = tabs[index];
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        SelfRef?.Dispose();
        if (DragModule is not null) try { await DragModule.DisposeAsync(); } catch (JSDisconnectedException) { } catch (TaskCanceledException) { }
    }
    private AdvisorDashboardDto? Dashboard;

    private string? AdvisorFirstName;

    private string SearchText { get; set; } = string.Empty;

    private bool isLoading = true;
    private string? LoadError;


    private bool ShowInvitePanel;
    /// <summary>
    /// The invite box. Its rules (email required and valid) live on InviteClientForm.
    /// </summary>
    private InviteClientForm InviteModel = new();
    private bool IsSendingInvite;
    private string? InviteLink;
    private string? InviteError;
    private string? InviteMessage;
    private string SelectedInstitution = "All";

    private static string GetChangeClass(string? change)
{
    if (string.IsNullOrWhiteSpace(change))
    {
        return string.Empty;
    }

    var trimmed = change.TrimStart();

    if (trimmed.StartsWith("-"))
    {
        return "negative";
    }

    if (trimmed.StartsWith("+"))
    {
        return "positive";
    }

    return string.Empty;
}

    private void SetInstitutionFilter(string institution)
    {
        SelectedInstitution = institution;
    }

    private void ToggleInvitePanel()
    {
        ShowInvitePanel = !ShowInvitePanel;
        InviteLink = null;
        InviteError = null;
        InviteMessage = null;
    }

    /// <summary>
    /// The Invite client button, so focus can go back to it when the panel closes.
    /// </summary>
    private ElementReference InviteToggleButton;

    /// <summary>
    /// Escape inside the invite panel closes it and puts focus back on the Invite client button,
    /// so keyboard users aren't left stranded when it disappears.
    /// </summary>
    private async Task HandleInvitePanelKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && ShowInvitePanel)
        {
            ToggleInvitePanel();
            // The element can be missing if the page changed in the meantime; closing still worked.
            try { await InviteToggleButton.FocusAsync(); } catch (Exception) { }
        }
    }

    /// <summary>
    /// Runs only when the email passes its rules (EditForm OnValidSubmit).
    /// </summary>
    private async Task GenerateInviteLink()
    {
        InviteError = null;
        InviteMessage = null;
        InviteLink = null;

        IsSendingInvite = true;
        var result = await Invite.CreateAsync(InviteModel.Email.Trim());
        IsSendingInvite = false;

        if (!result.Success || result.Token is null)
        {
            InviteError = result.Message;
            return;
        }

        InviteLink = Invite.BuildLink(result.Token);
        InviteMessage = result.Message;
    }

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(SearchText))
        {
            Navigation.NavigateTo($"/clients?search={Uri.EscapeDataString(SearchText.Trim())}");
        }
    }

    /// <summary>
    /// Load the logged-in advisor's dashboard information from the API.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        LoadError = null;

        var dashboardTask = Advisors.GetDashboardAsync();
        var insightsTask = InsightsApi.GetDashboardAsync();
        await Task.WhenAll(dashboardTask, insightsTask);

        var (dashboard, error) = dashboardTask.Result;
        Dashboard = dashboard;
        AdvisorFirstName = dashboard?.AdvisorFirstName;
        LoadError = error;
        Insights = insightsTask.Result.Value;

        isLoading = false;
    }




    private IEnumerable<CasePipelineItemDto> FilteredCases =>
        (Dashboard?.Cases ?? new()).Where(c => SelectedInstitution == "All" || c.Institution == SelectedInstitution);

    // Short code for the institution tile, e.g. "Standard Bank" -> "SB", "Liberty" -> "LI".
    private static string InstitutionCode(string? name)
    {
        var words = (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (words.Length == 0) return "?";
        return words.Length == 1
            ? words[0][..Math.Min(2, words[0].Length)].ToUpperInvariant()
            : string.Concat(words.Take(2).Select(w => char.ToUpperInvariant(w[0])));
    }

    // Stable colour slot (0-3) per institution so the same bank always gets the same tile colour.
    private int InstitutionSlot(string? name)
    {
        var names = (Dashboard?.Cases ?? new()).Select(c => c.Institution).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x).ToList();
        var index = names.IndexOf(name ?? "");
        return index < 0 ? 0 : index % 4;
    }

    // Number of cases behind each filter tab, shown as a small count badge.
    private int CaseCount(string institution) =>
        (Dashboard?.Cases ?? new()).Count(c => institution == "All" || c.Institution == institution);

    private IEnumerable<string> PipelineInstitutions => new[] { "All" }.Concat(
        (Dashboard?.Cases ?? new()).Select(c => c.Institution).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x));

    private static string FormatStatus(string status) => status switch
    {
        "InProgress" => "In progress",
        "AwaitingApproval" => "Awaiting approval",
        "OnHold" => "On hold",
        "Completed" => "Completed",
        _ => status
    };

    private static string GetInitials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));

    private static string GetStatusClass(string? status) => status switch
    {
        "InProgress" => "status-blue",
        "AwaitingApproval" => "status-yellow",
        "OnHold" => "status-red",
        "Completed" => "status-green",
        "Cancelled" or "Lapsed" => "status-red",
        "Matured" => "status-neutral",
        _ => "status-neutral"
    };

    // "This month" panel: onboarding comes from the insights endpoint, the rest from the dashboard call.
    private Shared.DTOs.Insights.PracticeInsightsDto? Insights;

    private int OnboardedPercent => Insights is null || Insights.ClientsTotal == 0
        ? 0
        : (int)Math.Round(100.0 * Insights.ClientsOnboarded / Insights.ClientsTotal);

    /// <summary>
    /// Rand amounts in short form so they fit the panel: R 1.42m, R 845k, R 12 300.
    /// </summary>
    private static string FormatRand(double? value)
    {
        if (value is not double amount) return "—";
        return amount switch
        {
            >= 1_000_000 => $"R {amount / 1_000_000:0.##}m",
            >= 100_000 => $"R {amount / 1_000:0}k",
            _ => "R " + amount.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("en-ZA"))
        };
    }

    // Matches the time of day in South Africa, where advisors work.
    private static string Greeting => DateTime.Now.Hour switch
    {
        < 12 => "Good morning",
        < 17 => "Good afternoon",
        _ => "Good evening"
    };


    public class CasePipelineItem
    {
        public string ClientName { get; set; } = string.Empty;
