@page "/advisor"
@layout MainLayout

<PageTitle>Advisor Dashboard | Nexus</PageTitle>

<div class="advisor-page">

    <!-- HEADER -->
    <header class="advisor-header">

        <div class="header-greeting">
            <h1>
                Good afternoon@(string.IsNullOrWhiteSpace(AdvisorFirstName)
                    ? "!"
                    : $", {AdvisorFirstName}!")
            </h1>

            <p>
                @if (ActiveCases.HasValue || WaitingOnClient.HasValue)
                {
                    <span>
                        @(ActiveCases?.ToString() ?? "—") active cases ·
                        @(WaitingOnClient?.ToString() ?? "—") waiting on client action
                    </span>
                }
                else
                {
                    <span>Your case overview and upcoming work</span>
                }
            </p>
        </div>

        <div class="header-actions">

            <div class="search-box">
                <span class="search-icon">⌕</span>

                <input type="text"
                       @bind="SearchText"
                       placeholder="Search clients, cases, documents" />
            </div>

            <button type="button"
                    class="notification-button"
                    aria-label="Notifications">
                <span>♧</span>
            </button>

            <a href="/new-client" class="new-client-button">
                <span class="plus-icon">+</span>
                New client
            </a>

        </div>

    </header>


    <!-- DASHBOARD CONTENT -->
    <main class="advisor-content">

        <!-- STAT CARDS -->
        <section class="stats-grid">

            <article class="stat-card">
                <span class="stat-label">ACTIVE CASES</span>

                <strong class="stat-value">
                    @(ActiveCases?.ToString() ?? "—")
                </strong>

                <span class="stat-change">
                    @if (!string.IsNullOrWhiteSpace(ActiveCasesChange))
                    {
                        @ActiveCasesChange
                    }
                    else
                    {
                        <span>Data not loaded</span>
                    }
                </span>
            </article>


            <article class="stat-card">
                <span class="stat-label">AWAITING DOCUMENTS</span>

                <strong class="stat-value">
                    @(AwaitingDocuments?.ToString() ?? "—")
                </strong>

                <span class="stat-change">
                    @if (!string.IsNullOrWhiteSpace(AwaitingDocumentsChange))
                    {
                        @AwaitingDocumentsChange
                    }
                    else
                    {
                        <span>Data not loaded</span>
                    }
                </span>
            </article>


            <article class="stat-card">
                <span class="stat-label">MEETINGS THIS WEEK</span>

                <strong class="stat-value">
                    @(MeetingsThisWeek?.ToString() ?? "—")
                </strong>

                <span class="stat-change">
                    @if (!string.IsNullOrWhiteSpace(MeetingsChange))
                    {
                        @MeetingsChange
                    }
                    else
                    {
                        <span>Data not loaded</span>
                    }
                </span>
            </article>


            <article class="stat-card">
                <span class="stat-label">VALUE IN PIPELINE</span>

                <strong class="stat-value">
                    @(PipelineValue.HasValue
                        ? $"R {PipelineValue.Value:N0}"
                        : "—")
                </strong>

                <span class="stat-change">
                    @if (!string.IsNullOrWhiteSpace(PipelineValueChange))
                    {
                        @PipelineValueChange
                    }
                    else
                    {
                        <span>Data not loaded</span>
                    }
                </span>
            </article>

        </section>


        <!-- LOWER DASHBOARD -->
        <section class="dashboard-grid">

            <!-- CASE PIPELINE -->
            <article class="dashboard-card pipeline-card">

                <div class="card-header">

                    <h2>Case pipeline</h2>

                    <div class="pipeline-filters">

                        <button type="button"
                                class="filter-pill active">
                            All
                        </button>

                        <button type="button"
                                class="filter-pill">
                            Liberty
                        </button>

                        <button type="button"
                                class="filter-pill">
                            Standard Bank
                        </button>

                    </div>

                </div>


                <div class="table-container">

                    <table class="pipeline-table">

                        <thead>
                            <tr>
                                <th>CLIENT</th>
                                <th>PRODUCT</th>
                                <th>INSTITUTION</th>
                                <th>STAGE</th>
                                <th class="updated-heading">UPDATED</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (Cases.Count > 0)
                            {
                                @foreach (var caseItem in Cases)
                                {
                                    <tr>
                                        <td class="client-name">
                                            @caseItem.ClientName
                                        </td>

                                        <td>
                                            @caseItem.Product
                                        </td>

                                        <td>
                                            @caseItem.Institution
                                        </td>

                                        <td>
                                            <span class="status-badge @GetStatusClass(caseItem.Status)">
                                                <span class="status-dot"></span>
                                                @caseItem.Status
                                            </span>
                                        </td>

                                        <td class="updated-cell">
                                            @caseItem.Updated
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr class="empty-table-row">
                                    <td colspan="5">

                                        <div class="table-empty-state">
                                            <div class="empty-icon">⌕</div>

                                            <strong>No cases to display</strong>

                                            <span>
                                                Client cases will appear here once they
                                                are loaded.
                                            </span>
                                        </div>

                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </article>


            <!-- RIGHT COLUMN -->
            <aside class="right-column">

                <!-- UPCOMING DEADLINES -->
                <article class="dashboard-card deadlines-card">

                    <div class="card-header">
                        <h2>Upcoming deadlines</h2>
                    </div>

                    <div class="deadline-list">

                        @if (Deadlines.Count > 0)
                        {
                            @foreach (var deadline in Deadlines)
                            {
                                <div class="deadline-item">

                                    <div class="deadline-details">
                                        <span class="deadline-title">
                                            @deadline.Title
                                        </span>

                                        <span class="deadline-client">
                                            @deadline.ClientName
                                        </span>
                                    </div>

                                    <span class="deadline-date @GetDeadlineClass(deadline.Urgency)">
                                        @deadline.DateText
                                    </span>

                                </div>
                            }
                        }
                        else
                        {
                            <div class="small-empty-state">
                                <span>No upcoming deadlines</span>
                            </div>
                        }

                    </div>

                </article>


                <!-- CASES BY INSTITUTION -->
                <article class="dashboard-card institutions-card">

                    <div class="card-header">
                        <h2>Cases by institution</h2>
                    </div>

                    <div class="institution-list">

                        @if (Institutions.Count > 0)
                        {
                            @foreach (var institution in Institutions)
                            {
                                <div class="institution-item">

                                    <div class="institution-info">
                                        <span class="institution-name">
                                            @institution.Name
                                        </span>

                                        <span class="institution-count">
                                            @institution.CaseCount
                                            @(institution.CaseCount == 1 ? "case" : "cases")
                                        </span>
                                    </div>

                                    <div class="institution-progress">
                                        <div class="institution-progress-fill"
                                             style="width: @institution.Percentage%">
                                        </div>
                                    </div>

                                </div>
                            }
                        }
                        else
                        {
                            <div class="small-empty-state">
                                <span>No institution data available</span>
                            </div>
                        }

                    </div>

                </article>


                <!-- AI ASSISTANT -->
                <button type="button" class="assistant-card">

                    <div class="assistant-text">
                        <strong>Ask the Nexus assistant</strong>

                        <span>
                            Draft a service package or summarise a case
                        </span>
                    </div>

                    <span class="assistant-arrow">↗</span>

                </button>

            </aside>

        </section>

    </main>

</div>


@code {

    private string? AdvisorFirstName;

    private string SearchText { get; set; } = string.Empty;

    private int? ActiveCases;
    private int? WaitingOnClient;
    private int? AwaitingDocuments;
    private int? MeetingsThisWeek;

    private decimal? PipelineValue;

    private string? ActiveCasesChange;
    private string? AwaitingDocumentsChange;
    private string? MeetingsChange;
    private string? PipelineValueChange;

    private List<CasePipelineItem> Cases { get; set; } = new();

    private List<DeadlineItem> Deadlines { get; set; } = new();

    private List<InstitutionItem> Institutions { get; set; } = new();


    /// <summary>
    /// Later, load the logged-in advisor's dashboard information
    /// from the application's service layer here.
    /// </summary>
    protected override Task OnInitializedAsync()
    {
        return Task.CompletedTask;
    }


    private static string GetStatusClass(string? status)
    {
        if (string.IsNullOrWhiteSpace(status))
            return "status-neutral";

        return status.ToLowerInvariant() switch
        {
            "submitted" => "status-green",
            "issued" => "status-green",
            "awaiting fica" => "status-yellow",
            "awaiting signature" => "status-yellow",
            "info incomplete" => "status-red",
            "consultation booked" => "status-blue",
            _ => "status-neutral"
        };
    }


    private static string GetDeadlineClass(string? urgency)
    {
        if (string.IsNullOrWhiteSpace(urgency))
            return "deadline-normal";

        return urgency.ToLowerInvariant() switch
        {
            "urgent" => "deadline-urgent",
            "soon" => "deadline-soon",
            _ => "deadline-normal"
        };
    }


    public class CasePipelineItem
    {
        public string ClientName { get; set; } = string.Empty;
        public string Product { get; set; } = string.Empty;
        public string Institution { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public string Updated { get; set; } = string.Empty;
    }


    public class DeadlineItem
    {
        public string Title { get; set; } = string.Empty;
        public string ClientName { get; set; } = string.Empty;
        public string DateText { get; set; } = string.Empty;
        public string Urgency { get; set; } = string.Empty;
    }


    public class InstitutionItem
    {
        public string Name { get; set; } = string.Empty;
        public int CaseCount { get; set; }
        public int Percentage { get; set; }
    }
}