@page "/advisor"
@layout MainLayout
@rendermode InteractiveServer
@using Shared.DTOs.Advisor
@using frontend.Services
@using Microsoft.AspNetCore.Components.Web
@inject InvitationService Invite
@inject AdvisorService Advisors

<PageTitle>Advisor Dashboard | Nexus</PageTitle>

<ErrorBoundary>
    <ChildContent>
        <div class="advisor-page">

            <!-- HEADER -->
            <header class="advisor-header">

                <div class="header-greeting">
                    <h1>
                        Good afternoon@(string.IsNullOrWhiteSpace(AdvisorFirstName)
                                                                                            ? "!"
                                                                                            : $", {AdvisorFirstName}!")
                    </h1>

                    <p>
                        @if (Dashboard?.ActiveCases is not null || Dashboard?.WaitingOnClient is not null)
                        {
                            <span>
                                @(Dashboard?.ActiveCases ?? 0) active cases ·
                                @(Dashboard?.WaitingOnClient ?? 0) waiting on client action
                            </span>
                        }
                        else
                        {
                            <span>Your case overview and upcoming work</span>
                        }
                    </p>
                </div>

                <div class="header-actions">

                    <div class="search-box">
                        <span class="search-icon">⌕</span>

                        <input type="text"
                               @bind="SearchText"
                               @bind:event="oninput"
                               @onkeydown="HandleSearchKeyDown"
                               placeholder="Search clients, cases, documents" />
                    </div>

                    <NotificationBell />

                    <a href="/new-client" class="new-client-button">
                        <span class="plus-icon">+</span>
                        New client
                    </a>

                    <button type="button" class="new-client-button" @onclick="ToggleInvitePanel">
                        <span class="plus-icon">↗</span>
                        Invite client
                    </button>

                </div>

            </header>

            @if (ShowInvitePanel)
            {
                <section class="invite-panel">
                    <div class="invite-panel-card">
                        <h3>Invite a client</h3>
                        <p>Enter your client's email address and Nexus will send them a registration link.</p>

                        <div class="invite-panel-row">
                            <input type="email"
                                   @bind="InviteEmail"
                                   placeholder="client@example.co.za" />

                            <button type="button" class="new-client-button" @onclick="GenerateInviteLink">
                                Send invitation
                            </button>
                        </div>

                        @if (!string.IsNullOrEmpty(InviteLink))
                        {
                            <input class="invite-link-output" readonly value="@InviteLink" onfocus="this.select()" />
                        }

                        @if (!string.IsNullOrEmpty(InviteMessage))
                        {
                            <p class="invite-success">@InviteMessage</p>
                        }

                        @if (!string.IsNullOrEmpty(InviteError))
                        {
                            <p class="invite-error">@InviteError</p>
                        }
                    </div>
                </section>
            }


            <!-- DASHBOARD CONTENT -->
            <main class="advisor-content">

                <!-- STAT CARDS -->
                <section class="stats-grid">

                    <article class="stat-card">
                        <span class="stat-label">ACTIVE CASES</span>

                        <strong class="stat-value">
                            @(Dashboard?.ActiveCases ?? 0)
                        </strong>

                        <span class="stat-change">
                            @if (!string.IsNullOrWhiteSpace(Dashboard?.ActiveCasesChange))
                            {
                                @Dashboard?.ActiveCasesChange
                            }
                            else
                            {
                                <span>Data not loaded</span>
                            }
                        </span>
                    </article>


                    <article class="stat-card">
                        <span class="stat-label">AWAITING DOCUMENTS</span>

                        <strong class="stat-value">
                            @(Dashboard?.AwaitingDocuments ?? 0)
                        </strong>

                        <span class="stat-change">
                            @if (!string.IsNullOrWhiteSpace(Dashboard?.AwaitingDocumentsChange))
                            {
                                @Dashboard?.AwaitingDocumentsChange
                            }
                            else
                            {
                                <span>Data not loaded</span>
                            }
                        </span>
                    </article>


                    <article class="stat-card">
                        <span class="stat-label">MEETINGS THIS WEEK</span>

                        <strong class="stat-value">
                            @(Dashboard?.MeetingsThisWeek ?? 0)
                        </strong>

                        <span class="stat-change">
                            @if (!string.IsNullOrWhiteSpace(Dashboard?.MeetingsChange))
                            {
                                @Dashboard?.MeetingsChange
                            }
                            else
                            {
                                <span>Data not loaded</span>
                            }
                        </span>
                    </article>


                    <article class="stat-card">
                        <span class="stat-label">VALUE IN PIPELINE</span>

                        <strong class="stat-value">
                            @($"R {Dashboard?.PipelineValue:N0}" ?? "-")
                        </strong>

                        <span class="stat-change">
                            @if (!string.IsNullOrWhiteSpace(Dashboard?.PipelineValueChange))
                            {
                                @Dashboard?.PipelineValueChange
                            }
                            else
                            {
                                <span>Data not loaded</span>
                            }
                        </span>
                    </article>

                </section>


                <!-- LOWER DASHBOARD -->
                <section class="dashboard-grid">

                    <!-- CASE PIPELINE -->
                    <article class="dashboard-card pipeline-card">

                        <div class="card-header">

                            <h2>Case pipeline</h2>

                            <div class="pipeline-filters">

                                <button type="button"
                                        class="filter-pill @(SelectedInstitution == "All" ? "active" : "")"
                                        @onclick='() => SetInstitutionFilter("All")'> All
                                </button>

                                <button type="button"
                                        class="filter-pill @(SelectedInstitution == "Liberty" ? "active" : "")"
                                        @onclick='() => SetInstitutionFilter("Liberty")'> Liberty
                                </button>

                                <button type="button"
                                        class="filter-pill @(SelectedInstitution == "Standard Bank" ? "active" : "")"
                                        @onclick='() => SetInstitutionFilter("Standard Bank")'> Standard Bank
                                </button>

                            </div>

                        </div>


                        <div class="table-container">

                            <table class="pipeline-table">

                                <thead>
                                    <tr>
                                        <th>CLIENT</th>
                                        <th>PRODUCT</th>
                                        <th>INSTITUTION</th>
                                        <th>STAGE</th>
                                        <th class="updated-heading">UPDATED</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @if (Dashboard?.Cases is not null && Dashboard.Cases.Any(c => SelectedInstitution == "All" || c.Institution == SelectedInstitution))
                                    {
                                        @foreach (var caseItem in Dashboard.Cases.Where(c => SelectedInstitution == "All" || c.Institution == SelectedInstitution))
                                        {
                                            <tr>
                                                <td class="client-name">
                                                    @caseItem.ClientName
                                                </td>

                                                <td>
                                                    @caseItem.Product
                                                </td>

                                                <td>
                                                    @caseItem.Institution
                                                </td>

                                                <td>
                                                    <span class="status-badge @GetStatusClass(caseItem.Status)">
                                                        <span class="status-dot"></span>
                                                        @caseItem.Status
                                                    </span>
                                                </td>

                                                <td class="updated-cell">
                                                    @caseItem.UpdatedAt
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr class="empty-table-row">
                                            <td colspan="5">

                                                <div class="table-empty-state">
                                                    <div class="empty-icon">⌕</div>

                                                    <strong>No cases to display</strong>

                                                    <span>
                                                        Client cases will appear here once they
                                                        are loaded.
                                                    </span>
                                                </div>

                                            </td>
                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>

                    </article>


                    <!-- RIGHT COLUMN -->
                    <aside class="right-column">

                        <!-- UPCOMING DEADLINES -->
                        <article class="dashboard-card deadlines-card">

                            <div class="card-header">
                                <h2>Upcoming deadlines</h2>
                            </div>

                            <div class="deadline-list">

                                @if (Dashboard?.Deadlines is not null && Dashboard.Deadlines.Any())
                                {
                                    @foreach (var deadline in Dashboard.Deadlines)
                                    {
                                        <div class="deadline-item">

                                            <div class="deadline-details">
                                                <span class="deadline-title">
                                                    @deadline.Title
                                                </span>

                                                <span class="deadline-client">
                                                    @deadline.ClientName
                                                </span>
                                            </div>

                                            <span class="deadline-date @GetDeadlineClass(deadline.Urgency)">
                                                @deadline.Date
                                            </span>

                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="small-empty-state">
                                        <span>No upcoming deadlines</span>
                                    </div>
                                }

                            </div>

                        </article>


                        <!-- CASES BY INSTITUTION -->
                        <article class="dashboard-card institutions-card">

                            <div class="card-header">
                                <h2>Cases by institution</h2>
                            </div>

                            <div class="institution-list">

                                @if (Dashboard?.Institutions is not null && Dashboard.Institutions.Any())
                                {
                                    @foreach (var institution in Dashboard.Institutions)
                                    {
                                        <div class="institution-item">

                                            <div class="institution-info">
                                                <span class="institution-name">
                                                    @institution.Name
                                                </span>

                                                <span class="institution-count">
                                                    @institution.CaseCount
                                                    @(institution.CaseCount == 1 ? "case" : "cases")
                                                </span>
                                            </div>

                                            <div class="institution-progress">
                                                <div class="institution-progress-fill"
                                                     style="width: @institution.Percentage%">
                                                </div>
                                            </div>

                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="small-empty-state">
                                        <span>No institution data available</span>
                                    </div>
                                }

                            </div>

                        </article>


                        <!-- AI ASSISTANT -->
                        <a href="/chatbot" class="assistant-card">

                            <div class="assistant-text">
                                <strong>Ask the Nexus assistant</strong>

                                <span>
                                    Draft a service package or summarise a case
                                </span>
                            </div>

                            <span class="assistant-arrow">↗</span>
                        </a>

                    </aside>

                </section>

            </main>

        </div>
    </ChildContent>
    <ErrorContent>
        <div class="advisor-page">
            <p class="dashboard-error">Something went wrong loading this page. Please refresh and try again.</p>
        </div>
    </ErrorContent>
</ErrorBoundary>


@code {
    private AdvisorDashboardDto? Dashboard;

    private string? AdvisorFirstName;

    private string SearchText { get; set; } = string.Empty;

    private bool isLoading = true;
    private string? LoadError;


    private bool ShowInvitePanel;
    private string InviteEmail = string.Empty;
    private string? InviteLink;
    private string? InviteError;
    private string? InviteMessage;
    private string SelectedInstitution = "All";

    private void SetInstitutionFilter(string institution)
    {
        SelectedInstitution = institution;
    }

    private void ToggleInvitePanel()
    {
        ShowInvitePanel = !ShowInvitePanel;
        InviteLink = null;
        InviteError = null;
        InviteMessage = null;
    }

    private async Task GenerateInviteLink()
    {
        InviteError = null;
        InviteMessage = null;
        InviteLink = null;

        if (string.IsNullOrWhiteSpace(InviteEmail))
        {
            InviteError = "Enter the client's email address";
            return;
        }

        var result = await Invite.CreateAsync(InviteEmail);
        if (!result.Success || result.Token is null)
        {
            InviteError = result.Message;
            return;
        }

        InviteLink = Invite.BuildLink(result.Token);
        InviteMessage = result.Message;
    }

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(SearchText))
        {
            Navigation.NavigateTo($"/clients?search={Uri.EscapeDataString(SearchText.Trim())}");
        }
    }

    /// <summary>
    /// Load the logged-in advisor's dashboard information from the API.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        LoadError = null;

        var (dashboard, error) = await Advisors.GetDashboardAsync();

        Dashboard = dashboard;
        AdvisorFirstName = dashboard?.AdvisorFirstName;
        LoadError = error;

        isLoading = false;
    }


    private static string GetStatusClass(string? status)
    {
        if (string.IsNullOrWhiteSpace(status))
            return "status-neutral";

        return status.ToLowerInvariant() switch
        {
            "submitted" => "status-green",
            "issued" => "status-green",
            "awaiting fica" => "status-yellow",
            "awaiting signature" => "status-yellow",
            "info incomplete" => "status-red",
            "consultation booked" => "status-blue",
            _ => "status-neutral"
        };
    }


    private static string GetDeadlineClass(string? urgency)
    {
        if (string.IsNullOrWhiteSpace(urgency))
            return "deadline-normal";

        return urgency.ToLowerInvariant() switch
        {
            "urgent" => "deadline-urgent",
            "soon" => "deadline-soon",
            _ => "deadline-normal"
        };
    }


    public class CasePipelineItem
    {
        public string ClientName { get; set; } = string.Empty;
        public string Product { get; set; } = string.Empty;
        public string Institution { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public string Updated { get; set; } = string.Empty;
    }


    public class DeadlineItem
    {
        public string Title { get; set; } = string.Empty;
        public string ClientName { get; set; } = string.Empty;
        public string DateText { get; set; } = string.Empty;
        public string Urgency { get; set; } = string.Empty;
    }


    public class InstitutionItem
    {
        public string Name { get; set; } = string.Empty;
        public int CaseCount { get; set; }
        public int Percentage { get; set; }
    }
}

