@page "/advisor"

<PageTitle>Advisor Dashboard | Nexus</PageTitle>

<NexusShell Title="Advisor Dashboard"
            Subtitle="Manage your clients, cases and documents"
            ShowPrimaryAction="true">

    <!-- ==============================
         TOP STAT CARDS
         ============================== -->

    <div class="stats-grid">

        <div class="stat-card">
            <span class="eyebrow">ACTIVE CASES</span>
            <strong class="stat-value">--</strong>
            <span class="stat-note">No data available</span>
        </div>

        <div class="stat-card">
            <span class="eyebrow">AWAITING DOCUMENTS</span>
            <strong class="stat-value">--</strong>
            <span class="stat-note">No data available</span>
        </div>

        <div class="stat-card">
            <span class="eyebrow">MEETINGS THIS WEEK</span>
            <strong class="stat-value">--</strong>
            <span class="stat-note">No data available</span>
        </div>

        <div class="stat-card">
            <span class="eyebrow">VALUE IN PIPELINE</span>
            <strong class="stat-value">--</strong>
            <span class="stat-note">No data available</span>
        </div>

    </div>


    <!-- ==============================
         MAIN DASHBOARD
         ============================== -->

    <div class="dashboard-grid">

        <!-- CASE PIPELINE -->
        <section class="dashboard-card pipeline-card">

            <div class="card-header">

                <h3>Case pipeline</h3>

                <div class="segmented">
                    <button class="active">All</button>
                    <button>Liberty</button>
                    <button>Standard Bank</button>
                </div>

            </div>


            <div class="table-wrap">

                <table class="nexus-table">

                    <thead>
                        <tr>
                            <th>CLIENT</th>
                            <th>PRODUCT</th>
                            <th>INSTITUTION</th>
                            <th>STAGE</th>
                            <th>UPDATED</th>
                        </tr>
                    </thead>

                    <tbody>
                    </tbody>

                </table>


                <div class="empty-state">
                    <strong>No cases yet</strong>

                    <span>
                        Cases will appear here once they have been added.
                    </span>
                </div>

            </div>

        </section>


        <!-- ==============================
             RIGHT SIDE
             ============================== -->

        <aside class="right-stack">

            <!-- UPCOMING DEADLINES -->
            <section class="dashboard-card deadlines-card">

                <div class="card-header simple">
                    <h3>Upcoming deadlines</h3>
                </div>

                <div class="empty-section">
                    No upcoming deadlines.
                </div>

            </section>


            <!-- CASES BY INSTITUTION -->
            <section class="dashboard-card institution-card">

                <div class="card-header simple">
                    <h3>Cases by institution</h3>
                </div>

                <div class="empty-section">
                    No institution data available.
                </div>

            </section>


            <!-- AI ASSISTANT -->
            <a href="/assistant"
               class="assistant-banner">

                <div class="assistant-copy">

                    <strong>
                        Ask the Nexus assistant
                    </strong>

                    <span>
                        Draft correspondence, prepare cases and summarise documents
                    </span>

                </div>

                <span class="assistant-arrow">
                    ↗
                </span>

            </a>

        </aside>

    </div>

</NexusShell>