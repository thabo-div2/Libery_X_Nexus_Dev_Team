@page "/advisor"
@layout MainLayout
@rendermode InteractiveServer
@using Shared.DTOs.Advisor
@using frontend.Services
@using Microsoft.AspNetCore.Components.Web
@inject InvitationService Invite
@inject AdvisorService Advisors

<PageTitle>Advisor Dashboard | Nexus</PageTitle>

<ErrorBoundary>
    <ChildContent>
        <div class="advisor-page">

            <!-- HEADER -->
            <header class="advisor-header">

                <div class="header-greeting">
                    <h1>
                        Good afternoon@(string.IsNullOrWhiteSpace(AdvisorFirstName)
                                                                                            ? "!"
                                                                                            : $", {AdvisorFirstName}!")
                    </h1>

                    <p>
                        @if (Dashboard?.ActiveCases is not null || Dashboard?.WaitingOnClient is not null)
                        {
                            <span>
                                @(Dashboard?.ActiveCases ?? 0) active cases ·
                                @(Dashboard?.WaitingOnClient ?? 0) waiting on client action
                            </span>
                        }
                        else
                        {
                            <span>Your case overview and upcoming work</span>
                        }
                    </p>
                </div>

                <div class="header-actions">

                    <div class="search-box" role="search">
                        <span class="search-icon" aria-hidden="true">⌕</span>

                        <input aria-label="Search clients, cases, documents" type="text"
                               @bind="SearchText"
                               @bind:event="oninput"
                               @onkeydown="HandleSearchKeyDown"
                               placeholder="Search clients, cases, documents" />
                    </div>

                    <NotificationBell />

                    <button type="button"
                            class="new-client-button secondary"
                            aria-expanded="@(ShowInvitePanel ? "true" : "false")"
                            aria-controls="invite-panel"
                            @ref="InviteToggleButton"
                            @onclick="ToggleInvitePanel">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                        Invite client
                    </button>

                    <a href="/new-client" class="new-client-button">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
                        New client
                    </a>

                </div>

            </header>

            @if (ShowInvitePanel)
            {
                <section id="invite-panel" class="invite-panel" aria-label="Invite a client" @onkeydown="HandleInvitePanelKeyDown">
                    <div class="invite-panel-card">
                        <h3>Invite a client</h3>
                        <p>Enter your client's email address and Nexus will send them a registration link.</p>

                        <EditForm Model="InviteModel" OnValidSubmit="GenerateInviteLink" novalidate>
                        <DataAnnotationsValidator />

                        <div class="invite-panel-row">
                            <div class="invite-email-field">
                                <label for="invite-email" class="visually-hidden">Client email address</label>
                                <InputText id="invite-email"
                                           type="email"
                                           autocomplete="off"
                                           @bind-Value="InviteModel.Email"
                                           placeholder="client@example.co.za" />

                                <ValidationMessage For="() => InviteModel.Email" />
                            </div>

                            <button type="submit" class="new-client-button" disabled="@IsSendingInvite">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                                @(IsSendingInvite ? "Sending..." : "Send invitation")
                            </button>
                        </div>
                        </EditForm>

                        @if (!string.IsNullOrEmpty(InviteLink))
                        {
                            <input class="invite-link-output" readonly value="@InviteLink" onfocus="this.select()" />
                        }

                        @if (!string.IsNullOrEmpty(InviteMessage))
                        {
                            <p class="invite-success">@InviteMessage</p>
                        }

                        @if (!string.IsNullOrEmpty(InviteError))
                        {
                            <p class="invite-error" role="alert">@InviteError</p>
                        }
                    </div>
                </section>
            }


            <!-- DASHBOARD CONTENT -->
            <main class="advisor-content">

                <!-- STAT CARDS -->
                <section class="stats-grid">

                    <article class="stat-card">
                        <span class="stat-label">ACTIVE CASES</span>

                        <strong class="stat-value">
                            @(Dashboard?.ActiveCases ?? 0)
                        </strong>

                        <span class="stat-change @GetChangeClass(Dashboard?.ActiveCasesChange)">
                            @if (!string.IsNullOrWhiteSpace(Dashboard?.ActiveCasesChange))
                            {
                                @Dashboard?.ActiveCasesChange
                            }
                            else
                            {
                                <span>Data not loaded</span>
                            }
                        </span>
                    </article>


                    <article class="stat-card">
                        <span class="stat-label">AWAITING DOCUMENTS</span>

                        <strong class="stat-value">
                            @(Dashboard?.AwaitingDocuments ?? 0)
                        </strong>

                        <span class="stat-change @GetChangeClass(Dashboard?.AwaitingDocumentsChange)">
                            @if (!string.IsNullOrWhiteSpace(Dashboard?.AwaitingDocumentsChange))
                            {
                                @Dashboard?.AwaitingDocumentsChange
                            }
                            else
                            {
                                <span>Data not loaded</span>
                            }
                        </span>
                    </article>


                    <article class="stat-card">
                        <span class="stat-label">MEETINGS THIS WEEK</span>

                        <strong class="stat-value">
                            @(Dashboard?.MeetingsThisWeek ?? 0)
                        </strong>

                        <span class="stat-change @GetChangeClass(Dashboard?.MeetingsChange)">
                            @if (!string.IsNullOrWhiteSpace(Dashboard?.MeetingsChange))
                            {
                                @Dashboard?.MeetingsChange
                            }
                            else
                            {
                                <span>Data not loaded</span>
                            }
                        </span>
                    </article>


                    <article class="stat-card">
                        <span class="stat-label">VALUE IN PIPELINE</span>

                        <strong class="stat-value">
                            @(Dashboard is null ? "—" : $"R {Dashboard.PipelineValue:N2}")
                        </strong>

                        <span class="stat-change @GetChangeClass(Dashboard?.PipelineValueChange)">
                            @if (!string.IsNullOrWhiteSpace(Dashboard?.PipelineValueChange))
                            {
                                @Dashboard?.PipelineValueChange
                            }
                            else
                            {
                                <span>Data not loaded</span>
                            }
                        </span>
                    </article>

                </section>


                <!-- LOWER DASHBOARD -->
                <section class="dashboard-grid">

                    <!-- CASE PIPELINE -->
                    <article class="dashboard-card pipeline-card">

                        <div class="card-header">

                            <h2>Case pipeline</h2>

                            <div class="pipeline-filters" aria-label="Filter cases by institution">
                                @foreach (var institution in PipelineInstitutions)
                                {
                                    <button type="button" class="filter-pill @(SelectedInstitution == institution ? "active" : "")"
                                            aria-pressed="@(SelectedInstitution == institution)"
                                            @onclick="() => SetInstitutionFilter(institution)">@institution</button>
                                }
                            </div>

                        </div>


                        <div class="table-container">
                            <table class="pipeline-table">
                                <caption class="visually-hidden">Client cases and their current application status</caption>
                                <thead><tr><th scope="col">Client / product</th><th scope="col">Institution</th><th scope="col">Stage</th><th scope="col" class="updated-heading">Updated</th></tr></thead>
                                <tbody>
                                    @if (isLoading || !string.IsNullOrWhiteSpace(LoadError) || !FilteredCases.Any())
                                    {
                                        <tr><td colspan="4" class="pipeline-empty" role="status">@(isLoading ? "Loading cases…" : LoadError ?? "No cases for this institution yet.")</td></tr>
                                    }
                                    else
                                    {
                                        @foreach (var caseItem in FilteredCases)
                                        {
                                            <tr>
                                                <td><div class="pipeline-client"><span class="pipeline-avatar" aria-hidden="true">@GetInitials(caseItem.ClientName)</span><div><strong>@caseItem.ClientName</strong><span class="pipeline-product">@caseItem.Product</span></div></div></td>
                                                <td><span class="pipeline-provider">@caseItem.Institution</span></td>
                                                <td><span class="status-badge @GetStatusClass(caseItem.Status)"><span class="status-dot" aria-hidden="true"></span>@FormatStatus(caseItem.Status)</span></td>
                                                <td class="updated-cell">@caseItem.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                    </article>


                    <!-- RIGHT COLUMN -->
                    <aside class="right-column">

                        <!-- UPCOMING DEADLINES -->
                        <article class="dashboard-card deadlines-card">

                            <div class="card-header">
                                <h2>Upcoming deadlines</h2>
                            </div>

                            <div class="deadline-list">

                                @if (Dashboard?.Deadlines is not null && Dashboard.Deadlines.Any())
                                {
                                    @foreach (var deadline in Dashboard.Deadlines)
                                    {
                                        <div class="deadline-item">

                                            <div class="deadline-details">
                                                <span class="deadline-title">
                                                    @deadline.Title
                                                </span>

                                                <span class="deadline-client">
                                                    @deadline.ClientName
                                                </span>
                                            </div>

                                            <span class="deadline-date @GetDeadlineClass(deadline.Urgency)">
                                                @deadline.Date
                                            </span>

                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="small-empty-state">
                                        <span>No upcoming deadlines</span>
                                    </div>
                                }

                            </div>

                        </article>


                        <!-- CASES BY INSTITUTION -->
                        <article class="dashboard-card institutions-card">

                            <div class="card-header">
                                <h2>Cases by institution</h2>
                            </div>

                            <div class="institution-list">

                                @if (Dashboard?.Institutions is not null && Dashboard.Institutions.Any())
                                {
                                    @foreach (var institution in Dashboard.Institutions)
                                    {
                                        <div class="institution-item">

                                            <div class="institution-info">
                                                <span class="institution-name">
                                                    @institution.Name
                                                </span>

                                                <span class="institution-count">
                                                    @institution.CaseCount
                                                    @(institution.CaseCount == 1 ? "case" : "cases")
                                                </span>
                                            </div>

                                            <div class="institution-progress">
                                                <div class="institution-progress-fill"
                                                     style="width: @institution.Percentage%">
                                                </div>
                                            </div>

                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="small-empty-state">
                                        <span>No institution data available</span>
                                    </div>
                                }

                            </div>

                        </article>


                        <!-- AI ASSISTANT -->
                        <a href="/chatbot" class="assistant-card">

                            <div class="assistant-text">
                                <strong>Ask the Nexus assistant</strong>

                                <span>
                                    Draft a service package or summarise a case
                                </span>
                            </div>

                            <span class="assistant-arrow">↗</span>
                        </a>

                    </aside>

                </section>

            </main>

        </div>
    </ChildContent>
    <ErrorContent>
        <div class="advisor-page">
            <p class="dashboard-error">Something went wrong loading this page. Please refresh and try again.</p>
        </div>
    </ErrorContent>
</ErrorBoundary>


@code {
    private AdvisorDashboardDto? Dashboard;

    private string? AdvisorFirstName;

    private string SearchText { get; set; } = string.Empty;

    private bool isLoading = true;
    private string? LoadError;


    private bool ShowInvitePanel;
    /// <summary>
    /// The invite box. Its rules (email required and valid) live on InviteClientForm.
    /// </summary>
    private InviteClientForm InviteModel = new();
    private bool IsSendingInvite;
    private string? InviteLink;
    private string? InviteError;
    private string? InviteMessage;
    private string SelectedInstitution = "All";

    private static string GetChangeClass(string? change)
{
    if (string.IsNullOrWhiteSpace(change))
    {
        return string.Empty;
    }

    var trimmed = change.TrimStart();

    if (trimmed.StartsWith("-"))
    {
        return "negative";
    }

    if (trimmed.StartsWith("+"))
    {
        return "positive";
    }

    return string.Empty;
}

    private void SetInstitutionFilter(string institution)
    {
        SelectedInstitution = institution;
    }

    private void ToggleInvitePanel()
    {
        ShowInvitePanel = !ShowInvitePanel;
        InviteLink = null;
        InviteError = null;
        InviteMessage = null;
    }

    /// <summary>
    /// The Invite client button, so focus can go back to it when the panel closes.
    /// </summary>
    private ElementReference InviteToggleButton;

    /// <summary>
    /// Escape inside the invite panel closes it and puts focus back on the Invite client button,
    /// so keyboard users aren't left stranded when it disappears.
    /// </summary>
    private async Task HandleInvitePanelKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && ShowInvitePanel)
        {
            ToggleInvitePanel();
            // The element can be missing if the page changed in the meantime; closing still worked.
            try { await InviteToggleButton.FocusAsync(); } catch (Exception) { }
        }
    }

    /// <summary>
    /// Runs only when the email passes its rules (EditForm OnValidSubmit).
    /// </summary>
    private async Task GenerateInviteLink()
    {
        InviteError = null;
        InviteMessage = null;
        InviteLink = null;

        IsSendingInvite = true;
        var result = await Invite.CreateAsync(InviteModel.Email.Trim());
        IsSendingInvite = false;

        if (!result.Success || result.Token is null)
        {
            InviteError = result.Message;
            return;
        }

        InviteLink = Invite.BuildLink(result.Token);
        InviteMessage = result.Message;
    }

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(SearchText))
        {
            Navigation.NavigateTo($"/clients?search={Uri.EscapeDataString(SearchText.Trim())}");
        }
    }

    /// <summary>
    /// Load the logged-in advisor's dashboard information from the API.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        LoadError = null;

        var (dashboard, error) = await Advisors.GetDashboardAsync();

        Dashboard = dashboard;
        AdvisorFirstName = dashboard?.AdvisorFirstName;
        LoadError = error;

        isLoading = false;
    }




    private IEnumerable<CasePipelineItemDto> FilteredCases =>
        (Dashboard?.Cases ?? new()).Where(c => SelectedInstitution == "All" || c.Institution == SelectedInstitution);

    private IEnumerable<string> PipelineInstitutions => new[] { "All" }.Concat(
        (Dashboard?.Cases ?? new()).Select(c => c.Institution).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x));

    private static string FormatStatus(string status) => status switch
    {
        "InProgress" => "In progress",
        "AwaitingApproval" => "Awaiting approval",
        "OnHold" => "On hold",
        "Completed" => "Completed",
        _ => status
    };

    private static string GetInitials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));

    private static string GetStatusClass(string? status) => status switch
    {
        "InProgress" => "status-blue",
        "AwaitingApproval" => "status-yellow",
        "OnHold" => "status-red",
        "Completed" => "status-green",
        "Cancelled" or "Lapsed" => "status-red",
        "Matured" => "status-neutral",
        _ => "status-neutral"
    };

    private static string GetDeadlineClass(string? urgency)
    {
        if (string.IsNullOrWhiteSpace(urgency))
            return "deadline-normal";

        return urgency.ToLowerInvariant() switch
        {
            "urgent" => "deadline-urgent",
            "soon" => "deadline-soon",
            _ => "deadline-normal"
        };
    }


    public class CasePipelineItem
    {
        public string ClientName { get; set; } = string.Empty;
        public string Product { get; set; } = string.Empty;
        public string Institution { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public string Updated { get; set; } = string.Empty;
    }


    public class DeadlineItem
    {
        public string Title { get; set; } = string.Empty;
        public string ClientName { get; set; } = string.Empty;
        public string DateText { get; set; } = string.Empty;
        public string Urgency { get; set; } = string.Empty;
    }


    public class InstitutionItem
    {
        public string Name { get; set; } = string.Empty;
        public int CaseCount { get; set; }
        public int Percentage { get; set; }
    }
}

@* //-----------------------------------------------------------------------------0o0o0o End of File 0o0o0o0o0o-------------------------------------------------------------------------------------------------// *@
