@page "/client-messages"
@layout MainLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable
@using frontend.Services
@inject CurrentUserService CurrentUser
@inject ClientService ClientDirectory
@inject MessageService MessageStore
@inject MeetingService MeetingStore
@inject AvailabilityService AvailabilityApi
@inject MessageNotifier Notifier
@inject IJSRuntime JS

<PageTitle>Messages | Nexus</PageTitle>

<ErrorBoundary>
    <ChildContent>
        <div class="client-messages-page">

            <header class="client-messages-header">
                <h1>Messages</h1>
                <p>
                    @if (AdvisorId is null)
                    {
                        <span>You don't have an adviser assigned yet.</span>
                    }
                    else
                    {
                        <span>Your conversation with @AdvisorName.</span>
                    }
                </p>
            </header>

            @if (!string.IsNullOrEmpty(LoadError))
            {
                <p class="client-messages-error">@LoadError</p>
            }
            else if (IsLoading)
            {
                <p class="client-messages-error">Loading your messages…</p>
            }
            else
            {
                @if (AdvisorId is not null)
                {
                    <AdvisorAvailabilityNotice @ref="AvailabilityNotice" OnStatusChanged="OnAvailabilityChanged" />
                }

                <section class="chat-panel">

                    <div class="chat-header">
                        <div class="chat-client">
                            <span class="adviser-avatar">@AdviserInitials</span>
                            <h2>@AdvisorName</h2>
                        </div>

                        <button type="button" class="meeting-toggle-button" @ref="MeetingToggleButton" aria-expanded="@(ShowMeetingForm ? "true" : "false")" @onclick="ToggleMeetingForm" disabled="@(AdvisorId is null)">
                            <span aria-hidden="true">♙</span>
                            Book meeting
                        </button>
                    </div>

                    @if (ShowMeetingForm && HoursConfigured)
                    {
                        @* The adviser has set working hours, so offer the times that are actually open. *@
                        <div class="meeting-request-form" role="region" aria-label="Book a meeting" @onkeydown="HandleMeetingFormKeyDown">

                            <label>
                                Date
                                <input type="date" min="@MinSlotDate" value="@SlotDate" @onchange="OnSlotDateChangedAsync" disabled="@IsSendingMeeting" />
                            </label>

                            @if (IsLoadingSlots)
                            {
                                <p class="slot-hint">Checking your adviser's diary…</p>
                            }
                            else if (!string.IsNullOrEmpty(SlotMessage))
                            {
                                <p class="slot-hint">@SlotMessage</p>
                            }
                            else if (Slots.Count > 0)
                            {
                                <p class="slot-hint">Choose a time (South African time, 60 minutes).</p>

                                <div class="slot-grid" role="group" aria-label="Available times">
                                    @foreach (var slot in Slots)
                                    {
                                        var isPicked = SelectedSlot == slot.StartUtc;

                                        <button type="button"
                                                class="slot-button @(isPicked ? "is-selected" : "")"
                                                aria-pressed="@(isPicked ? "true" : "false")"
                                                disabled="@IsSendingMeeting"
                                                @key="slot.StartUtc"
                                                @onclick="() => PickSlot(slot.StartUtc)">
                                            @slot.Label
                                        </button>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="slot-hint">Pick a date to see the times your adviser is free.</p>
                            }

                            <label>
                                Notes (optional)
                                <input type="text" maxlength="500" @bind="SlotNotes" placeholder="What would you like to discuss?" disabled="@IsSendingMeeting" />
                            </label>

                            <div class="meeting-form-actions">
                                <button type="button" class="meeting-cancel-button" @onclick="ToggleMeetingForm">Cancel</button>
                                <button type="button" class="meeting-send-button" disabled="@(IsSendingMeeting || SelectedSlot is null)" @onclick="SendSlotRequestAsync">@(IsSendingMeeting ? "Sending…" : "Request meeting")</button>
                            </div>

                            @if (!string.IsNullOrEmpty(MeetingError))
                            {
                                <p class="client-messages-error">@MeetingError</p>
                            }

                        </div>
                    }
                    else if (ShowMeetingForm)
                    {
                        <div class="meeting-request-form" role="region" aria-label="Book a meeting" @onkeydown="HandleMeetingFormKeyDown">
                            <EditForm Model="MeetingModel" OnValidSubmit="SendMeetingRequest" novalidate>
                                <DataAnnotationsValidator />

                                <label>
                                    Date &amp; time
                                    <InputDate Type="InputDateType.DateTimeLocal" min="@MinMeetingTime" @bind-Value="MeetingModel.MeetingDateTime" />
                                </label>
                                <ValidationMessage For="() => MeetingModel.MeetingDateTime" />

                                <label>
                                    Notes (optional)
                                    <InputText @bind-Value="MeetingModel.Notes" placeholder="What would you like to discuss?" />
                                </label>
                                <ValidationMessage For="() => MeetingModel.Notes" />

                                <div class="meeting-form-actions">
                                    <button type="button" class="meeting-cancel-button" @onclick="ToggleMeetingForm">Cancel</button>
                                    <button type="submit" class="meeting-send-button" disabled="@IsSendingMeeting">@(IsSendingMeeting ? "Sending…" : "Request meeting")</button>
                                </div>

                                @if (!string.IsNullOrEmpty(MeetingError))
                                {
                                    <p class="client-messages-error">@MeetingError</p>
                                }
                            </EditForm>
                        </div>
                    }

                    <div class="chat-body" @ref="ChatBodyRef">
                        @if (TimelineItems.Count == 0)
                        {
                            <p class="client-messages-empty">No messages yet. Say hello to @AdvisorName.</p>
                        }
                        else
                        {
                            @foreach (var item in TimelineItems)
                            {
                                @if (item.Meeting is not null)
                                {
                                    <div class="meeting-card @GetMeetingStatusClass(item.Meeting.Status)">
                                        <strong>Meeting request</strong>
                                        <span>@item.Meeting.MeetingDate.ToLocalTime().ToString("d MMM yyyy, HH:mm")</span>

                                        @if (!string.IsNullOrWhiteSpace(item.Meeting.Notes))
                                        {
                                            <span class="meeting-card-notes">@item.Meeting.Notes</span>
                                        }

                                        <span class="meeting-status-label">@GetMeetingStatusText(item.Meeting.Status)</span>
                                    </div>
                                }
                                else if (item.Message is not null)
                                {
                                    <div class="message-bubble @(item.Message.FromAdvisor ? "message-from-advisor" : "message-from-me")">
                                        <span class="message-author">@(item.Message.FromAdvisor ? AdvisorName : "You")</span>
                                        <p>@item.Message.Text</p>
                                        <span class="message-time">@item.Message.SentAt.ToLocalTime().ToString("d MMM, HH:mm")</span>
                                    </div>
                                }
                            }
                        }
                    </div>

                    <div class="client-messages-composer">
                        <input type="text"
                               aria-label="Message your adviser"
                               @bind="Draft"
                               @bind:event="oninput"
                               @onkeydown="HandleComposerKeyDown"
                               placeholder="@(IsAdvisorAway ? "Your adviser is out of office. You can message them once they are back." : "Write a message to your adviser…")"
                               disabled="@(AdvisorId is null || IsAdvisorAway)" />

                        <button type="button" @onclick="SendMessage" disabled="@(AdvisorId is null || IsAdvisorAway)">Send</button>
                    </div>
                </section>
            }

            @if (!string.IsNullOrEmpty(SendError))
            {
                <p class="client-messages-error">@SendError</p>
            }

        </div>
    </ChildContent>
    <ErrorContent>
        <div class="client-messages-page">
            <p class="client-messages-error">Something went wrong loading your messages. Please refresh and try again.</p>
        </div>
    </ErrorContent>
</ErrorBoundary>

@code {
    private int? ClientId;
    private int? AdvisorId;
    private string AdvisorName = "your adviser";
    private string AdviserInitials = "A";

    private List<ChatMessage> Thread = new();
    private List<MeetingSummary> Meetings = new();
    private List<TimelineItem> TimelineItems = new();

    private string Draft = string.Empty;
    private string? LoadError;
    private string? SendError;

    // The notice at the top of the chat, and whether it says the advisor is out of hours.
    // While they are, the message box is locked. The API enforces the same rule.
    private AdvisorAvailabilityNotice? AvailabilityNotice;
    private bool IsAdvisorAway;

    // Meeting times. Once the adviser has set working hours, the client picks from the open times
    // on a date instead of typing any date and time.
    private bool HoursConfigured;
    private string SlotDate = string.Empty;
    private List<MeetingSlot> Slots = new();
    private DateTime? SelectedSlot;
    private string? SlotMessage;
    private bool IsLoadingSlots;
    private string SlotNotes = string.Empty;

    /// <summary>
    /// Stops the date picker from offering dates that have already passed.
    /// </summary>
    private static string MinSlotDate => DateTime.Now.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    private bool IsLoading = true;

    private bool ShowMeetingForm;
    /// <summary>
    /// The meeting request form. Its rules (date required and in the future,
    /// notes under 500 characters) live on MeetingRequestForm.
    /// </summary>
    private MeetingRequestForm MeetingModel = new();

    /// <summary>
    /// Stops the date picker from showing times that have already passed.
    /// </summary>
    private string MinMeetingTime => DateTime.Now.ToString("yyyy-MM-ddTHH:mm", System.Globalization.CultureInfo.InvariantCulture);
    private string? MeetingError;

    private ElementReference ChatBodyRef;
    private int LastScrollCount;

    /// <summary>
    /// Scrolls the chat to the bottom when it opens or a new message comes in.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (TimelineItems.Count == 0 || TimelineItems.Count == LastScrollCount)
        {
            return;
        }

        LastScrollCount = TimelineItems.Count;

        try
        {
            await JS.InvokeVoidAsync("scrollToBottom", ChatBodyRef);
        }
        catch
        {
            // The page might be closing, so there's nothing to scroll.
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.EnsureRestoredAsync();

        if (CurrentUser.Id is null)
        {
            LoadError = "Please log in to view your messages.";
            IsLoading = false;
            return;
        }

        ClientId = CurrentUser.Id;

        var (client, clientError) = await ClientDirectory.GetByIdAsync(ClientId.Value);
        if (client is null)
        {
            LoadError = clientError ?? "Could not load your profile.";
            IsLoading = false;
            return;
        }

        AdvisorId = client.AdvisorId;
        AdvisorName = client.AdvisorName ?? "your adviser";
        AdviserInitials = BuildInitials(AdvisorName);

        if (AdvisorId is not null)
        {
            await RefreshThreadAsync();
        }

        IsLoading = false;

        Notifier.MessageSent += OnMessageSent;
    }

    private void OnMessageSent(int clientId)
    {
        if (ClientId is null || clientId != ClientId.Value)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await RefreshThreadAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Notifier.MessageSent -= OnMessageSent;
    }

    private async Task RefreshThreadAsync()
    {
        if (ClientId is null)
        {
            return;
        }

        var (messages, messageError) = await MessageStore.GetConversationAsync(ClientId.Value);
        Thread = messages;

        var (meetings, meetingError) = await MeetingStore.GetForClientAsync(ClientId.Value);
        Meetings = meetings;

        LoadError = messageError ?? meetingError;
        BuildTimeline();
    }

    private void BuildTimeline()
    {
        var items = new List<TimelineItem>();

        items.AddRange(Thread.Select(m => new TimelineItem { Timestamp = m.SentAt, Message = m }));
        items.AddRange(Meetings.Select(m => new TimelineItem { Timestamp = m.CreatedAt, Meeting = m }));

        TimelineItems = items.OrderBy(i => i.Timestamp).ToList();
    }

    private void OnAvailabilityChanged(AdvisorAvailability status)
    {
        IsAdvisorAway = !status.IsAvailableNow;
        HoursConfigured = status.IsConfigured;

        if (!IsAdvisorAway)
        {
            SendError = null;
        }
    }

    /// <summary>
    /// After the API refuses something, check the advisor's hours again so the notice
    /// and the message box match what the API just said.
    /// </summary>
    private async Task RefreshAvailabilityAsync()
    {
        if (AvailabilityNotice is not null)
        {
            await AvailabilityNotice.RefreshAsync();
        }
    }

    private void PickSlot(DateTime startUtc)
    {
        SelectedSlot = startUtc;
        MeetingError = null;
    }

    private async Task OnSlotDateChangedAsync(ChangeEventArgs e)
    {
        SlotDate = e.Value?.ToString() ?? string.Empty;
        await LoadSlotsAsync();
    }

    /// <summary>
    /// Loads the open times for the chosen date.
    /// </summary>
    private async Task LoadSlotsAsync()
    {
        Slots = new();
        SelectedSlot = null;
        SlotMessage = null;
        MeetingError = null;

        if (string.IsNullOrWhiteSpace(SlotDate))
        {
            return;
        }

        var date = SlotDate;
        IsLoadingSlots = true;

        try
        {
            var (result, error) = await AvailabilityApi.GetSlotsAsync(date);

            // The client may have picked another date while this one was loading.
            if (date != SlotDate)
            {
                return;
            }

            if (result is null)
            {
                SlotMessage = error ?? "The open times couldn't be loaded. Please try again.";
                return;
            }

            if (result.Slots.Count == 0)
            {
                SlotMessage = string.IsNullOrWhiteSpace(result.Message)
                    ? "There are no open times on that day. Please choose another day."
                    : result.Message;
                return;
            }

            Slots = result.Slots;
        }
        finally
        {
            if (date == SlotDate)
            {
                IsLoadingSlots = false;
            }
        }
    }

    /// <summary>
    /// Requests a meeting at the time the client picked. If the API refuses (for example someone
    /// else took the time a moment ago), the reason is shown and the times are loaded again.
    /// </summary>
    private async Task SendSlotRequestAsync()
    {
        if (IsSendingMeeting || SelectedSlot is not DateTime startUtc)
        {
            return;
        }

        MeetingError = null;

        if (ClientId is null || AdvisorId is null)
        {
            MeetingError = "You don't have an adviser assigned yet.";
            return;
        }

        if (SlotNotes.Length > 500)
        {
            MeetingError = "Keep the note under 500 characters.";
            return;
        }

        IsSendingMeeting = true;

        try
        {
            var notes = string.IsNullOrWhiteSpace(SlotNotes) ? null : SlotNotes.Trim();
            var error = await MeetingStore.RequestAsync(ClientId.Value, AdvisorId.Value, fromAdvisor: false, startUtc, notes);

            if (error is not null)
            {
                await LoadSlotsAsync();
                MeetingError = error;
                await RefreshAvailabilityAsync();
                return;
            }

            SlotDate = string.Empty;
            SlotNotes = string.Empty;
            Slots = new();
            SelectedSlot = null;
            SlotMessage = null;
            ShowMeetingForm = false;

            await RefreshThreadAsync();
        }
        finally
        {
            IsSendingMeeting = false;
        }
    }

    private void ToggleMeetingForm()
    {
        ShowMeetingForm = !ShowMeetingForm;
        MeetingError = null;
    }

    /// <summary>
    /// The Book meeting button, so focus can go back to it when the form closes.
    /// </summary>
    private ElementReference MeetingToggleButton;

    /// <summary>
    /// Escape inside the meeting form closes it and puts focus back on the Book meeting button,
    /// so keyboard users aren't left stranded when it disappears.
    /// </summary>
    private async Task HandleMeetingFormKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            ShowMeetingForm = false;
            MeetingError = null;
            // The element can be missing if the page changed in the meantime; closing still worked.
            try { await MeetingToggleButton.FocusAsync(); } catch (Exception) { }
        }
    }

    /// <summary>
    /// True while a meeting request is being sent, so a double-click can't send it twice.
    /// </summary>
    private bool IsSendingMeeting;

    /// <summary>
    /// Runs only when the form passes its rules. Reads the values from the form that was
    /// actually submitted (context.Model) and copies them first: after the first click
    /// succeeds the page swaps MeetingModel for a fresh empty one, and a second queued
    /// click used to read that empty model and crash with "Nullable object must have a value".
    /// </summary>
    private async Task SendMeetingRequest(EditContext context)
    {
        if (IsSendingMeeting || context.Model is not MeetingRequestForm submitted || submitted.MeetingDateTime is not DateTime meetingLocal)
        {
            return;
        }

        var notes = submitted.Notes;
        IsSendingMeeting = true;

        try
        {
            await SendMeetingRequestCore(submitted, meetingLocal, notes);
        }
        finally
        {
            IsSendingMeeting = false;
        }
    }

    private async Task SendMeetingRequestCore(MeetingRequestForm submitted, DateTime meetingLocal, string? notes)
    {
        MeetingError = null;

        if (ClientId is null || AdvisorId is null)
        {
            MeetingError = "You don't have an adviser assigned yet.";
            return;
        }

        var meetingDateUtc = DateTime.SpecifyKind(meetingLocal, DateTimeKind.Local).ToUniversalTime();

        var error = await MeetingStore.RequestAsync(ClientId.Value, AdvisorId.Value, fromAdvisor: false, meetingDateUtc, notes);
        if (error is not null)
        {
            MeetingError = error;
            await RefreshAvailabilityAsync();
            return;
        }

        MeetingModel = new();
        ShowMeetingForm = false;

        await RefreshThreadAsync();
    }

    private async Task HandleComposerKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        SendError = null;

        if (ClientId is null || AdvisorId is null)
        {
            SendError = "You don't have an adviser assigned yet.";
            return;
        }

        if (string.IsNullOrWhiteSpace(Draft))
        {
            SendError = "Type a message before sending";
            return;
        }

        var error = await MessageStore.SendAsync(ClientId.Value, AdvisorId.Value, fromAdvisor: false, Draft);
        if (error is not null)
        {
            SendError = error;
            await RefreshAvailabilityAsync();
            return;
        }

        Draft = string.Empty;
        await RefreshThreadAsync();
    }

    private static string BuildInitials(string name)
    {
        var initials = string.Concat(name
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(part => char.ToUpperInvariant(part[0])));

        return string.IsNullOrWhiteSpace(initials) ? "A" : initials;
    }

    private static string GetMeetingStatusClass(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "confirmed" => "meeting-confirmed",
            "cancelled" => "meeting-denied",
            _ => "meeting-pending"
        };
    }

    private static string GetMeetingStatusText(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "confirmed" => "Meeting confirmed",
            "cancelled" => "Meeting request denied",
            _ => "Waiting for your adviser to confirm"
        };
    }

    private class TimelineItem
    {
        public DateTime Timestamp { get; set; }

        public ChatMessage? Message { get; set; }

        public MeetingSummary? Meeting { get; set; }
    }
}

@* //-----------------------------------------------------------------------------0o0o0o End of File 0o0o0o0o0o-------------------------------------------------------------------------------------------------// *@
