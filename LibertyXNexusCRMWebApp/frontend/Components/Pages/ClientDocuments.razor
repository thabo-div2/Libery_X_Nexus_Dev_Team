@page "/client-documents"
@layout MainLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using frontend.Services
@inject DocumentService DocumentDirectory
@inject PolicyService PolicyDirectory
@inject CurrentUserService CurrentUser
@inject NavigationManager Navigation

<PageTitle>My documents | Nexus</PageTitle>

<div class="cdocs-page">

    <header class="cdocs-header">

        <div class="cdocs-heading">
            <h1>My documents</h1>
            <p>Documents you've sent your advisor and ones they've shared with you</p>
        </div>

        <div class="header-actions">
            <NotificationBell />
        </div>

    </header>


    <main class="cdocs-content">

        <section class="main-column">

            <article class="cdocs-card">

                <div class="card-header">
                    <h2>Your documents<span class="card-count">@Documents.Count</span></h2>
                </div>

                <div class="cdocs-list">

                    @if (!string.IsNullOrWhiteSpace(DownloadError))
                    {
                        <p class="nx-alert nx-alert-danger cdocs-alert" role="alert">@DownloadError</p>
                    }

                    @if (IsLoading)
                    {
                        <div class="empty-state" role="status">
                            <div class="nx-skeleton-stack page-skeleton" role="status"><span class="visually-hidden">Loading your documents</span><span class="nx-skeleton"></span><span class="nx-skeleton"></span><span class="nx-skeleton"></span></div>
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
                    {
                        <div class="empty-state" role="alert">
                            <strong>Unable to load documents</strong>
                            <span>@ErrorMessage</span>
                        </div>
                    }
                    else if (Documents.Count > 0)
                    {
                        @foreach (var group in DocumentGroups)
                        {
                            var versions = group.OrderByDescending(d => d.DocumentId).ToList();
                            var latest = versions[0];
                            <section class="document-version-group" @key="group.Key">
                                <ClientDocumentEntry Document="latest" RequiresReplacement="@ReplacementPending(latest)" OnDownload="DownloadAsync" OnReplace="BeginReplacement" />
                                @if (versions.Count > 1)
                                {
                                    <details class="document-history">
                                        <summary>Previous uploads <span>@(versions.Count - 1)</span></summary>
                                        @foreach (var previous in versions.Skip(1))
                                        {
                                            <ClientDocumentEntry @key="previous.DocumentId" Document="previous" IsHistory="true" OnDownload="DownloadAsync" />
                                        }
                                    </details>
                                }
                            </section>
                        }
                    }
                    else
                    {
                        <div class="empty-state">

                            <div class="empty-icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6"/><path d="M9 17h4"/></svg></div>

                            <strong>No documents yet</strong>

                            <span>
                                Documents you upload, and ones your advisor shares with you, will appear here.
                            </span>

                        </div>
                    }

                </div>

            </article>

        </section>


        <aside class="side-column">

            <section class="side-card">

                <div class="side-card-header">
                    <h2>Send a document</h2>
                </div>

                <div class="side-card-body">

                    <p class="side-card-intro">
                        Your advisor may ask for things like a certified ID copy, proof of address,
                        payslips or bank statements. Upload them here and they'll be notified.
                    </p>

                    @if (!IsLoading && CurrentUser.Id is int clientId)
                    {
                        <RequestedDocuments ShowFeedback="false" @ref="RequestedList" ClientId="clientId" OnUploadRequested="BeginRequestUpload" OnLoaded="RequestsLoaded" />

                        <DocumentUploader @ref="Uploader" ClientId="clientId"
                                          Policies="Policies"
                                          OnUploaded="OnDocumentUploaded" />
                    }

                </div>

            </section>

        </aside>

    </main>

</div>

<RealtimeRefresh OnChanged="RefreshRealtimeAsync" />

@code {

    private List<DocumentSummary> Documents { get; set; } = new();
    private IEnumerable<IGrouping<(int? PolicyId, string DocumentType), DocumentSummary>> DocumentGroups => Documents
        .GroupBy(d => (d.PolicyId, d.DocumentType)).OrderByDescending(g => g.Max(d => d.DocumentId));

    private List<PolicySummary> Policies { get; set; } = new();

    private bool IsLoading { get; set; } = true;

    private string? ErrorMessage { get; set; }

    private string? DownloadError { get; set; }

    // The checklist of documents the advisor asked for.
    private RequestedDocuments? RequestedList;
    private DocumentUploader? Uploader;
    private List<DocumentRequestSummary>? ClientRequests;
    private void RequestsLoaded(List<DocumentRequestSummary> requests) => ClientRequests = requests;
    private bool ReplacementPending(DocumentSummary document)
    {
        if (document.ReviewStatus != "NeedsReplacement") return false;
        if (ClientRequests is null) return true;
        var scoped = ClientRequests.Where(r => r.PolicyId == document.PolicyId && r.DocumentType == document.DocumentType).ToList();
        if (scoped.Count > 0) return scoped.Any(r => !r.IsFulfilled);
        return !Documents.Any(d => d.DocumentId > document.DocumentId && d.PolicyId == document.PolicyId
            && d.DocumentType == document.DocumentType && d.ReviewStatus != "NeedsReplacement");
    }
    private async Task BeginReplacement(DocumentSummary document) { if (Uploader is not null) await Uploader.PrepareAsync(document.PolicyId, document.DocumentType, document.ReviewNote, true); }
    private async Task BeginRequestUpload(DocumentRequestSummary request) { if (Uploader is not null) await Uploader.PrepareAsync(request.PolicyId, request.DocumentType, request.ReviewNote, request.ReviewStatus == "NeedsReplacement"); }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CurrentUser.EnsureRestoredAsync();

            if (CurrentUser.Id is not int clientId)
            {
                ErrorMessage = "You need to be signed in to view your documents.";
                return;
            }

            // The API only returns the documents this client is allowed to see.
            var (documents, documentError) = await DocumentDirectory.GetForClientAsync(clientId);

            if (documentError is not null || documents is null)
            {
                ErrorMessage = documentError ?? "Your documents couldn't be loaded.";
            }
            else
            {
                Documents = documents
                    .OrderByDescending(d => d.UpdateAt ?? DateTime.MinValue)
                    .ToList();
            }

            // Needed by the uploader so each document can be filed under a policy.
            var (policies, policyError) = await PolicyDirectory.GetForClientAsync(clientId);
            if (policyError is null)
            {
                Policies = policies;
            }
        }
        finally
        {
            IsLoading = false;
        }
    }

    // Show a freshly uploaded document at the top of the list straight away.
    private async Task OnDocumentUploaded(DocumentSummary document)
    {
        Documents.RemoveAll(d => d.DocumentId == document.DocumentId);
        Documents.Insert(0, document);

        // The upload may have fulfilled something the advisor asked for, so refresh the checklist.
        if (RequestedList is not null)
        {
            await RequestedList.RefreshAsync();
        }
    }

    private async Task RefreshRealtimeAsync()
    {
        ErrorMessage = null;
        await OnInitializedAsync();
        if (RequestedList is not null) await RequestedList.RefreshAsync();
    }

    private async Task DownloadAsync(int documentId)
    {
        DownloadError = null;

        var (url, error) = await DocumentDirectory.GetDownloadUrlAsync(documentId);

        if (!string.IsNullOrWhiteSpace(error) || string.IsNullOrWhiteSpace(url))
        {
            DownloadError = error ?? "That document couldn't be downloaded. Please try again.";
            return;
        }

        Navigation.NavigateTo(url, forceLoad: true);
    }

    // "ProofOfAddress" -> "Proof of address"
    private static string FormatType(string? type)
    {
        if (string.IsNullOrWhiteSpace(type))
        {
            return "Document";
        }

        if (type == "CertifiedIdCopy")
        {
            return "Certified ID copy";
        }

        var spaced = System.Text.RegularExpressions.Regex.Replace(type, "(?<!^)([A-Z])", " $1").ToLowerInvariant();
        return char.ToUpperInvariant(spaced[0]) + spaced[1..];
    }
}

