@page "/"
@layout EmptyLayout
@rendermode InteractiveServer
@using frontend.Services
@using Microsoft.AspNetCore.Components
@inject AuthService Auth
@inject CurrentUserService CurrentUser
@inject NavigationManager Navigation

<PageTitle>Login | Nexus</PageTitle>

<ErrorBoundary>
<ChildContent>
<div class="login-page">

    <!-- LEFT SIDE -->
    <section class="login-brand-panel">

        <div class="brand-logo">
            <div class="brand-icon">N</div>
            <span>NEXUS</span>
        </div>

        <div class="brand-content">
            <h1>
                One place for your<br />
                policies, paperwork and<br />
                <em>adviser.</em>
            </h1>

            <p class="brand-description">
                Track every case from intake to issue, sign documents digitally,
                and get answers the moment you need them.
            </p>

            <div class="brand-features">

                <div class="feature-item">
                    <span class="feature-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 19V11"/><path d="M12 19V5"/><path d="M18 19v-5"/><path d="M3 21h18"/></svg></span>
                    <span>Live case status across Liberty &amp; Standard Bank</span>
                </div>

                <div class="feature-item">
                    <span class="feature-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="m9 14 2 2 4-4"/></svg></span>
                    <span>Pre-populated, e-signable documents</span>
                </div>

                <div class="feature-item">
                    <span class="feature-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/><path d="M9 11.5h6"/><path d="M9 14.5h3"/></svg></span>
                    <span>AI assistant with adviser handoff</span>
                </div>

            </div>
        </div>

        <div class="brand-footer">
            FSP-compliant · POPIA-aligned · Audit logged
        </div>

    </section>


    <!-- RIGHT SIDE -->
    <section class="login-form-panel">

        <div class="login-card">

            <div class="login-heading">
                <span class="auth-eyebrow">Secure sign in</span>
                <h2>Welcome back</h2>
                <p>Sign in to your Nexus account.</p>
            </div>

            <EditForm Model="LoginModel" OnValidSubmit="HandleLogin" novalidate>
            <DataAnnotationsValidator />

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <p class="login-error" role="alert">@ErrorMessage</p>
            }

            <div class="form-group">
                <label for="email">Email address</label>

                <div class="input-with-icon">
                    <span class="input-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="4"/><path d="m4 8 8 5.5L20 8"/></svg></span>
                    <InputText id="email"
                               type="email"
                               placeholder="you@example.co.za"
                               autocomplete="email"
                               @bind-Value="LoginModel.Email" />
                </div>

                <ValidationMessage For="() => LoginModel.Email" />
            </div>

            <div class="form-group">
                <label for="password">Password</label>

                <div class="password-input-wrapper input-with-icon">
                    <span class="input-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="9" rx="3"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg></span>
                    <InputText id="password"
                               type="@(ShowPassword ? "text" : "password")"
                               placeholder="••••••••"
                               autocomplete="current-password"
                               @bind-Value="LoginModel.Password" />

                    <button type="button"
                            class="password-toggle-button"
                            aria-label="@(ShowPassword ? "Hide password" : "Show password")"
                            @onclick="() => ShowPassword = !ShowPassword">
                        @((MarkupString)(ShowPassword ? EyeOffIcon : EyeIcon))
                    </button>
                </div>

                <ValidationMessage For="() => LoginModel.Password" />
            </div>

            <div class="form-options">

                <label class="remember-me">
                    <InputCheckbox @bind-Value="LoginModel.RememberMe" />
                    <span>Keep me signed in</span>
                </label>

                <button type="button" class="forgot-password" @onclick="GoToForgotPassword">
                    Forgot password?
                </button>

            </div>

            <button type="submit" class="sign-in-button" disabled="@IsBusy">
                <span>@(IsBusy ? "Signing in..." : "Sign in")</span>
                @if (!IsBusy)
                {
                    <span class="arrow"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg></span>
                }
            </button>
            </EditForm>

            <div class="register-section">
                <span class="auth-divider">New client?</span>
                <p class="invite-note">Your adviser sets up your account. Look for their invitation email, or ask them to send you a new one.</p>
            </div>

        </div>

    </section>

</div>
</ChildContent>
<ErrorContent>
    <div class="login-page">
        <p class="login-error">Something went wrong loading this page. Please refresh and try again.</p>
    </div>
</ErrorContent>
</ErrorBoundary>

@code {
    private const string EyeIcon = "<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg>";
    private const string EyeOffIcon = "<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-7-11-7a21.3 21.3 0 0 1 5.06-5.94M9.9 4.24A10.4 10.4 0 0 1 12 4c7 0 11 7 11 7a21.3 21.3 0 0 1-3.22 4.36M14.12 14.12a3 3 0 1 1-4.24-4.24\"/><line x1=\"1\" y1=\"1\" x2=\"23\" y2=\"23\"/></svg>";

    /// <summary>
    /// What the user typed. The rules (required, valid email) live on LoginForm.
    /// </summary>
    private readonly LoginForm LoginModel = new();
    private bool ShowPassword;
    private bool IsBusy;
    private string? ErrorMessage;

    /// <summary>
    /// If the user ticked "Keep me signed in" before, skip the login page and go straight in.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await CurrentUser.EnsureRestoredAsync();

        if (CurrentUser.IsAdvisor)
        {
            Navigation.NavigateTo("/advisor");
        }
        else if (CurrentUser.IsClient)
        {
            Navigation.NavigateTo("/client");
        }
    }

    private void GoToForgotPassword()
    {
        Navigation.NavigateTo("/forgot-password");
    }

    /// <summary>
    /// Runs only when every field passes its rules (EditForm OnValidSubmit).
    /// </summary>
    private async Task HandleLogin()
    {
        ErrorMessage = null;
        IsBusy = true;

        var result = await Auth.LoginAsync(LoginModel.Email.Trim(), LoginModel.Password, LoginModel.RememberMe);

        IsBusy = false;

        if (!result.Success)
        {
            ErrorMessage = result.Message;
            return;
        }

        await CurrentUser.SignInAsync(result, LoginModel.RememberMe);

        if (result.Role == "Advisor")
        {
            Navigation.NavigateTo("/advisor");
        }
        else if (result.Role == "Client")
        {
            Navigation.NavigateTo("/client");
        }
        else
        {
            ErrorMessage = $"Unknown user role: {result.Role}";
        }
    }
}

@* //-----------------------------------------------------------------------------0o0o0o End of File 0o0o0o0o0o-------------------------------------------------------------------------------------------------// *@
