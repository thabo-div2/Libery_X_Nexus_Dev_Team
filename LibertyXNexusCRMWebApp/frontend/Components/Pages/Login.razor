@page "/"
@layout EmptyLayout
@rendermode InteractiveServer
@using frontend.Services
@using Microsoft.AspNetCore.Components
@inject AuthService Auth
@inject CurrentUserService CurrentUser
@inject NavigationManager Navigation

<PageTitle>Login | Nexus</PageTitle>

<ErrorBoundary>
<ChildContent>
<div class="login-page">

    <!-- LEFT SIDE -->
    <section class="login-brand-panel">

        <div class="brand-logo">
            <div class="brand-icon">N</div>
            <span>NEXUS</span>
        </div>

        <div class="brand-content``">
            <h1>
                One place for your<br />
                policies, paperwork and<br />
                adviser.
            </h1>

            <p class="brand-description">
                Track every case from intake to issue, sign documents digitally,
                and get answers the moment you need them.
            </p>

            <div class="brand-features">

                <div class="feature-item">
                    <span class="feature-icon">▢</span>
                    <span>Live case status across Liberty &amp; Standard Bank</span>
                </div>

                <div class="feature-item">
                    <span class="feature-icon">▣</span>
                    <span>Pre-populated, e-signable documents</span>
                </div>

                <div class="feature-item">
                    <span class="feature-icon">◇</span>
                    <span>AI assistant with adviser handoff</span>
                </div>

            </div>
        </div>

        <div class="brand-footer">
            FSP-compliant · POPIA-aligned · Audit logged
        </div>

    </section>


    <!-- RIGHT SIDE -->
    <section class="login-form-panel">

        <div class="login-card">

            <div class="login-heading">
                <h2>Welcome back</h2>
                <p>Sign in to your Nexus account.</p>
            </div>

            <EditForm Model="LoginModel" OnValidSubmit="HandleLogin" novalidate>
            <DataAnnotationsValidator />

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <p class="login-error" role="alert">@ErrorMessage</p>
            }

            <div class="form-group">
                <label for="email">Email address</label>

                <InputText id="email"
                           type="email"
                           placeholder="you@example.co.za"
                           autocomplete="email"
                           @bind-Value="LoginModel.Email" />

                <ValidationMessage For="() => LoginModel.Email" />
            </div>

            <div class="form-group">
                <label for="password">Password</label>

                <div class="password-input-wrapper">
                    <InputText id="password"
                               type="@(ShowPassword ? "text" : "password")"
                               placeholder="••••••••"
                               autocomplete="current-password"
                               @bind-Value="LoginModel.Password" />

                    <button type="button"
                            class="password-toggle-button"
                            aria-label="@(ShowPassword ? "Hide password" : "Show password")"
                            @onclick="() => ShowPassword = !ShowPassword">
                        @((MarkupString)(ShowPassword ? EyeOffIcon : EyeIcon))
                    </button>
                </div>

                <ValidationMessage For="() => LoginModel.Password" />
            </div>

            <div class="form-options">

                <label class="remember-me">
                    <input type="checkbox" />
                    <span>Keep me signed in</span>
                </label>

                <button type="button" class="forgot-password" @onclick="GoToForgotPassword">
                    Forgot password?
                </button>

            </div>

            <button type="submit" class="sign-in-button" disabled="@IsBusy">
                <span>@(IsBusy ? "Signing in..." : "Sign in")</span>
                @if (!IsBusy)
                {
                    <span class="arrow">→</span>
                }
            </button>
            </EditForm>

            <a href="/client" class="client-button">
                Continue as client
            </a>

            <div class="register-section">
                <span>New here?</span>
                <a href="/register">Create an account</a>
            </div>

        </div>

    </section>

</div>
</ChildContent>
<ErrorContent>
    <div class="login-page">
        <p class="login-error">Something went wrong loading this page. Please refresh and try again.</p>
    </div>
</ErrorContent>
</ErrorBoundary>

@code {
    private const string EyeIcon = "<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg>";
    private const string EyeOffIcon = "<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-7-11-7a21.3 21.3 0 0 1 5.06-5.94M9.9 4.24A10.4 10.4 0 0 1 12 4c7 0 11 7 11 7a21.3 21.3 0 0 1-3.22 4.36M14.12 14.12a3 3 0 1 1-4.24-4.24\"/><line x1=\"1\" y1=\"1\" x2=\"23\" y2=\"23\"/></svg>";

    /// <summary>
    /// What the user typed. The rules (required, valid email) live on LoginForm.
    /// </summary>
    private readonly LoginForm LoginModel = new();
    private bool ShowPassword;
    private bool IsBusy;
    private string? ErrorMessage;

    private void GoToForgotPassword()
    {
        Navigation.NavigateTo("/forgot-password");
    }

    /// <summary>
    /// Runs only when every field passes its rules (EditForm OnValidSubmit).
    /// </summary>
    private async Task HandleLogin()
    {
        ErrorMessage = null;
        IsBusy = true;

        var result = await Auth.LoginAsync(LoginModel.Email.Trim(), LoginModel.Password);

        IsBusy = false;

        if (!result.Success)
        {
            ErrorMessage = result.Message;
            return;
        }

        await CurrentUser.SignInAsync(result);
        if (result.Role == "Advisor")
        {
            Navigation.NavigateTo("/advisor");
        }
        else if (result.Role == "Client")
        {
            Navigation.NavigateTo("/client");
        }
        else
        {
            ErrorMessage = $"Unknown user role: {result.Role}";
        }
    }
}

@* //-----------------------------------------------------------------------------0o0o0o End of File 0o0o0o0o0o-------------------------------------------------------------------------------------------------// *@
