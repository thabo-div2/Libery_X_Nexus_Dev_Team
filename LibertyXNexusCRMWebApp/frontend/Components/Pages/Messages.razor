@page "/messages"
@layout MainLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable
@using frontend.Services
@inject MessageService MessageStore
@inject MeetingService MeetingStore
@inject CurrentUserService CurrentUser
@inject MessageNotifier Notifier
@inject NotificationService Notifications

<PageTitle>Messages | Nexus</PageTitle>

<ErrorBoundary>
<ChildContent>
<div class="messages-page">

    <header class="messages-header">

        <div class="messages-heading">
            <h1>Messages &amp; notifications</h1>

            <p>
                @if (UnreadMessageCount.HasValue || SystemAlertCount.HasValue)
                {
                    <span>
                        @(UnreadMessageCount ?? 0) unread client messages ·
                        @(SystemAlertCount ?? 0) system alerts
                    </span>
                }
                else
                {
                    <span>Client conversations and system notifications</span>
                }
            </p>
        </div>

        <div class="header-actions">

            <div class="search-box">
                <span class="search-icon">⌕</span>

                <input type="text"
                       placeholder="Search clients, cases, documents" />
            </div>

           <NotificationBell />

        </div>

    </header>


    @if (!string.IsNullOrEmpty(LoadError))
    {
        <p class="messages-error">@LoadError</p>
    }

    <main class="messages-content">

        <section class="conversation-panel">

            <div class="panel-heading">
                <h2>Conversations</h2>
            </div>

            <div class="conversation-list">

                @if (ConversationThreads.Count > 0)
                {
                    @foreach (var conversation in ConversationThreads)
                    {
                        <button type="button"
                                class="conversation-item @(conversation.Id == SelectedConversationId ? "selected" : "")"
                                @onclick="() => SelectConversationAsync(conversation.Id)">

                            <div class="conversation-top">

                                <strong>
                                    @conversation.ClientName
                                </strong>

                                <span class="conversation-time">
                                    @conversation.TimeText
                                </span>

                            </div>

                            <div class="conversation-bottom">

                                <span class="conversation-preview">
                                    @conversation.Preview
                                </span>

                                @if (conversation.UnreadCount > 0)
                                {
                                    <span class="unread-badge">
                                        @conversation.UnreadCount
                                    </span>
                                }

                            </div>

                        </button>
                    }
                }
                else
                {
                    <div class="conversation-empty">
                        <span>No conversations yet</span>
                    </div>
                }

            </div>

        </section>


        <section class="chat-panel">

            <div class="chat-header">

                <div class="chat-client">

                    <h2>
                        @(string.IsNullOrWhiteSpace(SelectedClientName)
                            ? "Select a conversation"
                            : SelectedClientName)
                    </h2>

                </div>

                @if (!string.IsNullOrWhiteSpace(SelectedCaseStatus))
                {
                    <span class="case-status">
                        <span class="status-dot"></span>
                        @SelectedCaseStatus
                    </span>
                }

                <button type="button" class="meeting-toggle-button" @onclick="ToggleMeetingForm" disabled="@(SelectedConversationId is null)">
                    <span>♙</span>
                    Book meeting
                </button>

            </div>

            @if (ShowMeetingForm)
            {
                <div class="meeting-request-form">
                    <label>
                        Date &amp; time
                        <input type="datetime-local" @bind="MeetingDateTimeInput" />
                    </label>

                    <label>
                        Notes (optional)
                        <input type="text" @bind="MeetingNotes" placeholder="What's this meeting about?" />
                    </label>

                    <div class="meeting-form-actions">
                        <button type="button" class="meeting-cancel-button" @onclick="ToggleMeetingForm">Cancel</button>
                        <button type="button" class="meeting-send-button" @onclick="SendMeetingRequest">Schedule meeting</button>
                    </div>

                    @if (!string.IsNullOrEmpty(MeetingFormError))
                    {
                        <p class="messages-error">@MeetingFormError</p>
                    }
                </div>
            }


            <div class="chat-body">

                @if (Timeline.Count > 0)
                {
                    @foreach (var item in Timeline)
                    {
                        @if (item.Meeting is not null)
                        {
                            <div class="meeting-card @GetMeetingStatusClass(item.Meeting.Status)">

                                <strong>Meeting request</strong>
                                <span>@item.Meeting.MeetingDate.ToLocalTime().ToString("d MMM yyyy, HH:mm")</span>

                                @if (!string.IsNullOrWhiteSpace(item.Meeting.Notes))
                                {
                                    <span class="meeting-card-notes">@item.Meeting.Notes</span>
                                }

                                @if (string.Equals(item.Meeting.Status, "Requested", StringComparison.OrdinalIgnoreCase))
                                {
                                    <div class="meeting-response-actions">
                                        <button type="button" class="meeting-accept-button" @onclick="() => AcceptMeeting(item.Meeting.MeetingId)">Accept</button>
                                        <button type="button" class="meeting-deny-button" @onclick="() => DenyMeeting(item.Meeting.MeetingId)">Deny</button>
                                    </div>
                                }
                                else
                                {
                                    <span class="meeting-status-label">@GetMeetingStatusText(item.Meeting.Status)</span>
                                }

                            </div>
                        }
                        else if (item.Message is not null)
                        {
                            <div class="message-row @(item.Message.IsAdvisor ? "advisor-message-row" : "client-message-row")">

                                <div class="message-bubble @(item.Message.IsAdvisor ? "advisor-message" : "client-message")">

                                    <span class="message-text">
                                        @item.Message.Text
                                    </span>

                                </div>

                                @if (!string.IsNullOrWhiteSpace(item.Message.TimeText))
                                {
                                    <span class="message-time">
                                        @item.Message.TimeText
                                    </span>
                                }

                            </div>
                        }
                    }
                }
                else
                {
                    <div class="chat-empty-state">

                        <div class="empty-chat-icon">✉</div>

                        <strong>No conversation selected</strong>

                        <span>
                            Choose a client conversation to view messages.
                        </span>

                    </div>
                }

            </div>


            <div class="reply-area">

                <input type="text"
                       @bind="ReplyText"
                       @bind:event="oninput"
                       @onkeydown="HandleReplyKeyDown"
                       placeholder="Write a reply..."
                       disabled="@string.IsNullOrWhiteSpace(SelectedClientName)" />

                <button type="button"
                        class="send-button"
                        disabled="@string.IsNullOrWhiteSpace(SelectedClientName)"
                        aria-label="Send message"
                        @onclick="SendReply">

                    ➤

                </button>

            </div>

            @if (!string.IsNullOrEmpty(SendError))
            {
                <p class="messages-error">@SendError</p>
            }

        </section>


        <aside class="notifications-panel">

            <div class="panel-heading">
                <h2>Notifications</h2>
            </div>

            <div class="notification-list">

                @if (NotificationItems.Count > 0)
                {
                    @foreach (var notification in NotificationItems)
                    {
                        <div class="system-notification">

                            <div class="notification-type-icon @GetNotificationIconClass(notification.Type)">
                                @GetNotificationIcon(notification.Type)
                            </div>

                            <div class="notification-details">

                                <strong>
                                    @notification.Title
                                </strong>

                                @if (!string.IsNullOrWhiteSpace(notification.TimeText))
                                {
                                    <span>
                                        @notification.TimeText
                                    </span>
                                }

                            </div>

                        </div>
                    }
                }
                else
                {
                    <div class="notifications-empty">
                        <span>No new notifications</span>
                    </div>
                }

            </div>

        </aside>

    </main>

</div>
</ChildContent>
<ErrorContent>
    <div class="messages-page">
        <p class="messages-error">Something went wrong loading this page. Please refresh and try again.</p>
    </div>
</ErrorContent>
</ErrorBoundary>


@code {

    private int? UnreadMessageCount;
    private int? SystemAlertCount;

    private int? SelectedConversationId;

    private string? SelectedClientName;
    private string? SelectedCaseStatus;

    private string ReplyText { get; set; } = string.Empty;

    private List<ConversationThread> ConversationThreads { get; set; } = new();

    private List<ChatMessageItem> ChatMessages { get; set; } = new();

    private List<MeetingSummary> Meetings { get; set; } = new();

    private List<TimelineEntry> Timeline { get; set; } = new();

    private bool ShowMeetingForm;
    private DateTime? MeetingDateTimeInput;
    private string MeetingNotes = string.Empty;
    private string? MeetingFormError;

    private List<NotificationItem> NotificationItems { get; set; } = new();


    private const int DefaultAdvisorId = 1;
    private int AdvisorId => CurrentUser.Id ?? DefaultAdvisorId;

    private string? LoadError;
    private string? SendError;

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.EnsureRestoredAsync();

        await LoadConversations();
        await LoadNotificationsAsync();

        Notifier.MessageSent += OnMessageSent;
    }

    private async Task LoadNotificationsAsync()
    {
        if (CurrentUser.Id is not int advisorId)
        {
            return;
        }

        var feed = await Notifications.GetFeedForAdvisorAsync(advisorId);

        NotificationItems = feed.Items.Select(i => new NotificationItem
            {
                Title = i.Message,
                TimeText = i.IsReminder? "Reminder": i.CreatedAt.ToLocalTime().ToString("d MMM, HH:mm"),
                Type = i.Type
            }).ToList();       
    }

    private void OnMessageSent(int clientId)
    {
        _ = InvokeAsync(async () =>
        {
            await LoadConversations();

            if (SelectedConversationId is not null && SelectedConversationId.Value == clientId)
            {
                await SelectConversationAsync(clientId);
            }

            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Notifier.MessageSent -= OnMessageSent;
    }

    private async Task LoadConversations()
    {
        var (conversations, error) = await MessageStore.GetConversationsForAdvisorAsync(AdvisorId);
        LoadError = error;

        ConversationThreads = conversations.Select(c => new ConversationThread
        {
            Id = c.ClientId,
            ClientName = c.ClientName,
            Preview = c.LastMessage ?? "No messages yet",
            TimeText = c.LastMessageAt.HasValue ? c.LastMessageAt.Value.ToLocalTime().ToString("d MMM, HH:mm") : string.Empty,
            CaseStatus = string.Empty,
            UnreadCount = 0
        }).ToList();
    }

    private async Task SelectConversationAsync(int conversationId)
    {
        var isDifferentConversation = SelectedConversationId != conversationId;
        SelectedConversationId = conversationId;

        if (isDifferentConversation)
        {
            ShowMeetingForm = false;
            MeetingDateTimeInput = null;
            MeetingNotes = string.Empty;
            MeetingFormError = null;
        }

        var selectedConversation =
            ConversationThreads.FirstOrDefault(x => x.Id == conversationId);

        if (selectedConversation is null)
        {
            return;
        }

        SelectedClientName = selectedConversation.ClientName;
        SelectedCaseStatus = selectedConversation.CaseStatus;

        var (messages, messageError) = await MessageStore.GetConversationAsync(conversationId);

        ChatMessages = messages.Select(m => new ChatMessageItem
        {
            Text = m.Text,
            TimeText = m.SentAt.ToLocalTime().ToString("d MMM, HH:mm"),
            SentAt = m.SentAt,
            IsAdvisor = m.FromAdvisor
        }).ToList();

        var (meetings, meetingError) = await MeetingStore.GetForClientAsync(conversationId);
        Meetings = meetings;

        LoadError = messageError ?? meetingError;
        BuildTimeline();
    }

    private void BuildTimeline()
    {
        var items = new List<TimelineEntry>();

        items.AddRange(ChatMessages.Select(m => new TimelineEntry { Timestamp = m.SentAt, Message = m }));
        items.AddRange(Meetings.Select(m => new TimelineEntry { Timestamp = m.CreatedAt, Meeting = m }));

        Timeline = items.OrderBy(i => i.Timestamp).ToList();
    }

    private async Task AcceptMeeting(int meetingId)
    {
        await RespondToMeeting(meetingId, accept: true);
    }

    private async Task DenyMeeting(int meetingId)
    {
        await RespondToMeeting(meetingId, accept: false);
    }

    private async Task RespondToMeeting(int meetingId, bool accept)
    {
        if (SelectedConversationId is null)
        {
            return;
        }

        var error = await MeetingStore.RespondAsync(meetingId, SelectedConversationId.Value, accept);
        if (error is not null)
        {
            SendError = error;
            return;
        }

        await SelectConversationAsync(SelectedConversationId.Value);
        await LoadConversations();
    }

    private void ToggleMeetingForm()
    {
        ShowMeetingForm = !ShowMeetingForm;
        MeetingFormError = null;
    }

    private async Task SendMeetingRequest()
    {
        MeetingFormError = null;

        if (SelectedConversationId is null)
        {
            MeetingFormError = "Select a conversation first.";
            return;
        }

        if (MeetingDateTimeInput is null)
        {
            MeetingFormError = "Choose a date and time for the meeting.";
            return;
        }

        var meetingDateUtc = DateTime.SpecifyKind(MeetingDateTimeInput.Value, DateTimeKind.Local).ToUniversalTime();

        var error = await MeetingStore.RequestAsync(SelectedConversationId.Value, AdvisorId, fromAdvisor: true, meetingDateUtc, MeetingNotes);
        if (error is not null)
        {
            MeetingFormError = error;
            return;
        }

        MeetingDateTimeInput = null;
        MeetingNotes = string.Empty;
        ShowMeetingForm = false;

        await SelectConversationAsync(SelectedConversationId.Value);
        await LoadConversations();
    }

    private static string GetMeetingStatusClass(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "confirmed" => "meeting-confirmed",
            "cancelled" => "meeting-denied",
            _ => "meeting-pending"
        };
    }

    private static string GetMeetingStatusText(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "confirmed" => "Meeting confirmed",
            "cancelled" => "Meeting request denied",
            _ => "Waiting for your response"
        };
    }

    private async Task HandleReplyKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendReply();
        }
    }

    private async Task SendReply()
    {
        SendError = null;

        if (SelectedConversationId is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(ReplyText))
        {
            SendError = "Type a message before sending";
            return;
        }

        var error = await MessageStore.SendAsync(SelectedConversationId.Value, AdvisorId, fromAdvisor: true, ReplyText);
        if (error is not null)
        {
            SendError = error;
            return;
        }

        ReplyText = string.Empty;
        await SelectConversationAsync(SelectedConversationId.Value);
        await LoadConversations();
    }


    private static string GetNotificationIcon(string? type)
    {
        return type?.ToLowerInvariant() switch
        {
            "warning" => "△",
            "document" => "▤",
            "calendar" => "□",
            "success" => "✓",
            _ => "•"
        };
    }


    private static string GetNotificationIconClass(string? type)
    {
        return type?.ToLowerInvariant() switch
        {
            "warning" => "notification-warning",
            "document" => "notification-document",
            "calendar" => "notification-calendar",
            "success" => "notification-success",
            _ => "notification-neutral"
        };
    }


    public class ConversationThread
    {
        public int Id { get; set; }

        public string ClientName { get; set; } = string.Empty;

        public string Preview { get; set; } = string.Empty;

        public string TimeText { get; set; } = string.Empty;

        public string CaseStatus { get; set; } = string.Empty;

        public int UnreadCount { get; set; }
    }


    public class ChatMessageItem
    {
        public string Text { get; set; } = string.Empty;

        public string TimeText { get; set; } = string.Empty;

        public DateTime SentAt { get; set; }

        public bool IsAdvisor { get; set; }
    }

    public class TimelineEntry
    {
        public DateTime Timestamp { get; set; }

        public ChatMessageItem? Message { get; set; }

        public MeetingSummary? Meeting { get; set; }
    }


    public class NotificationItem
    {
        public string Title { get; set; } = string.Empty;

        public string TimeText { get; set; } = string.Empty;

        public string Type { get; set; } = string.Empty;
    }
}