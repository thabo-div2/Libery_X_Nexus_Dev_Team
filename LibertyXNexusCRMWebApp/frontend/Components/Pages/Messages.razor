@page "/messages"
@layout MainLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable
@using frontend.Services
@inject MessageService MessageStore
@inject MeetingService MeetingStore
@inject CurrentUserService CurrentUser
@inject MessageNotifier Notifier
@inject CaseService Cases
@inject DocumentRequestService DocumentRequests
@inject IJSRuntime JS

<PageTitle>Messages | Nexus</PageTitle>

<ErrorBoundary>
<ChildContent>
<div class="messages-page">

    <header class="messages-header">

        <div class="messages-heading">
            <h1>Messages</h1>
            <p>@(UnreadMessageCount is > 0 ? $"{UnreadMessageCount} unread {(UnreadMessageCount == 1 ? "message" : "messages")} from clients" : "Client conversations, meeting requests and replies")</p>
        </div>

        <div class="header-actions">


           <NotificationBell />

        </div>

    </header>


    @if (!string.IsNullOrEmpty(LoadError))
    {
        <p class="messages-error">@LoadError</p>
    }

    <main class="messages-content">

        <section class="conversation-panel">

            <div class="panel-heading">
                <h2>Conversations</h2>
                <span class="panel-count">@ConversationThreads.Count</span>
            </div>

            <div class="conversation-tools">
                <label class="conversation-search">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                    <input type="search" placeholder="Search conversations" aria-label="Search conversations" @bind="ConversationSearch" @bind:event="oninput" />
                </label>
                <div class="conversation-filter" role="group" aria-label="Show conversations">
                    <button type="button" class="@(UnreadOnly ? "" : "is-active")" aria-pressed="@(!UnreadOnly)" @onclick="() => UnreadOnly = false">All</button>
                    <button type="button" class="@(UnreadOnly ? "is-active" : "")" aria-pressed="@UnreadOnly" @onclick="() => UnreadOnly = true">Unread @if (UnreadMessageCount is > 0) { <span>@UnreadMessageCount</span> }</button>
                </div>
            </div>

            <div class="conversation-list">

                @if (VisibleThreads.Count > 0)
                {
                    @foreach (var conversation in VisibleThreads)
                    {
                        <button type="button"
                                class="conversation-item @(conversation.Id == SelectedConversationId ? "selected" : "")"
                                @onclick="() => SelectConversationAsync(conversation.Id)">

                            <span class="conversation-avatar" aria-hidden="true">@GetInitials(conversation.ClientName)</span>

                            <div class="conversation-main">

                            <div class="conversation-top">

                                <strong>
                                    @conversation.ClientName
                                </strong>

                                <span class="conversation-time">
                                    @conversation.TimeText
                                </span>

                            </div>

                            <div class="conversation-bottom">

                                <span class="conversation-preview">
                                    @conversation.Preview
                                </span>

                                @if (conversation.UnreadCount > 0)
                                {
                                    <span class="unread-badge">
                                        @conversation.UnreadCount
                                    </span>
                                }

                            </div>

                            </div>

                        </button>
                    }
                }
                else if (ConversationThreads.Count > 0)
                {
                    <div class="conversation-empty">
                        <span>@(UnreadOnly ? "You are all caught up. No unread messages." : $"No conversations match “{ConversationSearch}”.")</span>
                    </div>
                }
                else if (!string.IsNullOrEmpty(LoadError))
                {
                    <div class="conversation-empty" role="alert">
                        <span>Conversations couldn't be loaded. Please try again.</span>
                        <button type="button" @onclick="LoadConversations">Retry</button>
                    </div>
                }
                else
                {
                    <div class="conversation-empty">
                        <span>No clients assigned yet. Add a client to start a conversation.</span>
                    </div>
                }

            </div>

        </section>


        <section class="chat-panel">

            <div class="chat-header">

                <div class="chat-client">

                    @if (!string.IsNullOrWhiteSpace(SelectedClientName))
                    {
                        <span class="chat-avatar" aria-hidden="true">@GetInitials(SelectedClientName)</span>
                    }

                    <h2>
                        @(string.IsNullOrWhiteSpace(SelectedClientName)
                            ? "Select a conversation"
                            : SelectedClientName)
                    </h2>

                </div>

                @if (!string.IsNullOrWhiteSpace(SelectedCaseStatus))
                {
                    <span class="case-status">
                        <span class="status-dot"></span>
                        @SelectedCaseStatus
                    </span>
                }

                <button type="button" class="meeting-toggle-button" @ref="MeetingToggleButton" aria-expanded="@(ShowMeetingForm ? "true" : "false")" @onclick="ToggleMeetingForm" disabled="@(SelectedConversationId is null)">
                    <span class="meeting-toggle-icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="4"/><path d="M8 3v4M16 3v4M3 10h18"/></svg></span>
                    Book meeting
                </button>

            </div>

            @if (ShowMeetingForm)
            {
                <div class="meeting-request-form" role="region" aria-label="Book a meeting" @onkeydown="HandleMeetingFormKeyDown">
                    <EditForm Model="MeetingModel" OnValidSubmit="SendMeetingRequest" novalidate>
                        <DataAnnotationsValidator />

                        <label>
                            Date &amp; time
                            <InputDate Type="InputDateType.DateTimeLocal" min="@MinMeetingTime" @bind-Value="MeetingModel.MeetingDateTime" />
                        </label>
                        <ValidationMessage For="() => MeetingModel.MeetingDateTime" />

                        <label>
                            Notes (optional)
                            <InputText @bind-Value="MeetingModel.Notes" placeholder="What's this meeting about?" />
                        </label>
                        <ValidationMessage For="() => MeetingModel.Notes" />

                        <div class="meeting-form-actions">
                            <button type="button" class="meeting-cancel-button" @onclick="ToggleMeetingForm">Cancel</button>
                            <button type="submit" class="meeting-send-button" disabled="@IsSendingMeeting">@(IsSendingMeeting ? "Sending…" : "Schedule meeting")</button>
                        </div>

                        @if (!string.IsNullOrEmpty(MeetingFormError))
                        {
                            <p class="messages-error">@MeetingFormError</p>
                        }
                    </EditForm>
                </div>
            }


            <div class="chat-body" @ref="ChatBodyRef">

                @if (HasEarlierMessages)
                {
                    <button type="button" class="chat-earlier" @onclick="ShowEarlierMessages">Show earlier messages</button>
                }

                @if (Timeline.Count > 0)
                {
                    DateTime? lastDay = null;
                    @foreach (var item in Timeline)
                    {
                        var day = item.Timestamp.ToLocalTime().Date;
                        @if (day != lastDay)
                        {
                            lastDay = day;
                            <div class="chat-day" role="separator"><span>@DayLabel(day)</span></div>
                        }

                        @if (item.Meeting is not null)
                        {
                            <div class="meeting-card @GetMeetingStatusClass(item.Meeting.Status)">

                                <strong>Meeting request</strong>
                                <span>@item.Meeting.MeetingDate.ToLocalTime().ToString("d MMM yyyy, HH:mm")</span>

                                @if (!string.IsNullOrWhiteSpace(item.Meeting.Notes))
                                {
                                    <span class="meeting-card-notes">@item.Meeting.Notes</span>
                                }

                                @if (string.Equals(item.Meeting.Status, "Requested", StringComparison.OrdinalIgnoreCase))
                                {
                                    <div class="meeting-response-actions">
                                        <button type="button" class="meeting-accept-button" @onclick="() => AcceptMeeting(item.Meeting.MeetingId)">Accept</button>
                                        <button type="button" class="meeting-deny-button" @onclick="() => DenyMeeting(item.Meeting.MeetingId)">Deny</button>
                                    </div>
                                }
                                else
                                {
                                    <span class="meeting-status-label">@GetMeetingStatusText(item.Meeting.Status)</span>
                                }

                            </div>
                        }
                        else if (item.Message is not null)
                        {
                            <div class="message-row @(item.Message.IsAdvisor ? "advisor-message-row" : "client-message-row")">

                                <div class="message-bubble @(item.Message.IsAdvisor ? "advisor-message" : "client-message")">

                                    <span class="message-text">
                                        @item.Message.Text
                                    </span>

                                </div>

                                @if (!string.IsNullOrWhiteSpace(item.Message.TimeText))
                                {
                                    <span class="message-time">
                                        @item.Message.TimeText
                                    </span>
                                }

                            </div>
                        }
                    }
                }
                else
                {
                    <div class="chat-empty-state">

                        <div class="empty-chat-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="4"/><path d="m4 8 8 5.5L20 8"/></svg></div>

                        <strong>No conversation selected</strong>

                        <span>
                            Choose a client conversation to view messages.
                        </span>

                    </div>
                }

            </div>


            <div class="reply-area">

                <input type="text"
                       aria-label="Reply to client"
                       @bind="ReplyText"
                       @bind:event="oninput"
                       @onkeydown="HandleReplyKeyDown"
                       placeholder="Write a reply..."
                       disabled="@string.IsNullOrWhiteSpace(SelectedClientName)" />

                <button type="button"
                        class="send-button"
                        disabled="@string.IsNullOrWhiteSpace(SelectedClientName)"
                        aria-label="Send message"
                        @onclick="SendReply">

                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>

                </button>

            </div>

            @if (!string.IsNullOrEmpty(SendError))
            {
                <p class="messages-error">@SendError</p>
            }

        </section>


        <aside class="context-panel" aria-label="Client details">
            @if (SelectedConversationId is int contextClientId)
            {
                <div class="panel-heading"><h2>About @FirstName(SelectedClientName)</h2></div>
                <div class="context-body">
                    @if (ContextCase is not null)
                    {
                        var done = CaseStepDates(ContextCase).Count(d => d.HasValue);
                        <section class="context-block">
                            <span class="context-label">@(string.IsNullOrWhiteSpace(ContextCase.PolicyName) ? "Application" : ContextCase.PolicyName)</span>
                            <strong>@(done == CaseStepLabels.Length ? "Policy issued" : $"Step {done + 1} of {CaseStepLabels.Length} · {CaseStepLabels[done]}")</strong>
                            <span class="context-steps" role="progressbar" aria-label="Case progress" aria-valuemin="0" aria-valuemax="@CaseStepLabels.Length" aria-valuenow="@done">
                                @for (var i = 0; i < CaseStepLabels.Length; i++)
                                {
                                    <i class="@(i < done ? "is-done" : i == done ? "is-next" : "")"></i>
                                }
                            </span>
                        </section>
                    }

                    <section class="context-block">
                        <span class="context-label">Documents</span>
                        @if (ContextToReview + ContextOutstanding == 0)
                        {
                            <span class="context-muted">Nothing outstanding</span>
                        }
                        else
                        {
                            <div class="context-chips">
                                @if (ContextToReview > 0) { <a class="context-chip is-amber" href="/documents">@ContextToReview to review</a> }
                                @if (ContextOutstanding > 0) { <span class="context-chip">@ContextOutstanding requested</span> }
                            </div>
                        }
                    </section>

                    <section class="context-block">
                        <span class="context-label">Next meeting</span>
                        @if (NextMeeting is MeetingSummary next)
                        {
                            <strong>@next.MeetingDate.ToLocalTime().ToString("ddd d MMM, HH:mm")</strong>
                            <span class="context-muted">@(string.Equals(next.Status, "Confirmed", StringComparison.OrdinalIgnoreCase) ? "Confirmed" : "Waiting for a reply")</span>
                        }
                        else
                        {
                            <span class="context-muted">None booked</span>
                        }
                    </section>

                    <div class="context-actions">
                        <a class="context-action" href="@($"/meeting-prep?clientId={contextClientId}")">Meeting prep</a>
                        <a class="context-action" href="@($"/clients?search={Uri.EscapeDataString(SelectedClientName ?? "")}")">Open profile</a>
                    </div>
                </div>
            }
            else
            {
                <div class="context-empty"><span>Pick a conversation to see where the client stands.</span></div>
            }
        </aside>

    </main>

</div>
</ChildContent>
<ErrorContent>
    <div class="messages-page">
        <p class="messages-error">Something went wrong loading this page. Please refresh and try again.</p>
    </div>
</ErrorContent>
</ErrorBoundary>


<RealtimeRefresh OnChanged="RefreshRealtimeAsync" />

@code {

    private int? UnreadMessageCount;

    private int? SelectedConversationId;

    private string? SelectedClientName;
    private string? SelectedCaseStatus;

    private string ReplyText { get; set; } = string.Empty;

    private List<ConversationThread> ConversationThreads { get; set; } = new();

    private static string GetInitials(string? name)
    {
        var parts = (name ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        if (parts.Length == 0)
        {
            return "?";
        }

        return parts.Length == 1
            ? parts[0][..1].ToUpperInvariant()
            : $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    private List<ChatMessageItem> ChatMessages { get; set; } = new();

    private List<MeetingSummary> Meetings { get; set; } = new();

    private List<TimelineEntry> Timeline { get; set; } = new();

    private bool ShowMeetingForm;
    /// <summary>
    /// The meeting request form. Its rules (date required and in the future,
    /// notes under 500 characters) live on MeetingRequestForm.
    /// </summary>
    private MeetingRequestForm MeetingModel = new();

    /// <summary>
    /// Stops the date picker from showing times that have already passed.
    /// </summary>
    private string MinMeetingTime => DateTime.Now.ToString("yyyy-MM-ddTHH:mm", System.Globalization.CultureInfo.InvariantCulture);
    private string? MeetingFormError;



    private int AdvisorId => CurrentUser.Id!.Value;

    private string? LoadError;
    private string? SendError;

    private ElementReference ChatBodyRef;
    private string? LastScrollKey;

    /// <summary>
    /// Scrolls the chat to the bottom when it opens or a new message comes in.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Keyed on the newest item, so showing earlier messages doesn't jump to the bottom.
        var scrollKey = $"{SelectedConversationId}:{Timeline.LastOrDefault()?.Timestamp.Ticks}";

        if (Timeline.Count == 0 || scrollKey == LastScrollKey)
        {
            return;
        }

        LastScrollKey = scrollKey;

        try
        {
            await JS.InvokeVoidAsync("scrollToBottom", ChatBodyRef);
        }
        catch
        {
            // The page might be closing, so there's nothing to scroll.
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.EnsureRestoredAsync();

        await LoadConversations();
        Notifier.MessageSent += OnMessageSent;
    }

    private async Task RefreshRealtimeAsync()
    {
        await LoadConversations();
        if (SelectedConversationId is int id) await SelectConversationAsync(id);
    }

    private void OnMessageSent(int clientId)
    {
        _ = InvokeAsync(async () =>
        {
            await LoadConversations();

            if (SelectedConversationId is not null && SelectedConversationId.Value == clientId)
            {
                await SelectConversationAsync(clientId);
            }

            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Notifier.MessageSent -= OnMessageSent;
    }

    private async Task LoadConversations()
    {
        var (conversations, error) = await MessageStore.GetConversationsForAdvisorAsync(AdvisorId);
        LoadError = error;

        ConversationThreads = conversations.Select(c => new ConversationThread
        {
            Id = c.ClientId,
            ClientName = c.ClientName,
            Preview = c.LastMessage ?? "No messages yet",
            TimeText = c.LastMessageAt.HasValue ? c.LastMessageAt.Value.ToLocalTime().ToString("d MMM, HH:mm") : string.Empty,
            CaseStatus = string.Empty,
            UnreadCount = c.UnreadCount
        }).ToList();
        UnreadMessageCount = ConversationThreads.Sum(c => c.UnreadCount);
    }

    private async Task SelectConversationAsync(int conversationId)
    {
        var opened = ConversationThreads.FirstOrDefault(thread => thread.Id == conversationId);

        var isDifferentConversation = SelectedConversationId != conversationId;
        SelectedConversationId = conversationId;

        if (isDifferentConversation)
        {
            MessageWindow = MessagePageSize;
            ShowMeetingForm = false;
            MeetingModel = new();
            MeetingFormError = null;
        }

        var selectedConversation =
            ConversationThreads.FirstOrDefault(x => x.Id == conversationId);

        if (selectedConversation is null)
        {
            return;
        }

        SelectedClientName = selectedConversation.ClientName;
        SelectedCaseStatus = selectedConversation.CaseStatus;

        var (messages, hasEarlier, messageError) = await MessageStore.GetRecentConversationAsync(conversationId, MessageWindow);
        HasEarlierMessages = hasEarlier;
        if (messageError is null && opened is not null)
        {
            opened.UnreadCount = 0;
            UnreadMessageCount = ConversationThreads.Sum(c => c.UnreadCount);
        }

        ChatMessages = messages.Select(m => new ChatMessageItem
        {
            Text = m.Text,
            TimeText = m.SentAt.ToLocalTime().ToString("HH:mm"),
            SentAt = m.SentAt,
            IsAdvisor = m.FromAdvisor
        }).ToList();

        var (meetings, meetingError) = await MeetingStore.GetForClientAsync(conversationId);
        Meetings = meetings;

        LoadError = messageError ?? meetingError;
        BuildTimeline();
        await LoadContextAsync(conversationId);
    }

    private string ConversationSearch = string.Empty;
    private bool UnreadOnly;

    private List<ConversationThread> VisibleThreads => ConversationThreads
        .Where(c => !UnreadOnly || c.UnreadCount > 0)
        .Where(c => string.IsNullOrWhiteSpace(ConversationSearch)
            || c.ClientName.Contains(ConversationSearch.Trim(), StringComparison.OrdinalIgnoreCase)
            || c.Preview.Contains(ConversationSearch.Trim(), StringComparison.OrdinalIgnoreCase))
        .ToList();

    // Client context column: the open case, outstanding documents and the next meeting.
    private static readonly string[] CaseStepLabels = { "Details submitted", "Adviser review", "FICA verification", "Submitted to Liberty", "Policy issued" };
    private CaseSummary? ContextCase;
    private int ContextToReview;
    private int ContextOutstanding;

    private static DateTime?[] CaseStepDates(CaseSummary c) =>
        new[] { c.DetailsSubmittedAt, c.AdviserReviewAt, c.FicaVerifiedAt, c.SubmittedToLibertyAt, c.PolicyIssuedAt };

    private MeetingSummary? NextMeeting => Meetings
        .Where(m => m.MeetingDate > DateTime.UtcNow && !string.Equals(m.Status, "Cancelled", StringComparison.OrdinalIgnoreCase) && !string.Equals(m.Status, "Completed", StringComparison.OrdinalIgnoreCase))
        .OrderBy(m => m.MeetingDate)
        .FirstOrDefault();

    private async Task LoadContextAsync(int clientId)
    {
        var (cases, _) = await Cases.GetForClientAsync(clientId);
        var (requests, _) = await DocumentRequests.GetForClientAsync(clientId);

        // The user may have opened another conversation while this loaded.
        if (SelectedConversationId != clientId) return;

        // The case still in progress, else the most recent one.
        ContextCase = cases.OrderBy(c => c.PolicyIssuedAt.HasValue).ThenByDescending(c => c.CreatedAt).FirstOrDefault();
        requests ??= new();
        ContextToReview = requests.Count(r => r.IsFulfilled && r.ReviewStatus != "Accepted" && r.ReviewStatus != "NeedsReplacement");
        ContextOutstanding = requests.Count(r => !r.IsFulfilled || r.ReviewStatus == "NeedsReplacement");
    }

    private static string FirstName(string? name) => (name ?? "client").Split(" ", StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "client";

    private static string DayLabel(DateTime day) =>
        day == DateTime.Today ? "Today"
        : day == DateTime.Today.AddDays(-1) ? "Yesterday"
        : day.Year == DateTime.Today.Year ? day.ToString("dddd d MMMM") : day.ToString("d MMMM yyyy");

    // Long threads open on their newest messages; "Show earlier messages" widens the window.
    private const int MessagePageSize = 100;
    private int MessageWindow = MessagePageSize;
    private bool HasEarlierMessages;

    private async Task ShowEarlierMessages()
    {
        if (SelectedConversationId is not int id) return;
        MessageWindow += MessagePageSize;
        await SelectConversationAsync(id);
    }

    private void BuildTimeline()
    {
        var items = new List<TimelineEntry>();

        // While older messages are hidden, hide meeting cards from that older stretch too.
        var from = HasEarlierMessages && ChatMessages.Count > 0 ? ChatMessages.Min(m => m.SentAt) : DateTime.MinValue;
        items.AddRange(ChatMessages.Select(m => new TimelineEntry { Timestamp = m.SentAt, Message = m }));
        items.AddRange(Meetings.Where(m => m.CreatedAt >= from).Select(m => new TimelineEntry { Timestamp = m.CreatedAt, Meeting = m }));

        Timeline = items.OrderBy(i => i.Timestamp).ToList();
    }

    private async Task AcceptMeeting(int meetingId)
    {
        await RespondToMeeting(meetingId, accept: true);
    }

    private async Task DenyMeeting(int meetingId)
    {
        await RespondToMeeting(meetingId, accept: false);
    }

    private async Task RespondToMeeting(int meetingId, bool accept)
    {
        if (SelectedConversationId is null)
        {
            return;
        }

        var error = await MeetingStore.RespondAsync(meetingId, SelectedConversationId.Value, accept);
        if (error is not null)
        {
            SendError = error;
            return;
        }

        await SelectConversationAsync(SelectedConversationId.Value);
        await LoadConversations();
    }

    private void ToggleMeetingForm()
    {
        ShowMeetingForm = !ShowMeetingForm;
        MeetingFormError = null;
    }

    /// <summary>
    /// The Book meeting button, so focus can go back to it when the form closes.
    /// </summary>
    private ElementReference MeetingToggleButton;

    /// <summary>
    /// Escape inside the meeting form closes it and puts focus back on the Book meeting button,
    /// so keyboard users aren't left stranded when it disappears.
    /// </summary>
    private async Task HandleMeetingFormKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            ShowMeetingForm = false;
            MeetingFormError = null;
            // The element can be missing if the page changed in the meantime; closing still worked.
            try { await MeetingToggleButton.FocusAsync(); } catch (Exception) { }
        }
    }

    /// <summary>
    /// True while a meeting request is being sent, so a double-click can't send it twice.
    /// </summary>
    private bool IsSendingMeeting;

    /// <summary>
    /// Runs only when the form passes its rules. Reads the values from the form that was
    /// actually submitted (context.Model) and copies them first: after the first click
    /// succeeds the page swaps MeetingModel for a fresh empty one, and a second queued
    /// click used to read that empty model and crash with "Nullable object must have a value".
    /// </summary>
    private async Task SendMeetingRequest(EditContext context)
    {
        if (IsSendingMeeting || context.Model is not MeetingRequestForm submitted || submitted.MeetingDateTime is not DateTime meetingLocal)
        {
            return;
        }

        var notes = submitted.Notes;
        IsSendingMeeting = true;

        try
        {
            await SendMeetingRequestCore(submitted, meetingLocal, notes);
        }
        finally
        {
            IsSendingMeeting = false;
        }
    }

    private async Task SendMeetingRequestCore(MeetingRequestForm submitted, DateTime meetingLocal, string? notes)
    {
        MeetingFormError = null;

        if (SelectedConversationId is null)
        {
            MeetingFormError = "Select a conversation first.";
            return;
        }

        var meetingDateUtc = DateTime.SpecifyKind(meetingLocal, DateTimeKind.Local).ToUniversalTime();

        var error = await MeetingStore.RequestAsync(SelectedConversationId.Value, AdvisorId, fromAdvisor: true, meetingDateUtc, notes);
        if (error is not null)
        {
            MeetingFormError = error;
            return;
        }

        MeetingModel = new();
        ShowMeetingForm = false;

        await SelectConversationAsync(SelectedConversationId.Value);
        await LoadConversations();
    }

    private static string GetMeetingStatusClass(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "confirmed" => "meeting-confirmed",
            "cancelled" => "meeting-denied",
            _ => "meeting-pending"
        };
    }

    private static string GetMeetingStatusText(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "confirmed" => "Meeting confirmed",
            "cancelled" => "Meeting request denied",
            _ => "Waiting for your response"
        };
    }

    private async Task HandleReplyKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendReply();
        }
    }

    private async Task SendReply()
    {
        SendError = null;

        if (SelectedConversationId is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(ReplyText))
        {
            SendError = "Type a message before sending";
            return;
        }

        var error = await MessageStore.SendAsync(SelectedConversationId.Value, AdvisorId, fromAdvisor: true, ReplyText);
        if (error is not null)
        {
            SendError = error;
            return;
        }

        ReplyText = string.Empty;
        await SelectConversationAsync(SelectedConversationId.Value);
        await LoadConversations();
    }



    public class ConversationThread
    {
        public int Id { get; set; }

        public string ClientName { get; set; } = string.Empty;

        public string Preview { get; set; } = string.Empty;

        public string TimeText { get; set; } = string.Empty;

        public string CaseStatus { get; set; } = string.Empty;

        public int UnreadCount { get; set; }
    }


    public class ChatMessageItem
    {
        public string Text { get; set; } = string.Empty;

        public string TimeText { get; set; } = string.Empty;

        public DateTime SentAt { get; set; }

        public bool IsAdvisor { get; set; }
    }

    public class TimelineEntry
    {
        public DateTime Timestamp { get; set; }

        public ChatMessageItem? Message { get; set; }

        public MeetingSummary? Meeting { get; set; }
    }


