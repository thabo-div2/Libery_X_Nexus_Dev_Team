@page "/messages"
@layout MainLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable
@using frontend.Services
@inject MessageService MessageStore
@inject MeetingService MeetingStore
@inject CurrentUserService CurrentUser
@inject MessageNotifier Notifier
@inject NotificationService Notifications
@inject IJSRuntime JS

<PageTitle>Messages | Nexus</PageTitle>

<ErrorBoundary>
<ChildContent>
<div class="messages-page">

    <header class="messages-header">

        <div class="messages-heading">
            <h1>Messages &amp; notifications</h1>

            <p>
                @if (UnreadMessageCount.HasValue || SystemAlertCount.HasValue)
                {
                    <span>
                        @(UnreadMessageCount ?? 0) unread client messages ·
                        @(SystemAlertCount ?? 0) system alerts
                    </span>
                }
                else
                {
                    <span>Client conversations and system notifications</span>
                }
            </p>
        </div>

        <div class="header-actions">

            @* Hidden: this search box was not connected to anything, so typing in it did nothing.
               Bring it back once it filters this page (the Clients and FAQ pages have working examples). *@
            @* <div class="search-box" role="search">
                <span class="search-icon" aria-hidden="true">⌕</span>

                <input aria-label="Search clients, cases, documents" type="text"
                       placeholder="Search clients, cases, documents" />
            </div> *@

           <NotificationBell />

        </div>

    </header>


    @if (!string.IsNullOrEmpty(LoadError))
    {
        <p class="messages-error">@LoadError</p>
    }

    <main class="messages-content">

        <section class="conversation-panel">

            <div class="panel-heading">
                <h2>Conversations</h2>
            </div>

            <div class="conversation-list">

                @if (ConversationThreads.Count > 0)
                {
                    @foreach (var conversation in ConversationThreads)
                    {
                        <button type="button"
                                class="conversation-item @(conversation.Id == SelectedConversationId ? "selected" : "")"
                                @onclick="() => SelectConversationAsync(conversation.Id)">

                            <div class="conversation-top">

                                <strong>
                                    @conversation.ClientName
                                </strong>

                                <span class="conversation-time">
                                    @conversation.TimeText
                                </span>

                            </div>

                            <div class="conversation-bottom">

                                <span class="conversation-preview">
                                    @conversation.Preview
                                </span>

                                @if (conversation.UnreadCount > 0)
                                {
                                    <span class="unread-badge">
                                        @conversation.UnreadCount
                                    </span>
                                }

                            </div>

                        </button>
                    }
                }
                else if (!string.IsNullOrEmpty(LoadError))
                {
                    <div class="conversation-empty" role="alert">
                        <span>Conversations couldn't be loaded. Please try again.</span>
                        <button type="button" @onclick="LoadConversations">Retry</button>
                    </div>
                }
                else
                {
                    <div class="conversation-empty">
                        <span>No clients assigned yet. Add a client to start a conversation.</span>
                    </div>
                }

            </div>

        </section>


        <section class="chat-panel">

            <div class="chat-header">

                <div class="chat-client">

                    <h2>
                        @(string.IsNullOrWhiteSpace(SelectedClientName)
                            ? "Select a conversation"
                            : SelectedClientName)
                    </h2>

                </div>

                @if (!string.IsNullOrWhiteSpace(SelectedCaseStatus))
                {
                    <span class="case-status">
                        <span class="status-dot"></span>
                        @SelectedCaseStatus
                    </span>
                }

                <button type="button" class="meeting-toggle-button" @ref="MeetingToggleButton" aria-expanded="@(ShowMeetingForm ? "true" : "false")" @onclick="ToggleMeetingForm" disabled="@(SelectedConversationId is null)">
                    <span aria-hidden="true">♙</span>
                    Book meeting
                </button>

            </div>

            @if (ShowMeetingForm)
            {
                <div class="meeting-request-form" role="region" aria-label="Book a meeting" @onkeydown="HandleMeetingFormKeyDown">
                    <EditForm Model="MeetingModel" OnValidSubmit="SendMeetingRequest" novalidate>
                        <DataAnnotationsValidator />

                        <label>
                            Date &amp; time
                            <InputDate Type="InputDateType.DateTimeLocal" min="@MinMeetingTime" @bind-Value="MeetingModel.MeetingDateTime" />
                        </label>
                        <ValidationMessage For="() => MeetingModel.MeetingDateTime" />

                        <label>
                            Notes (optional)
                            <InputText @bind-Value="MeetingModel.Notes" placeholder="What's this meeting about?" />
                        </label>
                        <ValidationMessage For="() => MeetingModel.Notes" />

                        <div class="meeting-form-actions">
                            <button type="button" class="meeting-cancel-button" @onclick="ToggleMeetingForm">Cancel</button>
                            <button type="submit" class="meeting-send-button" disabled="@IsSendingMeeting">@(IsSendingMeeting ? "Sending…" : "Schedule meeting")</button>
                        </div>

                        @if (!string.IsNullOrEmpty(MeetingFormError))
                        {
                            <p class="messages-error">@MeetingFormError</p>
                        }
                    </EditForm>
                </div>
            }


            <div class="chat-body" @ref="ChatBodyRef">

                @if (Timeline.Count > 0)
                {
                    @foreach (var item in Timeline)
                    {
                        @if (item.Meeting is not null)
                        {
                            <div class="meeting-card @GetMeetingStatusClass(item.Meeting.Status)">

                                <strong>Meeting request</strong>
                                <span>@item.Meeting.MeetingDate.ToLocalTime().ToString("d MMM yyyy, HH:mm")</span>

                                @if (!string.IsNullOrWhiteSpace(item.Meeting.Notes))
                                {
                                    <span class="meeting-card-notes">@item.Meeting.Notes</span>
                                }

                                @if (string.Equals(item.Meeting.Status, "Requested", StringComparison.OrdinalIgnoreCase))
                                {
                                    <div class="meeting-response-actions">
                                        <button type="button" class="meeting-accept-button" @onclick="() => AcceptMeeting(item.Meeting.MeetingId)">Accept</button>
                                        <button type="button" class="meeting-deny-button" @onclick="() => DenyMeeting(item.Meeting.MeetingId)">Deny</button>
                                    </div>
                                }
                                else
                                {
                                    <span class="meeting-status-label">@GetMeetingStatusText(item.Meeting.Status)</span>
                                }

                            </div>
                        }
                        else if (item.Message is not null)
                        {
                            <div class="message-row @(item.Message.IsAdvisor ? "advisor-message-row" : "client-message-row")">

                                <div class="message-bubble @(item.Message.IsAdvisor ? "advisor-message" : "client-message")">

                                    <span class="message-text">
                                        @item.Message.Text
                                    </span>

                                </div>

                                @if (!string.IsNullOrWhiteSpace(item.Message.TimeText))
                                {
                                    <span class="message-time">
                                        @item.Message.TimeText
                                    </span>
                                }

                            </div>
                        }
                    }
                }
                else
                {
                    <div class="chat-empty-state">

                        <div class="empty-chat-icon">✉</div>

                        <strong>No conversation selected</strong>

                        <span>
                            Choose a client conversation to view messages.
                        </span>

                    </div>
                }

            </div>


            <div class="reply-area">

                <input type="text"
                       aria-label="Reply to client"
                       @bind="ReplyText"
                       @bind:event="oninput"
                       @onkeydown="HandleReplyKeyDown"
                       placeholder="Write a reply..."
                       disabled="@string.IsNullOrWhiteSpace(SelectedClientName)" />

                <button type="button"
                        class="send-button"
                        disabled="@string.IsNullOrWhiteSpace(SelectedClientName)"
                        aria-label="Send message"
                        @onclick="SendReply">

                    ➤

                </button>

            </div>

            @if (!string.IsNullOrEmpty(SendError))
            {
                <p class="messages-error">@SendError</p>
            }

        </section>


        <aside class="notifications-panel">

            <div class="panel-heading">
                <h2>Notifications</h2>
                <span class="notification-total">@NotificationItems.Count</span>
            </div>

            <div class="notification-list">

                @if (NotificationItems.Count > 0)
                {
                    @foreach (var notification in NotificationItems)
                    {
                        <div class="system-notification @(notification.IsUnread ? "is-unread" : "")">

                            <div class="notification-type-icon @GetNotificationIconClass(notification.Type)">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="@GetNotificationIconPath(notification.Type)" /></svg>
                            </div>

                            <div class="notification-details">
                                <div class="notification-meta"><span class="notification-category">@GetNotificationCategory(notification.Type)</span>@if (notification.IsUnread) { <span class="notification-new">New</span> }</div>

                                <strong>
                                    @notification.Title
                                </strong>

                                @if (!string.IsNullOrWhiteSpace(notification.TimeText))
                                {
                                    <span>
                                        @notification.TimeText
                                    </span>
                                }

                            </div>

                        </div>
                    }
                }
                else
                {
                    <div class="notifications-empty">
                        <span>No new notifications</span>
                    </div>
                }

            </div>

        </aside>

    </main>

</div>
</ChildContent>
<ErrorContent>
    <div class="messages-page">
        <p class="messages-error">Something went wrong loading this page. Please refresh and try again.</p>
    </div>
</ErrorContent>
</ErrorBoundary>


@code {

    private int? UnreadMessageCount;
    private int? SystemAlertCount;

    private int? SelectedConversationId;

    private string? SelectedClientName;
    private string? SelectedCaseStatus;

    private string ReplyText { get; set; } = string.Empty;

    private List<ConversationThread> ConversationThreads { get; set; } = new();

    private List<ChatMessageItem> ChatMessages { get; set; } = new();

    private List<MeetingSummary> Meetings { get; set; } = new();

    private List<TimelineEntry> Timeline { get; set; } = new();

    private bool ShowMeetingForm;
    /// <summary>
    /// The meeting request form. Its rules (date required and in the future,
    /// notes under 500 characters) live on MeetingRequestForm.
    /// </summary>
    private MeetingRequestForm MeetingModel = new();

    /// <summary>
    /// Stops the date picker from showing times that have already passed.
    /// </summary>
    private string MinMeetingTime => DateTime.Now.ToString("yyyy-MM-ddTHH:mm", System.Globalization.CultureInfo.InvariantCulture);
    private string? MeetingFormError;

    private List<NotificationItem> NotificationItems { get; set; } = new();


    private int AdvisorId => CurrentUser.Id!.Value;

    private string? LoadError;
    private string? SendError;

    private ElementReference ChatBodyRef;
    private string? LastScrollKey;

    /// <summary>
    /// Scrolls the chat to the bottom when it opens or a new message comes in.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var scrollKey = $"{SelectedConversationId}:{Timeline.Count}";

        if (Timeline.Count == 0 || scrollKey == LastScrollKey)
        {
            return;
        }

        LastScrollKey = scrollKey;

        try
        {
            await JS.InvokeVoidAsync("scrollToBottom", ChatBodyRef);
        }
        catch
        {
            // The page might be closing, so there's nothing to scroll.
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.EnsureRestoredAsync();

        await LoadConversations();
        await LoadNotificationsAsync();

        Notifier.MessageSent += OnMessageSent;
    }

    private async Task LoadNotificationsAsync()
    {
        if (CurrentUser.Id is not int advisorId)
        {
            return;
        }

        var feed = await Notifications.GetFeedForAdvisorAsync(advisorId);
        SystemAlertCount = feed.Items.Count(i => !i.IsRead && !i.IsReminder && i.Type != "MessageReceived");

        NotificationItems = feed.Items.Select(i => new NotificationItem
            {
                Title = i.Message,
                TimeText = i.IsReminder? "Reminder": i.CreatedAt.ToLocalTime().ToString("d MMM, HH:mm"),
                IsUnread = !i.IsRead && !i.IsReminder,
                Type = i.Type
            }).ToList();       
    }

    private void OnMessageSent(int clientId)
    {
        _ = InvokeAsync(async () =>
        {
            await LoadConversations();

            if (SelectedConversationId is not null && SelectedConversationId.Value == clientId)
            {
                await SelectConversationAsync(clientId);
            }

            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Notifier.MessageSent -= OnMessageSent;
    }

    private async Task LoadConversations()
    {
        var (conversations, error) = await MessageStore.GetConversationsForAdvisorAsync(AdvisorId);
        LoadError = error;

        ConversationThreads = conversations.Select(c => new ConversationThread
        {
            Id = c.ClientId,
            ClientName = c.ClientName,
            Preview = c.LastMessage ?? "No messages yet",
            TimeText = c.LastMessageAt.HasValue ? c.LastMessageAt.Value.ToLocalTime().ToString("d MMM, HH:mm") : string.Empty,
            CaseStatus = string.Empty,
            UnreadCount = c.UnreadCount
        }).ToList();
        UnreadMessageCount = ConversationThreads.Sum(c => c.UnreadCount);
    }

    private async Task SelectConversationAsync(int conversationId)
    {
        var opened = ConversationThreads.FirstOrDefault(thread => thread.Id == conversationId);

        var isDifferentConversation = SelectedConversationId != conversationId;
        SelectedConversationId = conversationId;

        if (isDifferentConversation)
        {
            ShowMeetingForm = false;
            MeetingModel = new();
            MeetingFormError = null;
        }

        var selectedConversation =
            ConversationThreads.FirstOrDefault(x => x.Id == conversationId);

        if (selectedConversation is null)
        {
            return;
        }

        SelectedClientName = selectedConversation.ClientName;
        SelectedCaseStatus = selectedConversation.CaseStatus;

        var (messages, messageError) = await MessageStore.GetConversationAsync(conversationId);
        if (messageError is null && opened is not null)
        {
            opened.UnreadCount = 0;
            UnreadMessageCount = ConversationThreads.Sum(c => c.UnreadCount);
        }

        ChatMessages = messages.Select(m => new ChatMessageItem
        {
            Text = m.Text,
            TimeText = m.SentAt.ToLocalTime().ToString("d MMM, HH:mm"),
            SentAt = m.SentAt,
            IsAdvisor = m.FromAdvisor
        }).ToList();

        var (meetings, meetingError) = await MeetingStore.GetForClientAsync(conversationId);
        Meetings = meetings;

        LoadError = messageError ?? meetingError;
        BuildTimeline();
    }

    private void BuildTimeline()
    {
        var items = new List<TimelineEntry>();

        items.AddRange(ChatMessages.Select(m => new TimelineEntry { Timestamp = m.SentAt, Message = m }));
        items.AddRange(Meetings.Select(m => new TimelineEntry { Timestamp = m.CreatedAt, Meeting = m }));

        Timeline = items.OrderBy(i => i.Timestamp).ToList();
    }

    private async Task AcceptMeeting(int meetingId)
    {
        await RespondToMeeting(meetingId, accept: true);
    }

    private async Task DenyMeeting(int meetingId)
    {
        await RespondToMeeting(meetingId, accept: false);
    }

    private async Task RespondToMeeting(int meetingId, bool accept)
    {
        if (SelectedConversationId is null)
        {
            return;
        }

        var error = await MeetingStore.RespondAsync(meetingId, SelectedConversationId.Value, accept);
        if (error is not null)
        {
            SendError = error;
            return;
        }

        await SelectConversationAsync(SelectedConversationId.Value);
        await LoadConversations();
    }

    private void ToggleMeetingForm()
    {
        ShowMeetingForm = !ShowMeetingForm;
        MeetingFormError = null;
    }

    /// <summary>
    /// The Book meeting button, so focus can go back to it when the form closes.
    /// </summary>
    private ElementReference MeetingToggleButton;

    /// <summary>
    /// Escape inside the meeting form closes it and puts focus back on the Book meeting button,
    /// so keyboard users aren't left stranded when it disappears.
    /// </summary>
    private async Task HandleMeetingFormKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            ShowMeetingForm = false;
            MeetingFormError = null;
            // The element can be missing if the page changed in the meantime; closing still worked.
            try { await MeetingToggleButton.FocusAsync(); } catch (Exception) { }
        }
    }

    /// <summary>
    /// True while a meeting request is being sent, so a double-click can't send it twice.
    /// </summary>
    private bool IsSendingMeeting;

    /// <summary>
    /// Runs only when the form passes its rules. Reads the values from the form that was
    /// actually submitted (context.Model) and copies them first: after the first click
    /// succeeds the page swaps MeetingModel for a fresh empty one, and a second queued
    /// click used to read that empty model and crash with "Nullable object must have a value".
    /// </summary>
    private async Task SendMeetingRequest(EditContext context)
    {
        if (IsSendingMeeting || context.Model is not MeetingRequestForm submitted || submitted.MeetingDateTime is not DateTime meetingLocal)
        {
            return;
        }

        var notes = submitted.Notes;
        IsSendingMeeting = true;

        try
        {
            await SendMeetingRequestCore(submitted, meetingLocal, notes);
        }
        finally
        {
            IsSendingMeeting = false;
        }
    }

    private async Task SendMeetingRequestCore(MeetingRequestForm submitted, DateTime meetingLocal, string? notes)
    {
        MeetingFormError = null;

        if (SelectedConversationId is null)
        {
            MeetingFormError = "Select a conversation first.";
            return;
        }

        var meetingDateUtc = DateTime.SpecifyKind(meetingLocal, DateTimeKind.Local).ToUniversalTime();

        var error = await MeetingStore.RequestAsync(SelectedConversationId.Value, AdvisorId, fromAdvisor: true, meetingDateUtc, notes);
        if (error is not null)
        {
            MeetingFormError = error;
            return;
        }

        MeetingModel = new();
        ShowMeetingForm = false;

        await SelectConversationAsync(SelectedConversationId.Value);
        await LoadConversations();
    }

    private static string GetMeetingStatusClass(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "confirmed" => "meeting-confirmed",
            "cancelled" => "meeting-denied",
            _ => "meeting-pending"
        };
    }

    private static string GetMeetingStatusText(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "confirmed" => "Meeting confirmed",
            "cancelled" => "Meeting request denied",
            _ => "Waiting for your response"
        };
    }

    private async Task HandleReplyKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendReply();
        }
    }

    private async Task SendReply()
    {
        SendError = null;

        if (SelectedConversationId is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(ReplyText))
        {
            SendError = "Type a message before sending";
            return;
        }

        var error = await MessageStore.SendAsync(SelectedConversationId.Value, AdvisorId, fromAdvisor: true, ReplyText);
        if (error is not null)
        {
            SendError = error;
            return;
        }

        ReplyText = string.Empty;
        await SelectConversationAsync(SelectedConversationId.Value);
        await LoadConversations();
    }


    private static string GetNotificationCategory(string? type) => type switch
    {
        "DocumentUploaded" => "Document",
        "MeetingBooked" or "MeetingConfirmed" or "MeetingCancelled" or "MeetingRescheduled" => "Meeting",
        "MessageReceived" or "QueryReceived" or "QueryResponded" => "Message",
        "CaseUpdated" => "Case update",
        "ClientRegistered" => "New client",
        "PendingAction" => "Action needed",
        _ => "Update"
    };

    private static string GetNotificationIconClass(string? type) => GetNotificationCategory(type) switch
    {
        "Document" => "notification-document",
        "Meeting" => "notification-calendar",
        "Action needed" => "notification-warning",
        "New client" => "notification-success",
        _ => "notification-neutral"
    };

    private static string GetNotificationIconPath(string? type) => GetNotificationCategory(type) switch
    {
        "Document" => "M14 2H6v20h12V6z M14 2v5h5 M8 12h8 M8 16h6",
        "Meeting" => "M4 5h16v16H4z M8 3v4 M16 3v4 M4 10h16 M8 14h2 M14 14h2",
        "Message" => "M4 4h16v12H9l-5 4z M8 8h8 M8 12h5",
        "Action needed" => "M12 3 2 21h20z M12 9v5 M12 17h.01",
        "New client" => "M15 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2 M13 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0 M19 8v6 M16 11h6",
        _ => "M5 12l4 4L19 6"
    };

    public class ConversationThread
    {
        public int Id { get; set; }

        public string ClientName { get; set; } = string.Empty;

        public string Preview { get; set; } = string.Empty;

        public string TimeText { get; set; } = string.Empty;

        public string CaseStatus { get; set; } = string.Empty;

        public int UnreadCount { get; set; }
    }


    public class ChatMessageItem
    {
        public string Text { get; set; } = string.Empty;

        public string TimeText { get; set; } = string.Empty;

        public DateTime SentAt { get; set; }

        public bool IsAdvisor { get; set; }
    }

    public class TimelineEntry
    {
        public DateTime Timestamp { get; set; }

        public ChatMessageItem? Message { get; set; }

        public MeetingSummary? Meeting { get; set; }
    }


    public class NotificationItem
    {
        public bool IsUnread { get; set; }
        public string Title { get; set; } = string.Empty;

        public string TimeText { get; set; } = string.Empty;

        public string Type { get; set; } = string.Empty;
    }
}

@* //-----------------------------------------------------------------------------0o0o0o End of File 0o0o0o0o0o-------------------------------------------------------------------------------------------------// *@
