@page "/register"
@layout EmptyLayout
@rendermode InteractiveServer
@using frontend.Services
@using Microsoft.AspNetCore.Components
@inject AuthService Auth
@inject InvitationService Invite
@inject CurrentUserService CurrentUser
@inject NavigationManager Navigation

<PageTitle>Register | Nexus</PageTitle>

<ErrorBoundary>
<ChildContent>
<div class="register-page">

    <!-- LEFT SIDE -->
    <section class="brand-panel">

        <div class="brand-logo">
            <div class="brand-icon">N</div>
            <span>NEXUS</span>
        </div>

        <div class="brand-content">

            <h1>
                One place for your<br />
                policies, paperwork and<br />
                adviser.
            </h1>

            <p class="brand-description">
                Track every case from intake to issue, sign documents digitally,
                and get answers the moment you need them.
            </p>

            <div class="brand-features">

                <div class="feature-item">
                    <span class="feature-icon">▢</span>
                    <span>Live case status across Liberty &amp; Standard Bank</span>
                </div>

                <div class="feature-item">
                    <span class="feature-icon">▣</span>
                    <span>Pre-populated, e-signable documents</span>
                </div>

                <div class="feature-item">
                    <span class="feature-icon">◇</span>
                    <span>AI assistant with adviser handoff</span>
                </div>

            </div>

        </div>

        <div class="brand-footer">
            FSP-compliant · POPIA-aligned · Audit logged
        </div>

    </section>


    <!-- RIGHT SIDE -->
    <section class="register-form-panel">

        <div class="register-card">

            <div class="register-heading">
                <h2>Create your account</h2>
                <p>Your adviser invited you to Nexus. Takes about two minutes.</p>
            </div>

            <EditForm Model="RegisterModel" OnValidSubmit="HandleRegister" novalidate>
            <DataAnnotationsValidator />

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <p class="register-error" role="alert">@ErrorMessage</p>
            }


            <!-- NAME ROW -->
            <div class="name-row">

                <div class="form-group">
                    <label for="firstName">First name</label>

                    <InputText id="firstName"
                               type="text"
                               placeholder="Thandi"
                               autocomplete="given-name"
                               @bind-Value="RegisterModel.FirstName" />

                    <ValidationMessage For="() => RegisterModel.FirstName" />
                </div>

                <div class="form-group">
                    <label for="lastName">Last name</label>

                    <InputText id="lastName"
                               type="text"
                               placeholder="Mokoena"
                               autocomplete="family-name"
                               @bind-Value="RegisterModel.LastName" />

                    <ValidationMessage For="() => RegisterModel.LastName" />
                </div>

            </div>


            <!-- EMAIL -->
            <div class="form-group">
                <label for="email">Email address</label>

                <InputText id="email"
                           type="email"
                           placeholder="you@example.co.za"
                           autocomplete="email"
                           readonly="@InviteValid"
                           @bind-Value="RegisterModel.Email" />

                <ValidationMessage For="() => RegisterModel.Email" />
            </div>


            <!-- MOBILE -->
            <div class="form-group">
                <label for="mobile">Mobile number <span class="optional-label">(optional)</span></label>

                <InputText id="mobile"
                           type="tel"
                           placeholder="+27 82 000 0000"
                           autocomplete="tel"
                           @bind-Value="RegisterModel.Mobile" />

                <ValidationMessage For="() => RegisterModel.Mobile" />
            </div>


            <!-- ID NUMBER -->
            <div class="form-group">
                <label for="idNumber">ID number <span class="optional-label">(optional)</span></label>

                <InputText id="idNumber"
                           type="text"
                           inputmode="numeric"
                           placeholder="9001015800086"
                           @bind-Value="RegisterModel.IdNumber" />

                <ValidationMessage For="() => RegisterModel.IdNumber" />
            </div>


            <!-- PASSWORD -->
            <div class="form-group">
                <label for="password">Password</label>

                <div class="password-input-wrapper">
                    <InputText id="password"
                               type="@(ShowPassword ? "text" : "password")"
                               placeholder="At least 12 characters"
                               autocomplete="new-password"
                               @bind-Value="RegisterModel.Password" />

                    <button type="button"
                            class="password-toggle-button"
                            aria-label="@(ShowPassword ? "Hide password" : "Show password")"
                            @onclick="() => ShowPassword = !ShowPassword">
                        @((MarkupString)(ShowPassword ? EyeOffIcon : EyeIcon))
                    </button>
                </div>

                <span class="field-hint">At least 12 characters, with an uppercase letter, a lowercase letter and a number.</span>

                <ValidationMessage For="() => RegisterModel.Password" />
            </div>


            <!-- CONSENT -->
            <label class="consent-row">

                <InputCheckbox @bind-Value="RegisterModel.PopiaConsent" />

                <span>
                    I consent to Nexus processing my personal information under
                    POPIA for the purpose of financial planning services.
                </span>

            </label>

            <ValidationMessage For="() => RegisterModel.PopiaConsent" />


            <button type="submit" class="create-account-button" disabled="@(!InviteValid || IsBusy)">
                @(IsBusy ? "Creating account..." : "Create account")
            </button>
            </EditForm>


            <div class="sign-in-section">
                <span>Already registered?</span>
                <a href="/">Sign in</a>
            </div>

        </div>

    </section>

</div>
</ChildContent>
<ErrorContent>
    <div class="register-page">
        <p class="register-error">Something went wrong loading this page. Please refresh and try again.</p>
    </div>
</ErrorContent>
</ErrorBoundary>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    /// <summary>
    /// What the user typed. The rules (required names, valid email, strong password,
    /// POPIA consent, optional phone and ID formats) live on RegisterForm.
    /// </summary>
    private readonly RegisterForm RegisterModel = new();
    private bool IsBusy;
    private const string EyeIcon = "<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg>";
    private const string EyeOffIcon = "<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-7-11-7a21.3 21.3 0 0 1 5.06-5.94M9.9 4.24A10.4 10.4 0 0 1 12 4c7 0 11 7 11 7a21.3 21.3 0 0 1-3.22 4.36M14.12 14.12a3 3 0 1 1-4.24-4.24\"/><line x1=\"1\" y1=\"1\" x2=\"23\" y2=\"23\"/></svg>";

    private bool ShowPassword;
    private string? ErrorMessage;
    private bool InviteValid;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(Token))
        {
            ErrorMessage = "This registration link is missing an invite token. Ask your adviser for a new link.";
            return;
        }

        var invitation = await Invite.ValidateAsync(Token);
        InviteValid = invitation.Valid;
        if (!invitation.Valid)
        {
            ErrorMessage = invitation.Message;
            return;
        }

        RegisterModel.Email = invitation.Email;
    }

    /// <summary>
    /// Runs only when every field passes its rules (EditForm OnValidSubmit).
    /// </summary>
    private async Task HandleRegister()
    {
        ErrorMessage = null;

        if (!InviteValid || Token is null)
        {
            ErrorMessage = "This registration link is invalid.";
            return;
        }

        IsBusy = true;

        var result = await Auth.RegisterAsync(
            RegisterModel.FirstName.Trim(),
            RegisterModel.LastName.Trim(),
            RegisterModel.Email.Trim(),
            RegisterModel.Mobile.Trim(),
            RegisterModel.IdNumber.Trim(),
            RegisterModel.Password,
            Token);

        IsBusy = false;

        if (!result.Success)
        {
            ErrorMessage = result.Message;
            return;
        }

        await CurrentUser.SignInAsync(result);
        Navigation.NavigateTo("/client");
    }
}

@* //-----------------------------------------------------------------------------0o0o0o End of File 0o0o0o0o0o-------------------------------------------------------------------------------------------------// *@
