@page "/register"

<div class="auth-page">
    <section class="auth-brand-panel">
        <div class="auth-logo">
            <div class="brand-mark">N</div>
            <div class="brand-name">Nexus</div>
        </div>

        <div class="auth-copy">
            <h1>One place for your<br />policies, paperwork and<br />advisor.</h1>
            <p>Track every case from intake to issue, sign documents digitally, and get answers the moment you need them.</p>

            <ul class="auth-benefits">
                <li><span>✓</span> Live case status across Liberty &amp; Standard Bank</li>
                <li><span>✓</span> Pre-populated, e-signable documents</li>
                <li><span>✓</span> AI assistant with advisor handoff</li>
            </ul>
        </div>

        <div class="auth-footer">FSCA compliant · POPIA aligned · Audit logged</div>
    </section>

    <section class="auth-form-panel">
        <div class="auth-form-card register-card">
            <h2>Create your account</h2>
            <p class="muted">Your advisor invited you to Nexus. Takes about two minutes.</p>

            <form>
                <div class="form-grid two">
                    <div>
                        <label>First name</label>
                        <input value="Thandi" />
                    </div>
                    <div>
                        <label>Last name</label>
                        <input value="Mokoena" />
                    </div>
                </div>

                <label>Email address</label>
                <input type="email" value="you@example.co.za" />

                <label>Mobile number</label>
                <input value="+27 82 000 0000" />

                <label>ID number</label>
                <input value="9001015800086" />

                <label>Password</label>
                <input type="password" value="password123" />

                <label class="checkline terms">
                    <input type="checkbox" />
                    <span>I consent to Nexus processing my personal information under POPIA for the purpose of financial planning services.</span>
                </label>

                <button type="button" class="btn btn-primary full">Create account</button>
                <div class="auth-switch">Already registered? <a href="/nexus/login">Sign in</a></div>
            </form>
        </div>
    </section>
</div>
