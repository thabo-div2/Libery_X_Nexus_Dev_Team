@page "/register"
@layout EmptyLayout
@rendermode InteractiveServer
@using frontend.Services
@using Microsoft.AspNetCore.Components
@inject AuthService Auth
@inject InvitationService Invite
@inject NavigationManager Navigation

<PageTitle>Register | Nexus</PageTitle>

<div class="register-page">

    <!-- LEFT SIDE -->
    <section class="brand-panel">

        <div class="brand-logo">
            <div class="brand-icon">N</div>
            <span>NEXUS</span>
        </div>

        <div class="brand-content">

            <h1>
                One place for your<br />
                policies, paperwork and<br />
                adviser.
            </h1>

            <p class="brand-description">
                Track every case from intake to issue, sign documents digitally,
                and get answers the moment you need them.
            </p>

            <div class="brand-features">

                <div class="feature-item">
                    <span class="feature-icon">▢</span>
                    <span>Live case status across Liberty &amp; Standard Bank</span>
                </div>

                <div class="feature-item">
                    <span class="feature-icon">▣</span>
                    <span>Pre-populated, e-signable documents</span>
                </div>

                <div class="feature-item">
                    <span class="feature-icon">◇</span>
                    <span>AI assistant with adviser handoff</span>
                </div>

            </div>

        </div>

        <div class="brand-footer">
            FSP-compliant · POPIA-aligned · Audit logged
        </div>

    </section>


    <!-- RIGHT SIDE -->
    <section class="register-form-panel">

        <div class="register-card">

            <div class="register-heading">
                <h2>Create your account</h2>
                <p>Your adviser invited you to Nexus. Takes about two minutes.</p>
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <p class="register-error">@ErrorMessage</p>
            }


            <!-- NAME ROW -->
            <div class="name-row">

                <div class="form-group">
                    <label for="firstName">First name</label>

                    <input id="firstName"
                           type="text"
                           placeholder="Thandi"
                           autocomplete="given-name"
                           @bind="FirstName" />
                </div>

                <div class="form-group">
                    <label for="lastName">Last name</label>

                    <input id="lastName"
                           type="text"
                           placeholder="Mokoena"
                           autocomplete="family-name"
                           @bind="LastName" />
                </div>

            </div>


            <!-- EMAIL -->
            <div class="form-group">
                <label for="email">Email address</label>

                <input id="email"
                       type="email"
                       placeholder="you@example.co.za"
                       autocomplete="email"
                       readonly="@InviteValid"
                       @bind="Email" />
            </div>


            <!-- MOBILE -->
            <div class="form-group">
                <label for="mobile">Mobile number</label>

                <input id="mobile"
                       type="tel"
                       placeholder="+27 82 000 0000"
                       autocomplete="tel"
                       @bind="Mobile" />
            </div>


            <!-- ID NUMBER -->
            <div class="form-group">
                <label for="idNumber">ID number</label>

                <input id="idNumber"
                       type="text"
                       placeholder="9001015800086"
                       @bind="IdNumber" />
            </div>


            <!-- PASSWORD -->
            <div class="form-group">
                <label for="password">Password</label>

                <input id="password"
                       type="password"
                       placeholder="Minimum 8 characters"
                       autocomplete="new-password"
                       @bind="Password" />
            </div>


            <!-- CONSENT -->
            <label class="consent-row">

                <input type="checkbox" />

                <span>
                    I consent to Nexus processing my personal information under
                    POPIA for the purpose of financial planning services.
                </span>

            </label>


            <button type="button" class="create-account-button" @onclick="HandleRegister" disabled="@(!InviteValid)">
                Create account
            </button>


            <div class="sign-in-section">
                <span>Already registered?</span>
                <a href="/">Sign in</a>
            </div>

        </div>

    </section>

</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    private string FirstName = string.Empty;
    private string LastName = string.Empty;
    private string Email = string.Empty;
    private string Mobile = string.Empty;
    private string IdNumber = string.Empty;
    private string Password = string.Empty;
    private string? ErrorMessage;
    private bool InviteValid;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(Token))
        {
            ErrorMessage = "This registration link is missing an invite token. Ask your adviser for a new link.";
            return;
        }

        var invitation = await Invite.ValidateAsync(Token);
        InviteValid = invitation.Valid;
        if (!invitation.Valid)
        {
            ErrorMessage = invitation.Message;
            return;
        }

        Email = invitation.Email;
    }

    private async Task HandleRegister()
    {
        if (!InviteValid || Token is null)
        {
            ErrorMessage = "This registration link is invalid.";
            return;
        }

        var result = await Auth.RegisterAsync(FirstName, LastName, Email, Mobile, IdNumber, Password, Token);
        if (!result.Success)
        {
            ErrorMessage = result.Message;
            return;
        }

        Navigation.NavigateTo("/client");
    }
}
