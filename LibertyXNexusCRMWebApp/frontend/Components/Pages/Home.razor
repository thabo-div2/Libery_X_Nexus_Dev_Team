@page "/home"

<PageTitle>Nexus Home</PageTitle>

<div class="home-page">
    <h1>Nexus Prototype Pages</h1>
    <p>Select a page to open it.</p>

    <div class="page-links">
        <a href="/login">Login</a>
        <a href="/register">Register</a>
        <a href="/advisor">Advisor Dashboard</a>
        <a href="/new-client">New Client</a>
        <a href="/client">Client Dashboard</a>
        <a href="/documents">Documents</a>
        <a href="/calendar">Calendar</a>
        <a href="/messages">Messages / Notifications</a>
        <a href="/assistant">AI Chatbot</a>
    </div>
</div>

<style>
    .home-page {
        max-width: 900px;
        margin: 60px auto;
        padding: 20px;
        font-family: Arial, sans-serif;
    }

        .home-page h1 {
            margin-bottom: 8px;
        }

        .home-page p {
            color: #666;
            margin-bottom: 25px;
        }

    .page-links {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 14px;
    }

        .page-links a {
            display: block;
            padding: 16px 18px;
            background: #062b4a;
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 600;
            transition: 0.2s;
        }

            .page-links a:hover {
                background: #0a3b61;
                transform: translateY(-2px);
            }
</style>