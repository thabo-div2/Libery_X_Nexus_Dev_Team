@page "/activity"
@layout MainLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using frontend.Services
@inject ActivityService ActivityApi
@inject CurrentUserService CurrentUser
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Activity | Nexus</PageTitle>

@* A record of what the advisor changed and when: clients, policies, application steps and documents. *@

<div class="activity-page">

    <header class="activity-header">

        <div class="activity-heading">
            <h1>Activity</h1>
            <p>Everything that happened on your book, newest first.</p>
        </div>

        <div class="header-actions">

            <div class="search-box" role="search">
                <span class="search-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></span>
                <input aria-label="Search activity"
                       type="search"
                       placeholder="Search activity"
                       @bind="SearchText"
                       @bind:event="oninput" />
            </div>

            <button type="button" class="activity-export" disabled="@(IsExporting || Items.Count == 0)" @onclick="ExportAsync">@(IsExporting ? "Exporting…" : "Export CSV")</button>

            <NotificationBell />

        </div>

    </header>

    <main class="activity-content">

        @if (IsLoading)
        {
            <section class="activity-card" aria-busy="true">
                <div class="activity-skeleton" role="status" aria-label="Loading activity">
                    @for (var row = 0; row < 6; row++)
                    {
                        <div class="skeleton-row"><span class="skeleton-dot"></span><span class="skeleton-line"></span><span class="skeleton-line short"></span></div>
                    }
                </div>
            </section>
        }
        else if (!string.IsNullOrWhiteSpace(LoadError))
        {
            <div class="activity-empty">
                <span class="empty-icon is-error"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v5"/><path d="M12 16h.01"/></svg></span>
                <strong>Unable to load your activity</strong>
                <span>@LoadError</span>
                <button type="button" class="nx-btn nx-btn-secondary" @onclick="LoadAsync">Try again</button>
            </div>
        }
        else if (Items.Count == 0)
        {
            <div class="activity-empty">
                <span class="empty-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6h13"/><path d="M8 12h13"/><path d="M8 18h13"/><path d="M3 6h.01"/><path d="M3 12h.01"/><path d="M3 18h.01"/></svg></span>
                <strong>No activity yet</strong>
                <span>Changes you make to clients, policies and documents will appear here.</span>
            </div>
        }
        else
        {
            var visible = VisibleItems;

            <section class="activity-card">
                <div class="activity-toolbar">
                    <div><h2>Recent activity <span class="activity-count">@visible.Count</span></h2><p>Latest 200 records</p></div>
                    <div class="activity-controls">
                        @{
                            var categoryIndex = Math.Max(0, Array.FindIndex(Categories, cat => cat.Key == ActionFilter));
                        }
                        <div class="activity-filters" @ref="FilterRef" role="group" aria-label="Filter activity by type"
                             style="--n:@Categories.Length;--i:@categoryIndex">
                            <span class="seg-thumb" aria-hidden="true"></span>
                            @foreach (var category in Categories)
                            {
                                <button type="button"
                                        class="filter-pill @(ActionFilter == category.Key ? "active" : "")"
                                        aria-pressed="@(ActionFilter == category.Key)"
                                        @onclick="() => SetCategory(category.Key)">
                                    <span class="filter-label">@category.Label</span>
                                    <span class="filter-count">@CategoryCount(category.Key)</span>
                                </button>
                            }
                        </div>
                        <button type="button" class="activity-refresh" @onclick="LoadAsync"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 0 1 15.5-6.2L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15.5 6.2L3 16"/><path d="M3 21v-5h5"/></svg> Refresh</button>
                    </div>
                </div>

                @if (visible.Count == 0)
                {
                    <div class="activity-empty">
                        <span class="empty-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></span>
                        <strong>No matching activity</strong>
                        <span>Try another search or action filter.</span>
                        <button type="button" class="nx-btn nx-btn-secondary nx-btn-sm" @onclick="ClearFilters">Clear filters</button>
                    </div>
                }
                else
                {
                    <div class="activity-feed">
                        @foreach (var day in visible.GroupBy(i => i.Timestamp.ToLocalTime().Date))
                        {
                            <h3 class="feed-day">@DateLabel(day.Key)<span>@day.Count() @(day.Count() == 1 ? "event" : "events")</span></h3>
                            <ul class="feed-list">
                                @foreach (var item in day)
                                {
                                    <li>
                                        <span class="activity-mark @ActionClass(item.Action)" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="@ActionPath(item.Action)" /></svg></span>
                                        <div class="feed-text">
                                            <span>@Sentence(item)</span>
                                            @if (!string.IsNullOrWhiteSpace(item.Details)) { <small>@item.Details</small> }
                                        </div>
                                        <time datetime="@item.Timestamp.ToString("O")">@item.Timestamp.ToLocalTime().ToString("HH:mm")</time>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                }

            </section>
        }

    </main>

</div>

<RealtimeRefresh OnChanged="LoadAsync" />

@code {
    private List<ActivityItem> Items = new();
    private bool IsLoading = true;
    private string? LoadError;
    private string SearchText = string.Empty;
    private string ActionFilter = string.Empty;

    private List<ActivityItem> VisibleItems
    {
        get
        {
            var term = SearchText.Trim();

            return Items
                .Where(i => string.IsNullOrEmpty(ActionFilter) || CategoryOf(i.Action, i.Entity) == ActionFilter)
                .Where(i => term.Length == 0 || Sentence(i).Contains(term, StringComparison.OrdinalIgnoreCase)
                    || (i.Details ?? string.Empty).Contains(term, StringComparison.OrdinalIgnoreCase)
                    || i.Entity.Contains(term, StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(i => i.Timestamp)
                .ToList();
        }
    }

    private void ClearFilters() { SearchText = string.Empty; ActionFilter = string.Empty; }

    // Filter tabs: actions are grouped so the control stays short. The key is stored in ActionFilter ("" = all).
    private static readonly (string Key, string Label)[] Categories =
    {
        ("", "All"), ("clients", "Clients"), ("documents", "Documents"), ("meetings", "Meetings"), ("tasks", "Tasks"), ("sessions", "Sign-ins")
    };

    private static string CategoryOf(string action) => CategoryOf(action, null);

    // Grouped by the area of work, not the technical action, so the filter reads like the app.
    private static string CategoryOf(string action, string? entity) => action switch
    {
        "DocumentUpload" or "DocumentDownload" or "PermissionChange" => "documents",
        "Login" or "Logout" => "sessions",
        _ => (entity ?? string.Empty).ToLowerInvariant() switch
        {
            var e when e.Contains("document") => "documents",
            var e when e.Contains("meeting") => "meetings",
            var e when e.Contains("task") => "tasks",
            "auth" => "sessions",
            _ => "clients"
        }
    };

    private int CategoryCount(string key) => Items.Count(i => key.Length == 0 || CategoryOf(i.Action, i.Entity) == key);

    private void SetCategory(string key) => ActionFilter = key;

    // Lets the filter be dragged as well as clicked (see Common/SegmentedDragBinding.cs).
    private ElementReference FilterRef;
    private SegmentedDragBinding? FilterDrag;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        FilterDrag ??= new SegmentedDragBinding(JS, PickCategoryAsync);
        await FilterDrag.BindAsync(FilterRef);
    }

    private async Task PickCategoryAsync(int index)
    {
        if (index < 0 || index >= Categories.Length) return;
        SetCategory(Categories[index].Key);
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (FilterDrag is not null) await FilterDrag.DisposeAsync();
    }

    private static string DateLabel(DateTime date) => date == DateTime.Today ? "Today" :
        date == DateTime.Today.AddDays(-1) ? "Yesterday" : date.ToString("dddd, dd MMM yyyy");

    private static string ActionLabel(string action) => action switch
    {
        "DocumentUpload" => "Document uploads", "DocumentDownload" => "Document downloads",
        "PermissionChange" => "Sharing changes", "Login" => "Sign-ins", "Logout" => "Sign-outs",
        _ => action
    };

    private static string ActionClass(string action) => action switch
    {
        "Create" => "action-create", "Delete" => "action-delete",
        "DocumentUpload" or "DocumentDownload" => "action-document",
        _ => "action-update"
    };

    private static string ActionPath(string action) => action switch
    {
        "Create" => "M12 5v14 M5 12h14",
        "Delete" => "M4 7h16 M9 7V4h6v3 M6 7l1 13h10l1-13 M10 10v7 M14 10v7",
        "DocumentUpload" => "M12 16V4 M7 9l5-5 5 5 M4 16v4h16v-4",
        "DocumentDownload" => "M12 4v12 M7 11l5 5 5-5 M4 16v4h16v-4",
        "Login" or "Logout" => "M14 4h6v16h-6 M3 12h12 M10 7l5 5-5 5",
        _ => "M4 20l4-1L20 7l-3-3L5 16z M14 7l3 3"
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        LoadError = null;

        try
        {
            await CurrentUser.EnsureRestoredAsync();

            if (CurrentUser.Id is null || !CurrentUser.IsAdvisor)
            {
                LoadError = "You need to be signed in as an advisor to see the activity log.";
                return;
            }

            var (items, error) = await ActivityApi.GetRecentAsync();

            if (items is null)
            {
                LoadError = error ?? "Your activity couldn't be loaded.";
                return;
            }

            Items = items;
        }
        finally
        {
            IsLoading = false;
        }
    }

    /// <summary>
    /// A plain sentence: "Create" on a "Client" becomes "You added a client".
    /// </summary>
    private static string Sentence(ActivityItem item)
    {
        var entity = string.IsNullOrWhiteSpace(item.Entity) ? "record" : item.Entity.ToLowerInvariant();
        var article = "aeiou".Contains(entity[0]) ? "an" : "a";
        var record = item.EntityId is int id ? $" (#{id})" : "";

        return item.Action switch
        {
            "Create" => $"You added {article} {entity}{record}",
            "Update" => $"You updated {article} {entity}{record}",
            "Delete" => $"You deleted {article} {entity}{record}",
            "Login" => "You signed in",
            "Logout" => "You signed out",
            "DocumentUpload" => $"A document was uploaded{record}",
            "DocumentDownload" => $"You downloaded a document{record}",
            "PermissionChange" => $"You changed who can see a document{record}",
            _ => Describe(item) + record
        };
    }

    private bool IsExporting;

    // The list is already loaded, so the CSV is built here instead of adding an API endpoint.
    private async Task ExportAsync()
    {
        if (IsExporting) return;
        IsExporting = true;
        try
        {
            // A leading = + - @ would run as a formula in Excel, so those cells get a quote prefix.
            static string Cell(string? value)
            {
                var text = value ?? string.Empty;
                if (text.Length > 0 && "=+-@".Contains(text[0])) text = "'" + text;
                return "\"" + text.Replace("\"", "\"\"") + "\"";
            }
            var lines = VisibleItems.Select(i => string.Join(",",
                Cell(i.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm")), Cell(Sentence(i)), Cell(i.Action), Cell(i.Entity), Cell(i.EntityId?.ToString()), Cell(i.Details)));
            var csv = "Time,Activity,Action,Record,Record id,Details\r\n" + string.Join("\r\n", lines);
            using var stream = new MemoryStream(System.Text.Encoding.UTF8.GetBytes(csv));
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("nxDownloadFile", $"activity-{DateTime.Today:yyyy-MM-dd}.csv", "text/csv", streamRef);
        }
        catch (JSDisconnectedException) { }
        finally
        {
            IsExporting = false;
        }
    }

    private static string Describe(ActivityItem item)
    {
        var entity = string.IsNullOrWhiteSpace(item.Entity) ? "record" : item.Entity.ToLowerInvariant();

        return item.Action switch
        {
            "Create" => $"Created {entity}",
            "Update" => $"Updated {entity}",
            "Delete" => $"Deleted {entity}",
            "Login" => "Signed in",
            "Logout" => "Signed out",
            "DocumentUpload" => "Uploaded document",
            "DocumentDownload" => "Downloaded document",
            "PermissionChange" => "Changed document sharing",
            _ => $"{item.Action} {entity}"
        };
    }
}

