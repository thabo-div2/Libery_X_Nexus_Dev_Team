@page "/forgot-password"
@layout EmptyLayout
@rendermode InteractiveServer
@using frontend.Services
@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>Forgot password | Nexus</PageTitle>

<ErrorBoundary>
<ChildContent>
<div class="forgot-password-page">

    <section class="forgot-password-panel">

        <div class="forgot-password-card">

            <div class="brand-logo">
                <div class="brand-icon">N</div>
                <span>NEXUS</span>
            </div>

            @if (Stage == FlowStage.EnterEmail)
            {
                <div class="form-heading">
                    <h2>Forgot your password?</h2>
                    <p>Enter the email on your account and we'll send you a link to reset your password.</p>
                </div>

                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <p class="form-error">@ErrorMessage</p>
                }

                <div class="form-group">
                    <label for="email">Email address</label>

                    <input id="email"
                           type="email"
                           placeholder="you@example.co.za"
                           autocomplete="email"
                           @bind="Email"
                           @bind:event="oninput"
                           @onkeydown="HandleEmailKeyDown" />
                </div>

                <button type="button" class="primary-button" disabled="@IsBusy" @onclick="HandleCheckEmail">
                    <span>@(IsBusy ? "Sending..." : "Send reset link")</span>
                    @if (!IsBusy)
                    {
                        <span class="arrow">→</span>
                    }
                </button>
            }
            else if (Stage == FlowStage.AwaitingEmail)
            {
                <div class="form-heading">
                    <h2>Check your email</h2>

                    <p>
                        If an account exists for
                        <strong>@Email</strong>,
                        we've sent a password reset link.
                    </p>

                    <p>
                        Check your inbox and follow the link to create a new password.
                    </p>
                </div>

                <button type="button"
                        class="secondary-link"
                        @onclick="RestartFlow">
                    Use a different email
                </button>
            }
            else if (Stage == FlowStage.SetNewPassword)
            {
                <div class="form-heading">
                    <h2>Create a new password</h2>
                    <p>Choose a new password for <strong>@Email</strong>.</p>
                </div>

                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <p class="form-error">@ErrorMessage</p>
                }

                <div class="form-group">
                    <label for="new-password">New password</label>

                    <div class="password-input-wrapper">
                        <input id="new-password"
                               type="@(ShowNewPassword ? "text" : "password")"
                               placeholder="At least 12 characters"
                               autocomplete="new-password"
                               @bind="NewPassword"
                               @bind:event="oninput" />

                        <button type="button"
                                class="password-toggle-button"
                                aria-label="@(ShowNewPassword ? "Hide password" : "Show password")"
                                @onclick="() => ShowNewPassword = !ShowNewPassword">
                            @((MarkupString)(ShowNewPassword ? EyeOffIcon : EyeIcon))
                        </button>
                    </div>

                    <span class="field-hint">Needs an uppercase letter, a lowercase letter and a number.</span>
                </div>

                <div class="form-group">
                    <label for="confirm-password">Confirm new password</label>

                    <div class="password-input-wrapper">
                        <input id="confirm-password"
                               type="@(ShowConfirmPassword ? "text" : "password")"
                               placeholder="Re-enter the password above"
                               autocomplete="new-password"
                               @bind="ConfirmPassword"
                               @bind:event="oninput"
                               @onkeydown="HandlePasswordKeyDown" />

                        <button type="button"
                                class="password-toggle-button"
                                aria-label="@(ShowConfirmPassword ? "Hide password" : "Show password")"
                                @onclick="() => ShowConfirmPassword = !ShowConfirmPassword">
                            @((MarkupString)(ShowConfirmPassword ? EyeOffIcon : EyeIcon))
                        </button>
                    </div>
                </div>

                <button type="button" class="primary-button" disabled="@IsBusy" @onclick="HandleResetPassword">
                    <span>@(IsBusy ? "Saving..." : "Reset password")</span>
                    @if (!IsBusy)
                    {
                        <span class="arrow">→</span>
                    }
                </button>

                <button type="button" class="secondary-link" @onclick="RestartFlow">
                    Use a different email
                </button>
            }
            else if (Stage == FlowStage.Done)
            {
                <div class="form-heading">
                    <h2>Password updated</h2>
                    <p>Your password has been reset. You can now sign in with your new password.</p>
                </div>

                <button type="button" class="primary-button" @onclick="GoToLogin">
                    <span>Back to sign in</span>
                    <span class="arrow">→</span>
                </button>
            }

            @if (Stage != FlowStage.Done)
            {
                <div class="back-to-login">
                    <a href="/">Back to sign in</a>
                </div>
            }

        </div>

    </section>

</div>
</ChildContent>
<ErrorContent>
    <div class="forgot-password-page">
        <p class="form-error">Something went wrong loading this page. Please refresh and try again.</p>
    </div>
</ErrorContent>
</ErrorBoundary>

@code {
    /// <summary>
    /// The different screens on this page: enter email, check your email, set a new password, and done.
    /// </summary>
    private enum FlowStage { EnterEmail, AwaitingEmail, SetNewPassword, Done }

    /// <summary>
    /// The email from the reset link in the email (if the user came from the link).
    /// </summary>
    [SupplyParameterFromQuery(Name = "email")]
    private string? EmailFromQuery { get; set; }

    /// <summary>
    /// The reset token from the reset link in the email.
    /// </summary>
    [SupplyParameterFromQuery(Name = "token")]
    private string? TokenFromQuery { get; set; }

    // Minimal inline eye / eye-off icons so the toggle doesn't depend on an
    // emoji or an external icon font - matches the plain-glyph style used
    // elsewhere in the app (search, notifications, etc.).
    private const string EyeIcon = "<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg>";
    private const string EyeOffIcon = "<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-7-11-7a21.3 21.3 0 0 1 5.06-5.94M9.9 4.24A10.4 10.4 0 0 1 12 4c7 0 11 7 11 7a21.3 21.3 0 0 1-3.22 4.36M14.12 14.12a3 3 0 1 1-4.24-4.24\"/><line x1=\"1\" y1=\"1\" x2=\"23\" y2=\"23\"/></svg>";

    private FlowStage Stage = FlowStage.EnterEmail;

    private string Email = string.Empty;
    private string NewPassword = string.Empty;
    private string ConfirmPassword = string.Empty;
    private string? ResetToken;

    private bool ShowNewPassword;
    private bool ShowConfirmPassword;
    private bool IsBusy;
    private string? ErrorMessage;

    /// <summary>
    /// If the user opened the page from the email link, skip straight to the new password screen.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(EmailFromQuery) &&
            !string.IsNullOrWhiteSpace(TokenFromQuery))
        {
            Email = EmailFromQuery;
            ResetToken = TokenFromQuery;
            Stage = FlowStage.SetNewPassword;
        }
    }

    /// <summary>
    /// Lets the user press Enter to send the reset link.
    /// </summary>
    private async Task HandleEmailKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleCheckEmail();
        }
    }

    /// <summary>
    /// Lets the user press Enter to save their new password.
    /// </summary>
    private async Task HandlePasswordKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleResetPassword();
        }
    }

    /// <summary>
    /// Asks the API to email a reset link, then shows the "check your email" screen.
    /// </summary>
    private async Task HandleCheckEmail()
    {
        ErrorMessage = null;

        if (string.IsNullOrWhiteSpace(Email))
        {
            ErrorMessage = "Enter your email address.";
            return;
        }

        IsBusy = true;

        var result = await Auth.ForgotPasswordAsync(Email.Trim());

        IsBusy = false;

        if (result.Error is not null)
        {
            ErrorMessage = result.Error;
            return;
        }

        Stage = FlowStage.AwaitingEmail;
    }

    /// <summary>
    /// Checks the passwords match, then saves the new password using the token from the link.
    /// </summary>
    private async Task HandleResetPassword()
    {
        ErrorMessage = null;

        if (string.IsNullOrWhiteSpace(NewPassword))
        {
            ErrorMessage = "Enter a new password.";
            return;
        }

        if (NewPassword != ConfirmPassword)
        {
            ErrorMessage = "Those passwords don't match.";
            return;
        }

        if (ResetToken is null)
        {
            ErrorMessage = "Something went wrong - please start again.";
            Stage = FlowStage.EnterEmail;
            return;
        }

        IsBusy = true;
        var result = await Auth.ResetPasswordAsync(Email.Trim(), ResetToken, NewPassword);
        IsBusy = false;

        if (!result.Success)
        {
            ErrorMessage = result.Error ?? "Something went wrong. Please try again.";
            return;
        }

        Stage = FlowStage.Done;
    }

    /// <summary>
    /// Clears everything and goes back to the enter email screen.
    /// </summary>
    private void RestartFlow()
    {
        Stage = FlowStage.EnterEmail;
        NewPassword = string.Empty;
        ConfirmPassword = string.Empty;
        ResetToken = null;
        ErrorMessage = null;
    }

    /// <summary>
    /// Takes the user back to the login page.
    /// </summary>
    private void GoToLogin()
    {
        Navigation.NavigateTo("/");
    }
}

