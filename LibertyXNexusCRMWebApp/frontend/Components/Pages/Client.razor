    private static string Money(double? amount) =>
        amount.HasValue ? "R " + amount.Value.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("en-ZA")) : "—";

    private static string FormatPolicyStatus(string status) => status switch
    {
        "Pending" => "In progress",
        "Active" => "Active",
        "Lapsed" => "Lapsed",
        "Cancelled" => "Cancelled",
        "Matured" => "Matured",
        _ => status
    };

    private static string PolicyChipClass(string status) => status switch
    {
        "Active" => "chip-done",
        "Pending" => "chip-progress",
        _ => "chip-muted"
    };

    private static string FormatCaseStatus(string status) => status switch
    {
        "InProgress" => "In progress",
        "AwaitingApproval" => "Awaiting approval",
        "Completed" => "Completed",
        "OnHold" => "On hold",
        _ => status
    };

    private sealed record HomeAction(string Kind, string Title, string Detail, string ActionText,
        DocumentRequestSummary? Request = null, string? Href = null);

    public class ApplicationStep
    {
        public string Title { get; set; } = string.Empty;
        public string DateText { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
    }

    public class ClientUpdate
    {
        public string Title { get; set; } = string.Empty;
        public string DateText { get; set; } = string.Empty;
    }
}

