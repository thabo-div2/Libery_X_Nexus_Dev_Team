@page "/chatbot"
@layout MainLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using frontend.Services
@inject FaqService FaqStore
@inject MarketInformationService MarketStore
@inject MeetingService MeetingStore
@inject ClientService ClientDirectory
@inject CurrentUserService CurrentUser
@inject MathService MathLogic

<PageTitle>Nexus Assistant | Nexus</PageTitle>

<div class="assistant-page">

    <header class="assistant-header">

        <div class="assistant-heading">
            <h1>Nexus assistant</h1>
            <p>Answers admin questions instantly · escalates advice to your adviser</p>
        </div>

        <div class="header-actions">

            <div class="search-box" role="search">
                <span class="search-icon" aria-hidden="true">⌕</span>

                <input aria-label="Search clients, cases, documents" type="text"
                       placeholder="Search clients, cases, documents" />
            </div>

            <a href="/faqs" class="browse-faqs-button">
                Browse FAQs
            </a>

            <NotificationBell />

        </div>

    </header>


    <main class="assistant-content">

        <section class="chat-card">

            <div class="chat-body">

                <div class="message-row assistant-message-row">

                    <div class="assistant-avatar">
                        N
                    </div>

                    <div class="message-content">

                        <div class="message-bubble assistant-bubble">
                            Hi! 👋 I can help with your documents, case status
                            and explain how the process works. What do you need?
                        </div>

                    </div>

                </div>


                @if (ConversationItems.Count > 0)
                {
                    @foreach (var message in ConversationItems)
                    {
                        @if (message.IsAssistant)
                        {
                            <div class="message-row assistant-message-row">

                                <div class="assistant-avatar">
                                    N
                                </div>

                                <div class="message-content">

                                    <div class="message-bubble assistant-bubble">
                                        @message.Text
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(message.TimeText))
                                    {
                                        <span class="message-time">
                                            @message.TimeText
                                        </span>
                                    }

                                </div>

                            </div>
                        }
                        else
                        {
                            <div class="message-row user-message-row">

                                <div class="message-content">

                                    <div class="message-bubble user-bubble">
                                        @message.Text
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(message.TimeText))
                                    {
                                        <span class="message-time">
                                            @message.TimeText
                                        </span>
                                    }

                                </div>

                            </div>
                        }
                    }
                }

                @if (IsThinking)
                {
                    <div class="message-row assistant-message-row">
                        <div class="assistant-avatar">
                            N
                        </div>

                        <div class="message-content">
                            <div class="message-bubble assistant-bubble typing-bubble">
                                <span class="typing-dot"></span>
                                <span class="typing-dot"></span>
                                <span class="typing-dot"></span>
                            </div>
                        </div>
                    </div>
                }


                @if (IsHandedToAdviser)
                {
                    <div class="handoff-card">

                        <div class="handoff-heading">

                            <span class="handoff-icon">♧</span>

                            <strong>HANDED TO YOUR ADVISER</strong>

                        </div>

                        <p>
                            This question requires personalised financial advice.
                            Your adviser can help you with the next step.
                        </p>

                        <a href="/calendar"
                           class="book-call-button">
                            Book a call
                            <span>→</span>
                        </a>

                    </div>
                }

            </div>


            @if (ShowMeetingForm)
            {
                <div class="meeting-request-form" role="region" aria-label="Book a meeting" @onkeydown="HandleMeetingFormKeyDown">
                    <EditForm Model="MeetingModel" OnValidSubmit="SendMeetingRequest" novalidate>
                        <DataAnnotationsValidator />

                        <label>
                            Client
                            <InputSelect @bind-Value="MeetingModel.ClientId">
                                <option value="">Select a client…</option>
                                @foreach (var client in AdvisorClients)
                                {
                                    <option value="@client.ClientId">@client.FirstName @client.LastName</option>
                                }
                            </InputSelect>
                        </label>

                        <ValidationMessage For="() => MeetingModel.ClientId" />

                        @if (!string.IsNullOrWhiteSpace(MatchedClientName))
                        {
                            <p class="meeting-match-note">Booking with @MatchedClientName — change above if that's not who you meant.</p>
                        }

                        <label>
                            Date &amp; time
                            <InputDate Type="InputDateType.DateTimeLocal" min="@MinMeetingTime" @bind-Value="MeetingModel.MeetingDateTime" />
                        </label>
                        <ValidationMessage For="() => MeetingModel.MeetingDateTime" />

                        <label>
                            Notes (optional)
                            <InputText @bind-Value="MeetingModel.Notes" placeholder="What would you like to discuss?" />
                        </label>
                        <ValidationMessage For="() => MeetingModel.Notes" />

                        <div class="meeting-form-actions">
                            <button type="button" class="meeting-cancel-button" @onclick="CloseMeetingForm">Cancel</button>
                            <button type="submit" class="meeting-send-button">Request meeting</button>
                        </div>

                        @if (!string.IsNullOrEmpty(MeetingError))
                        {
                            <p class="assistant-form-error">@MeetingError</p>
                        }

                    </EditForm>
                </div>
            }


            <div class="quick-prompts">

                <button type="button" class="prompt-chip" @onclick='() => SendQuickPrompt("What is FICA and why do you need it?")'>
                    What is FICA and why do you need it?
                </button>

                <button type="button" class="prompt-chip" @onclick='() => SendQuickPrompt("How do I upload a document?")'>
                    How do I upload a document?
                </button>

                <button type="button" class="prompt-chip" @onclick='() => SendQuickPrompt("How do I message my adviser?")'>
                    How do I message my adviser?
                </button>

                <button type="button" class="prompt-chip" @onclick='() => SendQuickPrompt("What is happening in the global markets today?")'>
                    What is happening in the markets today?
                </button>

                <button type="button" class="prompt-chip prompt-link" @onclick='() => SendQuickPrompt("Book a meeting with a client")'>
                    Book a meeting with a client
                </button>

            </div>


            <div class="message-input-area">

                <input type="text"
                       aria-label="Message the assistant"
                       @ref="PromptInput"
                       @bind="PromptText"
                       @bind:event="oninput"
                       @onkeydown="HandlePromptKeyDown"
                       placeholder="Ask about documents, status or next steps..." />

                <button type="button"
                        class="send-button"
                        aria-label="Send message"
                        @onclick="SendMessage"
                        disabled="@IsThinking"
                >

                    @(IsThinking ? "..." : "➤")

                </button>

            </div>

        </section>


        <aside class="assistant-side-column">

            <section class="info-card">

                <div class="info-card-header">
                    <h2>What the assistant can do</h2>
                </div>

                <div class="info-card-body">

                    <div class="capability-item">
                        <span class="capability-dot"></span>
                        <span>Explain required documents</span>
                    </div>

                    <div class="capability-item">
                        <span class="capability-dot"></span>
                        <span>Report live case status</span>
                    </div>

                    <div class="capability-item">
                        <span class="capability-dot"></span>
                        <span>Walk through uploads and signatures</span>
                    </div>

                    <div class="capability-item">
                        <span class="capability-dot"></span>
                        <span>Book or reschedule meetings</span>
                    </div>

                    <div class="capability-item">
                        <span class="capability-dot"></span>
                        <span>Provide current market and economic information</span>
                    </div>

                </div>

            </section>


            <section class="info-card">

                <div class="info-card-header">
                    <h2>Where it stops</h2>
                </div>

                <div class="info-card-body">

                    <div class="restriction-item">
                        <span class="restriction-dot"></span>
                        <span>Product or contribution recommendations</span>
                    </div>

                    <div class="restriction-item">
                        <span class="restriction-dot"></span>
                        <span>Tax or estate advice</span>
                    </div>

                    <div class="restriction-item">
                        <span class="restriction-dot"></span>
                        <span>Anything requiring an FSP licence</span>
                    </div>


                    <div class="compliance-note">
                        Every escalation is logged against the client case
                        so the adviser has full context and an audit trail.
                    </div>

                </div>

            </section>

        </aside>

    </main>

</div>


@code {

    private const int TypingDelayMs = 15;
    private const int DefaultAdvisorId = 1;

    private static readonly string[] MeetingKeywords =
    {
        "book a meeting", "book meeting", "schedule a meeting", "schedule meeting",
        "set up a meeting", "arrange a meeting", "request a meeting"
    };

    private string PromptText { get; set; } = string.Empty;

    private bool IsThinking;
    private bool IsHandedToAdviser { get; set; }

    private List<AssistantConversationItem> ConversationItems { get; set; } = new();

    private int AdvisorId;

    private List<ClientProfile> AdvisorClients = new();
    private string? MatchedClientName;

    private bool ShowMeetingForm;
    /// <summary>
    /// The meeting request form. Its rules (date required and in the future, client required,
    /// notes under 500 characters) live on AdvisorMeetingRequestForm.
    /// </summary>
    private AdvisorMeetingRequestForm MeetingModel = new();

    /// <summary>
    /// Stops the date picker from showing times that have already passed.
    /// </summary>
    private string MinMeetingTime => DateTime.Now.ToString("yyyy-MM-ddTHH:mm", System.Globalization.CultureInfo.InvariantCulture);
    private string? MeetingError;

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.EnsureRestoredAsync();

        AdvisorId = CurrentUser.Id ?? DefaultAdvisorId;
        var (clients, _) = await ClientDirectory.SearchAsync(null, null);
        AdvisorClients = clients;
    }

    private async Task SendQuickPrompt(string text)
    {
        PromptText = text;
        await SendMessage();
    }

    private async Task HandlePromptKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessage();
        }
    }

    private static bool IsAllowedChatMessage(string text)
    {
        var lower = text.ToLowerInvariant();

        var allowedTerms = new[]
        {
        // FAQ / Nexus functionality
        "fica", "document", "documents", "upload", "signature", "sign",
        "case", "cases", "status", "application", "process",
        "profile", "account", "password", "login", "register",
        "adviser", "advisor", "message", "notification",
        "meeting", "calendar", "client", "policy",
        "claim", "claims", "verification",

        // General market information
        "market", "markets", "jse", "rand", "zar", "usd",
        "exchange rate", "stock", "stocks", "share", "shares",
        "interest rate", "inflation", "economy", "economic",
        "financial news", "monetary policy", "sarb",
        "oil", "gold", "commodity", "commodities",

        // General chatbot interaction
        "hello", "hi", "hey", "help"
    };

        return allowedTerms.Any(term => lower.Contains(term));
    }

    private async Task SendMessage()
    {
        var text = PromptText.Trim();

        if (string.IsNullOrWhiteSpace(text) || IsThinking)
        {
            return;
        }

        ConversationItems.Add(new AssistantConversationItem
        {
            Text = text,
            TimeText = DateTime.Now.ToString("HH:mm"),
            IsAssistant = false
        });

        PromptText = string.Empty;

        IsThinking = true;
        IsHandedToAdviser = false;

        await InvokeAsync(StateHasChanged);

        try
        {
            if (LooksLikeMeetingRequest(text))
            {
                await TypeAssistantReply("Sure — pick a client and a time below.");
                OpenMeetingPanel(text);
                return;
            }

            if (LooksLikeMarketQuestion(text))
            {
                var (marketInfo, marketError) = await MarketStore.GetAsync(text);

                if (marketError is not null)
                {
                    await TypeAssistantReply(marketError);
                    IsHandedToAdviser = false;
                    return;
                }

                if (marketInfo is not null)
                {
                    await TypeAssistantReply(BuildMarketReply(marketInfo));
                    IsHandedToAdviser = false;
                    return;
                }
            }

            if (MathLogic.LooksLikeMathQuestion(text))
            {
                var answer = MathLogic.Solve(text);

                await TypeAssistantReply(answer);
                IsHandedToAdviser = false;
                return;
            }

            if (!IsAllowedChatMessage(text))
            {
                await TypeAssistantReply(
                    "I can only help with Nexus FAQs, documents, cases, meetings, and general market information. Please ask a question related to one of these areas.");

                IsHandedToAdviser = false;
                return;
            }

            var (matches, error) = await FaqStore.SearchAsync(text);

            string replyText;
            var handoff = false;

            if (error is not null)
            {
                replyText = error;
            }
            else if (matches.Count > 0)
            {
                var bestMatch = matches[0];
                replyText = bestMatch.Answer;
                handoff = bestMatch.RequiresHandoff;
            }
            else
            {
                replyText =
                    "I don't have an answer for that one on file — I'll pass it along to your adviser so they can help.";

                handoff = true;
            }

            await TypeAssistantReply(replyText);
            IsHandedToAdviser = handoff;
        }
        finally
        {
            IsThinking = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task TypeAssistantReply(string text)
    {
        var message = new AssistantConversationItem
        {
            Text = string.Empty,
            TimeText = DateTime.Now.ToString("HH:mm"),
            IsAssistant = true
        };

        ConversationItems.Add(message);

        foreach (var character in text)
        {
            message.Text += character;
            StateHasChanged();
            await Task.Delay(TypingDelayMs);
        }
    }

    private static bool LooksLikeMarketQuestion(string text)
    {
        var lower = text.ToLowerInvariant();

        var marketTerms = new[]
        {
            "market", "markets", "jse", "rand", "zar", "usd/zar", "exchange rate",
            "stock", "stocks", "share price", "shares", "s&p", "nasdaq", "dow jones",
            "interest rate", "interest rates", "inflation", "economy", "economic",
            "economic news", "financial news", "monetary policy", "federal reserve", "fed",
            "sarb", "oil price", "oil prices", "gold price", "gold prices", "commodity",
            "commodities", "global finance", "financial markets", "recession"
        };

        return marketTerms.Any(term => lower.Contains(term));
    }

    private static string BuildMarketReply(MarketInformationResult result)
    {
        var lines = new List<string>
    {
        "Here is the latest market information:",
        string.Empty
    };

        if (!string.IsNullOrWhiteSpace(result.UsdZarRate))
        {
            lines.Add($"USD/ZAR: {result.UsdZarRate}");
            lines.Add(string.Empty);
        }

        if (result.News.Count > 0)
        {
            lines.Add("Latest financial news:");

            foreach (var item in result.News.Take(3))
            {
                var published = FormatPublishedTime(item.PublishedAt);
                var source = string.IsNullOrWhiteSpace(item.Source)
                    ? "Unknown source"
                    : item.Source;

                lines.Add($"• {item.Title}");
                lines.Add($"  {source}{published}");
                lines.Add(string.Empty);
            }
        }

        lines.Add("This is general market information, not personalised investment advice.");

        return string.Join(Environment.NewLine, lines);
    }

    private static string FormatPublishedTime(string publishedAt)
    {
        if (DateTime.TryParseExact(
                publishedAt,
                "yyyyMMdd'T'HHmmss",
                System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.AssumeUniversal,
                out var parsed))
        {
            return $" · {parsed.ToLocalTime():d MMM yyyy, HH:mm} SAST";
        }

        return string.Empty;
    }

    private static bool LooksLikeMeetingRequest(string text)
    {
        var lower = text.ToLowerInvariant();
        return MeetingKeywords.Any(keyword => lower.Contains(keyword));
    }

    private void OpenMeetingPanel(string? clientNameHint)
    {
        ShowMeetingForm = true;
        MeetingError = null;
        MeetingModel = new();
        MatchedClientName = null;

        if (!string.IsNullOrWhiteSpace(clientNameHint))
        {
            var match = FindClientByName(clientNameHint);
            if (match is not null)
            {
                MeetingModel.ClientId = match.ClientId;
                MatchedClientName = $"{match.FirstName} {match.LastName}";
            }
        }
    }

    private ClientProfile? FindClientByName(string text)
    {
        var lower = text.ToLowerInvariant();
        var words = lower.Split(new[] { ' ', ',', '.', '?', '!', ':', ';' }, StringSplitOptions.RemoveEmptyEntries);

        return AdvisorClients.FirstOrDefault(c =>
            lower.Contains($"{c.FirstName} {c.LastName}".ToLowerInvariant()) ||
            words.Contains(c.FirstName.ToLowerInvariant()) ||
            words.Contains(c.LastName.ToLowerInvariant()));
    }

    private void CloseMeetingForm()
    {
        ShowMeetingForm = false;
        MeetingError = null;
    }

    /// <summary>
    /// The chat box, so focus can go back to it when the meeting form closes.
    /// </summary>
    private ElementReference PromptInput;

    /// <summary>
    /// Escape inside the meeting form closes it and puts focus back on the chat box,
    /// so keyboard users aren't left stranded when it disappears.
    /// </summary>
    private async Task HandleMeetingFormKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseMeetingForm();
            // The element can be missing if the page changed in the meantime; closing still worked.
            try { await PromptInput.FocusAsync(); } catch (Exception) { }
        }
    }

    private async Task SendMeetingRequest()
    {
        MeetingError = null;

        var meetingDateUtc = DateTime.SpecifyKind(MeetingModel.MeetingDateTime!.Value, DateTimeKind.Local).ToUniversalTime();

        var error = await MeetingStore.RequestAsync(MeetingModel.ClientId!.Value, AdvisorId, fromAdvisor: true, meetingDateUtc, MeetingModel.Notes);

        if (error is not null)
        {
            MeetingError = error;
            return;
        }

        var client = AdvisorClients.FirstOrDefault(c => c.ClientId == MeetingModel.ClientId);
        var confirmationText = $"Meeting booked with {client?.FirstName} {client?.LastName} for {meetingDateUtc.ToLocalTime():d MMM yyyy, HH:mm}.";

        ShowMeetingForm = false;
        MeetingModel = new();
        MatchedClientName = null;

        await TypeAssistantReply(confirmationText);
    }

    public class AssistantConversationItem
    {
        public string Text { get; set; } = string.Empty;

        public string TimeText { get; set; } = string.Empty;

        public bool IsAssistant { get; set; }
    }
}

