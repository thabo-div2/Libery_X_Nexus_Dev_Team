@page "/documents"
@layout MainLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Shared.Models.Enums
@using frontend.Services
@inject DocumentService Document
@inject ClientService ClientApi
@inject PolicyService PolicyApi
@inject CurrentUserService CurrentUser
@inject NavigationManager Navigation

<PageTitle>Documents | Nexus</PageTitle>

<div class="documents-page">

    <header class="documents-header">

        <div class="documents-heading">
            <h1>Documents</h1>
            <p>Generated, uploaded and signed paperwork across all cases</p>
        </div>

        <div class="header-actions">

            @if (IsAdvisorView)
            {
                <div class="search-box" role="search">
                    <span class="search-icon" aria-hidden="true">⌕</span>

                    <input aria-label="Search documents by client or file name"
                           type="search"
                           placeholder="Search by client or file name"
                           @bind="SearchText"
                           @bind:event="oninput" />
                </div>
            }

            <NotificationBell />

        </div>

    </header>


    <main class="documents-content">

        <section class="main-column">

            <article class="documents-card">

                <div class="card-header">

                    <h2>@(IsAdvisorView ? "Documents by client" : "All documents")</h2>

                    @if (IsAdvisorView && DocumentItems.Count > 0 && !IsSearching)
                    {
                        <button type="button"
                                class="visibility-toggle-button"
                                @onclick="ToggleAllGroups">
                            @(AnyGroupExpanded ? "Collapse all" : "Expand all")
                        </button>
                    }

                </div>

                <div class="documents-list">
                    @if (IsLoading)
                    {
                        <div class="empty-state">
                            <strong>Loading...</strong>
                            <span>Please wait while your documents are retrieved.</span>
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
                    {
                        <div class="empty-state">
                            <strong>Unable to load documents</strong>
                            <span>@ErrorMessage</span>
                        </div>
                    }
                    else if (DocumentItems.Count > 0)
                    {
                        var clientGroups = VisibleGroups;

                        if (clientGroups.Count == 0)
                        {
                            <div class="empty-state">
                                <strong>No matching documents</strong>
                                <span>Nothing matches "@SearchText". Try a client name or a file name.</span>
                            </div>
                        }
                        else
                        {
                            foreach (var clientGroup in clientGroups)
                            {
                                var expanded = IsExpanded(clientGroup.ClientId);

                                <section class="client-group" @key="clientGroup.ClientId">

                                    @* Clients only ever see their own documents, so only the advisor gets a heading per client. *@
                                    @if (IsAdvisorView)
                                    {
                                        <button type="button"
                                                class="client-group-header"
                                                aria-expanded="@(expanded ? "true" : "false")"
                                                @onclick="() => ToggleGroup(clientGroup.ClientId)">
                                            <span class="client-group-chevron @(expanded ? "is-open" : "")" aria-hidden="true">›</span>
                                            <span class="client-group-name">@clientGroup.ClientName</span>
                                            <span class="client-group-count">@FormatCount(clientGroup.Documents.Count)</span>
                                        </button>
                                    }

                                    @if (expanded)
                                    {
                                        <div class="client-group-body">
                                            @foreach (var document in clientGroup.Documents)
                                            {
                                                <div class="document-row">

                                                    <div class="document-main">

                                                        <span class="document-icon">▤</span>

                                                        <div class="document-info">

                                                            <strong>@document.Name</strong>

                                                            <span>
                                                                @if (!string.IsNullOrWhiteSpace(document.Type))
                                                                {
                                                                    <span>@document.Type</span>
                                                                }

                                                                @if (!string.IsNullOrWhiteSpace(document.PolicyName))
                                                                {
                                                                    <span> · @document.PolicyName</span>
                                                                }

                                                                @if (!string.IsNullOrWhiteSpace(document.DateText))
                                                                {
                                                                    <span> · @document.DateText</span>
                                                                }
                                                            </span>

                                                        </div>

                                                    </div>


                                                    <div class="document-actions">

                                                        @if (!string.IsNullOrWhiteSpace(document.Status))
                                                        {
                                                            <span class="document-status @GetStatusClass(document.Status)">
                                                                <span class="status-dot"></span>
                                                                @document.Status
                                                            </span>
                                                        }

                                                        @if (IsAdvisorView && document.SignatureStatus == "Awaiting")
                                                        {
                                                            <button type="button"
                                                                    class="visibility-toggle-button"
                                                                    title="Mark this document as signed"
                                                                    disabled="@IsSavingSignature"
                                                                    @onclick="@(() => SetSignatureAsync(document.Id, "Signed"))">
                                                                Sign off
                                                            </button>
                                                        }
                                                        else if (IsAdvisorView && document.SignatureStatus != "Signed")
                                                        {
                                                            <button type="button"
                                                                    class="visibility-toggle-button"
                                                                    title="Mark this document as waiting for a signature"
                                                                    disabled="@IsSavingSignature"
                                                                    @onclick="@(() => SetSignatureAsync(document.Id, "Awaiting"))">
                                                                Needs signature
                                                            </button>
                                                        }

                                                        @if (CurrentUser.IsAdvisor)
                                                        {
                                                            <button type="button"
                                                                class="visibility-toggle-button"
                                                                title="@(document.VisibleToClient ? "Hide from client" : "Share with client")"
                                                                aria-label="@(document.VisibleToClient ? "Hide from client" : "Share with client")"
                                                                    @onclick="() => ToggleVisibilityAsync(document.Id)">
                                                                @(document.VisibleToClient ? "Hide" : "Share")
                                                                </button>
                                                        }

                                                        <button type="button"
                                                                class="download-button"
                                                                title="Download"
                                                                aria-label="Download document"
                                                                @onclick="() => DownloadDocumentAsync(document.Id)">
                                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                                                        </button>

                                                        @if (IsAdvisorView)
                                                        {
                                                            @if (ConfirmDeleteId == document.Id)
                                                            {
                                                                <button type="button"
                                                                        class="visibility-toggle-button delete-confirm-button"
                                                                        disabled="@(DeletingId is not null)"
                                                                        @onclick="() => DeleteDocumentAsync(document.Id)">
                                                                    @(DeletingId == document.Id ? "Deleting…" : "Confirm delete")
                                                                </button>

                                                                <button type="button"
                                                                        class="visibility-toggle-button"
                                                                        disabled="@(DeletingId is not null)"
                                                                        @onclick="CancelDelete">
                                                                    Keep
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                <button type="button"
                                                                        class="visibility-toggle-button"
                                                                        title="Delete this document permanently"
                                                                        disabled="@(DeletingId is not null)"
                                                                        @onclick="() => AskToDelete(document.Id)">
                                                                    Delete
                                                                </button>
                                                            }
                                                        }

                                                    </div>

                                                </div>
                                            }
                                        </div>
                                    }

                                </section>
                            }
                        }
                    }
                    else
                    {
                        <div class="empty-state">

                            <div class="empty-icon">▤</div>

                            <strong>No documents available</strong>

                            <span>
                                Generated and uploaded documents will appear here.
                            </span>

                        </div>
                    }
                </div>
                

            </article>

        </section>


        <aside class="side-column">

            @if (IsAdvisorView)
            {
                <section class="side-card upload-card">

                    <div class="side-card-header">
                        <h2>Upload a document</h2>
                    </div>

                    <div class="upload-card-body">

                        @if (!string.IsNullOrWhiteSpace(UploadError))
                        {
                            <p class="nx-alert nx-alert-danger" role="alert">@UploadError</p>
                        }

                        @if (UploadClients.Count == 0)
                        {
                            <div class="small-empty-state">
                                Add a client before uploading documents.
                            </div>
                        }
                        else
                        {
                            <label class="nx-label" for="upload-client">Client</label>

                            <select id="upload-client"
                                    class="nx-input"
                                    value="@UploadClientId"
                                    @onchange="OnUploadClientChangedAsync">
                                <option value="0">Choose a client</option>
                                @foreach (var client in UploadClients)
                                {
                                    <option value="@client.ClientId">@GetClientName(client)</option>
                                }
                            </select>

                            @if (UploadClientId > 0 && !IsLoadingUploadPolicies)
                            {
                                @* The key gives each client a fresh uploader, so a picked file never carries over. *@
                                <DocumentUploader @key="UploadClientId"
                                                  ClientId="UploadClientId"
                                                  Policies="UploadPolicies"
                                                  ForAdvisor="true"
                                                  OnUploaded="OnDocumentUploadedAsync" />
                            }
                        }

                    </div>

                </section>
            }

            <section class="side-card signature-card">

                <div class="side-card-header">
                    <h2>Awaiting signature</h2>
                </div>


                <div class="signature-list">

                    @if (AwaitingSignatures.Count > 0)
                    {
                        @foreach (var item in AwaitingSignatures)
                        {
                            <div class="signature-row">

                                <div class="signature-info">

                                    <span class="signature-icon">▤</span>

                                    <span>
                                        @item.ClientName

                                        @if (!string.IsNullOrWhiteSpace(item.DocumentName))
                                        {
                                            <span> — @item.DocumentName</span>
                                        }
                                    </span>

                                </div>

                                <div class="signature-actions">

                                    <button type="button"
                                            class="signature-button signature-button-primary"
                                            title="Mark this document as signed"
                                            disabled="@IsSavingSignature"
                                            @onclick="@(() => SetSignatureAsync(item.DocumentId, "Signed"))">
                                        Sign off
                                    </button>

                                    <button type="button"
                                            class="signature-button"
                                            title="This document doesn't need a signature"
                                            disabled="@IsSavingSignature"
                                            @onclick="@(() => SetSignatureAsync(item.DocumentId, "NotRequired"))">
                                        Not needed
                                    </button>

                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="small-empty-state">
                            No documents awaiting signature
                        </div>
                    }

                </div>

            </section>

        </aside>

    </main>

</div>


@code {

    private List<DocumentItem> DocumentItems { get; set; } = new();

    private List<SignatureItem> AwaitingSignatures { get; set; } = new();

    private bool IsLoading { get; set; }

    private string? ErrorMessage { get; set; }

    /// <summary>
    /// True when the advisor is looking at the page, which turns on grouping by client and the search box.
    /// </summary>
    private bool IsAdvisorView { get; set; }

    private string SearchText { get; set; } = string.Empty;

    private bool IsSearching => !string.IsNullOrWhiteSpace(SearchText);

    // Clients the advisor has collapsed. Kept by client id so it survives the list reloading.
    private readonly HashSet<int> CollapsedClients = new();

    // Upload panel (advisor only).
    private List<ClientProfile> UploadClients { get; set; } = new();

    private List<PolicySummary> UploadPolicies { get; set; } = new();

    private int UploadClientId { get; set; }

    private bool IsLoadingUploadPolicies { get; set; }

    private string? UploadError { get; set; }

    // The document the advisor has been asked to confirm deleting, and the one being deleted.
    private int? ConfirmDeleteId { get; set; }

    private int? DeletingId { get; set; }

    // True while a signature change is saving, so a second click can't send it twice.
    private bool IsSavingSignature { get; set; }

    /// <summary>
    /// The documents that match the search, grouped by client and sorted by client name.
    /// </summary>
    private List<ClientDocumentGroup> VisibleGroups
    {
        get
        {
            var term = (SearchText ?? string.Empty).Trim();

            IEnumerable<DocumentItem> items = DocumentItems;

            if (term.Length > 0)
            {
                items = items.Where(d => MatchesSearch(d, term));
            }

            return items
                .GroupBy(d => d.ClientId)
                .Select(g => new ClientDocumentGroup
                {
                    ClientId = g.Key,
                    ClientName = g.First().ClientName,
                    Documents = g.ToList()
                })
                .OrderBy(g => g.ClientName, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
    }

    private bool AnyGroupExpanded => DocumentItems.Any(d => !CollapsedClients.Contains(d.ClientId));


    /// <summary>
    /// Later, load documents, templates and documents awaiting
    /// signature from the application's service layer.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await LoadDocumentsAsync();

        if (IsAdvisorView)
        {
            await LoadUploadClientsAsync();
        }
    }

    private async Task LoadDocumentsAsync()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            await CurrentUser.EnsureRestoredAsync();

            if (CurrentUser.Id is null)
            {
                ErrorMessage = "You need to be signed in to view your documents.";
                return;
            }

            (List<DocumentSummary>? Documents, string? Error) result;

            if (CurrentUser.IsAdvisor)
            {
                IsAdvisorView = true;
                result = await Document.GetForAdvisorAsync(CurrentUser.Id.Value);
            }
            else if (CurrentUser.IsClient)
            {
                IsAdvisorView = false;
                result = await Document.GetForClientAsync(CurrentUser.Id.Value);
            }
            else
            {
                ErrorMessage = "Unknown user role.";
                return;
            }

            if (!string.IsNullOrWhiteSpace(result.Error))
            {
                ErrorMessage = result.Error;
                return;
            }

            var documents = result.Documents ?? new List<DocumentSummary>();

            // All documents. The API sends the client and policy names with the advisor's list.
            DocumentItems = documents
                .Select(document => new DocumentItem
                {
                    Id = document.DocumentId,
                    ClientId = document.ClientId,
                    ClientName = string.IsNullOrWhiteSpace(document.ClientName) ? $"Client {document.ClientId}" : document.ClientName,
                    PolicyName = document.PolicyName ?? string.Empty,
                    Name = document.FileName,
                    Type = document.DocumentType,
                    DateText = FormatDate(document.UpdateAt),
                    Status = GetDocumentStatus(document),
                    SignatureStatus = document.SignatureStatus ?? string.Empty,
                    VisibleToClient = document.VisibleToClient
                })
                .ToList();

            AwaitingSignatures = documents
                .Where(d => d.SignatureStatus == "Awaiting")
                .Select(d => new SignatureItem
                {
                    DocumentId = d.DocumentId,
                    ClientName = string.IsNullOrWhiteSpace(d.ClientName) ? $"Client {d.ClientId}" : d.ClientName,
                    DocumentName = d.FileName
                })
                .ToList();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Unable to load documents: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    /// <summary>
    /// A document matches when the search text appears in its file name, client, type or policy.
    /// </summary>
    private static bool MatchesSearch(DocumentItem document, string term)
    {
        return document.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
            || document.ClientName.Contains(term, StringComparison.OrdinalIgnoreCase)
            || document.Type.Contains(term, StringComparison.OrdinalIgnoreCase)
            || document.PolicyName.Contains(term, StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>
    /// A client's documents show unless the advisor collapsed them. Searching opens every
    /// group so a match is never hidden.
    /// </summary>
    private bool IsExpanded(int clientId)
    {
        return !IsAdvisorView || IsSearching || !CollapsedClients.Contains(clientId);
    }

    private void ToggleGroup(int clientId)
    {
        if (!CollapsedClients.Remove(clientId))
        {
            CollapsedClients.Add(clientId);
        }
    }

    private void ToggleAllGroups()
    {
        if (AnyGroupExpanded)
        {
            foreach (var clientId in DocumentItems.Select(d => d.ClientId).Distinct())
            {
                CollapsedClients.Add(clientId);
            }
        }
        else
        {
            CollapsedClients.Clear();
        }
    }

    /// <summary>
    /// Loads the advisor's clients for the upload panel's client list.
    /// </summary>
    private async Task LoadUploadClientsAsync()
    {
        var (clients, error) = await ClientApi.SearchAsync(null, null);

        UploadError = error;
        UploadClients = clients
            .OrderBy(client => GetClientName(client), StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    /// <summary>
    /// Every document is filed under one of the client's policies, so load them when a client is picked.
    /// </summary>
    private async Task OnUploadClientChangedAsync(ChangeEventArgs e)
    {
        UploadError = null;
        UploadPolicies = new List<PolicySummary>();
        UploadClientId = int.TryParse(e.Value?.ToString(), out var clientId) ? clientId : 0;

        if (UploadClientId <= 0)
        {
            return;
        }

        IsLoadingUploadPolicies = true;

        try
        {
            var (policies, error) = await PolicyApi.GetForClientAsync(UploadClientId);

            // The advisor may have picked a different client while this one was loading.
            if (UploadClientId != clientId)
            {
                return;
            }

            UploadError = error;
            UploadPolicies = policies;
        }
        finally
        {
            IsLoadingUploadPolicies = false;
        }
    }

    /// <summary>
    /// Shows the new document in the list straight away, with its client's group open.
    /// </summary>
    private async Task OnDocumentUploadedAsync(DocumentSummary document)
    {
        CollapsedClients.Remove(document.ClientId);
        await LoadDocumentsAsync();
    }

    private static string GetClientName(ClientProfile client)
    {
        return string.IsNullOrWhiteSpace(client.FullName)
            ? $"{client.FirstName} {client.LastName}".Trim()
            : client.FullName;
    }

    private static string FormatCount(int count)
    {
        return count == 1 ? "1 document" : $"{count} documents";
    }

    private static string FormatDate(DateTime? date)
    {
        return date.HasValue
            ? date.Value.ToLocalTime().ToString("dd MMM yyyy")
            : string.Empty;
    }

    private static string GetDocumentStatus(DocumentSummary d) => d.SignatureStatus switch
    {
        "Awaiting" => "Awaiting signature",
        "Signed" => "Signed",
        _ => d.VisibleToClient ? "Available" : "Private"
    };

    private static string GetStatusClass(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "signed" => "status-signed",
            "awaiting signature" => "status-awaiting",
            "expired" => "status-expired",
            "draft" => "status-draft",
            "available" => "status-signed",
            "private" => "status-neutral",
            _ => "status-neutral"
        };
    }

    private async Task DownloadDocumentAsync(int documentId)
    {
        var result = await Document.GetDownloadUrlAsync(documentId);

        if (!string.IsNullOrWhiteSpace(result.Error))
        {
            ErrorMessage = result.Error;
            return;
        }

        if (!string.IsNullOrWhiteSpace(result.Url))
        {
            Navigation.NavigateTo(result.Url, forceLoad: true);
        }
    }

    private async Task ToggleVisibilityAsync(int documentId)
    {
        var document = DocumentItems.FirstOrDefault(d => d.Id == documentId);

        if (document is null)
        {
            return;
        }

        var result = await Document.SetVisibilityAsync(documentId,!document.VisibleToClient);

        if (!string.IsNullOrWhiteSpace(result.Error))
        {
            ErrorMessage = result.Error;
            return;
        }

        await LoadDocumentsAsync();
    }


    public class ClientDocumentGroup
    {
        public int ClientId { get; set; }

        public string ClientName { get; set; } = string.Empty;

        public List<DocumentItem> Documents { get; set; } = new();
    }

    /// <summary>
    /// Changes a document's signature status: "Awaiting" asks for a signature, "Signed" signs it off
    /// and "NotRequired" clears the request. Then reloads so the list and the side panel agree.
    /// </summary>
    private async Task SetSignatureAsync(int documentId, string signatureStatus)
    {
        if (IsSavingSignature)
        {
            return;
        }

        IsSavingSignature = true;

        try
        {
            var result = await Document.SetSignatureStatusAsync(documentId, signatureStatus);

            if (!string.IsNullOrWhiteSpace(result.Error))
            {
                ErrorMessage = result.Error;
                return;
            }

            await LoadDocumentsAsync();
        }
        finally
        {
            IsSavingSignature = false;
        }
    }


    private void AskToDelete(int documentId)
    {
        ConfirmDeleteId = documentId;
        ErrorMessage = null;
    }

    private void CancelDelete()
    {
        ConfirmDeleteId = null;
    }

    /// <summary>
    /// Deletes the document and its stored file. It only runs after the advisor confirms, because it can't be undone.
    /// </summary>
    private async Task DeleteDocumentAsync(int documentId)
    {
        if (DeletingId is not null)
        {
            return;
        }

        DeletingId = documentId;

        try
        {
            var error = await Document.DeleteAsync(documentId);

            if (!string.IsNullOrWhiteSpace(error))
            {
                ErrorMessage = error;
                return;
            }

            ConfirmDeleteId = null;
            await LoadDocumentsAsync();
        }
        finally
        {
            DeletingId = null;
        }
    }


    public class DocumentItem
    {
        public int Id { get; set; }

        public int ClientId { get; set; }

        public string ClientName { get; set; } = string.Empty;

        public string PolicyName { get; set; } = string.Empty;

        public string Name { get; set; } = string.Empty;

        public string Type { get; set; } = string.Empty;

        public string DateText { get; set; } = string.Empty;

        public string Status { get; set; } = string.Empty;

        /// <summary>The raw status from the API: "Awaiting", "Signed" or "NotRequired".</summary>
        public string SignatureStatus { get; set; } = string.Empty;

        public bool VisibleToClient { get; set; }
    }

    public class SignatureItem
    {
        public int DocumentId { get; set; }

        public string ClientName { get; set; } = string.Empty;

        public string DocumentName { get; set; } = string.Empty;
    }
}

@* //-----------------------------------------------------------------------------0o0o0o End of File 0o0o0o0o0o-------------------------------------------------------------------------------------------------// *@
