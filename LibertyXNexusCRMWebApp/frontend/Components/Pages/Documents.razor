@page "/documents"
@layout MainLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Shared.Models.Enums
@using frontend.Services
@inject DocumentService Document
@inject ClientService ClientApi
@inject PolicyService PolicyApi
@inject CurrentUserService CurrentUser
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject InsightsService Insights
@inject WorkflowService Workflow
@using Shared.DTOs.Workflow
@implements IAsyncDisposable

<PageTitle>Documents | Nexus</PageTitle>

<div class="documents-page">

    <header class="documents-header">

        <div class="documents-heading">
            <h1>Documents</h1>
            @if (IsAdvisorView && HasLoadedDocuments)
            {
                <p>@FilterCount("review") to review · @FilterCount("awaiting") awaiting signature</p>
            }
            else
            {
                <p>Generated, uploaded and signed paperwork across all cases</p>
            }
        </div>

        <div class="header-actions">

            @if (IsAdvisorView)
            {
                <div class="search-box" role="search">
                    <span class="search-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></span>

                    <input aria-label="Search documents by client or file name"
                           type="search"
                           placeholder="Search by client or file name"
                           @bind="SearchText"
                           @bind:event="oninput" />
                </div>

                <button type="button" class="nx-btn nx-btn-primary nx-btn-sm documents-header-btn"
                        aria-expanded="@ShowUpload" @onclick="() => ShowUpload = !ShowUpload">
                    Upload
                </button>

                <button type="button" class="nx-btn nx-btn-secondary nx-btn-sm documents-header-btn"
                        aria-expanded="@ShowBulkRequest" @onclick="() => ShowBulkRequest = !ShowBulkRequest">
                    Request from several clients
                </button>

                <button type="button" class="nx-btn nx-btn-secondary nx-btn-sm documents-header-btn"
                        disabled="@IsExporting" @onclick="ExportDocumentsAsync"
                        title="Download a CSV of every document across your clients">
                    @(IsExporting ? "Exporting…" : "Export CSV")
                </button>
            }

            <NotificationBell />

        </div>

    </header>


    @if (ExportError is not null)
    {
        <p class="nx-alert nx-alert-danger documents-export-error" role="alert">@ExportError</p>
    }

    <main class="documents-content">

        <section class="main-column">

            @if (IsAdvisorView && ShowBulkRequest)
            {
                <BulkDocumentRequest OnClose="() => ShowBulkRequest = false" />
            }

            @if (IsAdvisorView && ShowUpload)
            {
                <section class="side-card upload-card">
                    <div class="side-card-header">
                        <h2>Upload a document</h2>
                        <button type="button" class="visibility-toggle-button" @onclick="() => ShowUpload = false">Close</button>
                    </div>
                    <div class="upload-card-body">
                        @if (!string.IsNullOrWhiteSpace(UploadError))
                        {
                            <p class="nx-alert nx-alert-danger" role="alert">@UploadError</p>
                        }

                        @if (UploadClients.Count == 0)
                        {
                            <div class="small-empty-state">Add a client before uploading documents.</div>
                        }
                        else
                        {
                            <label class="nx-label" for="upload-client">Client</label>
                            <select id="upload-client" class="nx-input" value="@UploadClientId" @onchange="OnUploadClientChangedAsync">
                                <option value="0">Choose a client</option>
                                @foreach (var client in UploadClients)
                                {
                                    <option value="@client.ClientId">@GetClientName(client)</option>
                                }
                            </select>

                            @if (UploadClientId > 0 && !IsLoadingUploadPolicies)
                            {
                                @* The key gives each client a fresh uploader, so a picked file never carries over. *@
                                <DocumentUploader @key="UploadClientId" ClientId="UploadClientId" Policies="UploadPolicies" ForAdvisor="true" OnUploaded="OnDocumentUploadedAsync" />
                            }
                        }
                    </div>
                </section>
            }

            <article class="documents-card">

                <div class="card-header">

                    <h2>@(IsReviewQueue ? "Review queue" : IsAdvisorView ? "Documents by client" : "All documents")<span class="card-count">@(IsReviewQueue ? FilterCount("review") : DocumentItems.Count)</span></h2>

                    @* The heading row holds only the title and the expand toggle. The status filter
                       always sits on its own row below, so hiding the toggle never moves it. *@
                    <div class="card-tools">
                        @if (IsAdvisorView && DocumentItems.Count > 0 && !IsSearching && !IsFiltering)
                        {
                            <button type="button"
                                    class="visibility-toggle-button"
                                    @onclick="ToggleAllGroups">
                                @(AnyGroupExpanded ? "Collapse all" : "Expand all")
                            </button>
                        }
                    </div>

                    @if (DocumentItems.Count > 0)
                    {
                        var filterIndex = Math.Max(0, Array.FindIndex(StatusFilters, f => f.Key == StatusFilter));

                        <div class="doc-filter-row">
                            <div class="doc-filters" @ref="FilterRef" role="group" aria-label="Filter documents by status"
                                 style="--n:@StatusFilters.Length;--i:@filterIndex">
                                <span class="seg-thumb" aria-hidden="true"></span>
                                @foreach (var filter in StatusFilters)
                                {
                                    <button type="button"
                                            class="filter-pill @(StatusFilter == filter.Key ? "active" : "")"
                                            aria-pressed="@(StatusFilter == filter.Key)"
                                            @onclick="() => SetStatusFilter(filter.Key)">
                                        <span class="filter-label">@filter.Label</span>
                                        <span class="filter-count">@FilterCount(filter.Key)</span>
                                    </button>
                                }
                            </div>
                        </div>
                    }

                </div>

                <div class="documents-list">
                    @if (IsLoading && !HasLoadedDocuments)
                    {
                        <div class="empty-state">
                            <div class="nx-skeleton-stack page-skeleton" role="status"><span class="visually-hidden">Loading documents</span><span class="nx-skeleton"></span><span class="nx-skeleton"></span><span class="nx-skeleton"></span></div>
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
                    {
                        <div class="empty-state">
                            <strong>Unable to load documents</strong>
                            <span>@ErrorMessage</span>
                        </div>
                    }
                    else if (IsReviewQueue)
                    {
                        var queue = ReviewQueue;
                        var current = queue.FirstOrDefault(d => d.Id == SelectedReviewId) ?? queue.FirstOrDefault();

                        @if (current is null)
                        {
                            <div class="empty-state">
                                <div class="empty-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></div>
                                <strong>@(IsSearching ? "No matching documents" : "Review queue is clear")</strong>
                                <span>@(IsSearching ? $"Nothing to review matches \"{SearchText}\"." : "Every client upload has been reviewed.")</span>
                            </div>
                        }
                        else
                        {
                            <div class="review-queue">
                                <ul class="queue-list" aria-label="Documents to review">
                                    @foreach (var item in queue)
                                    {
                                        <li @key="item.Id">
                                            <button type="button" class="queue-item @(item.Id == current.Id ? "is-selected" : "")"
                                                    aria-current="@(item.Id == current.Id ? "true" : null)" @onclick="() => SelectReview(item.Id)">
                                                <span class="document-icon file-@FileKind(item.Name)" aria-hidden="true">@FileExtension(item.Name)</span>
                                                <span class="queue-text"><strong>@(string.IsNullOrWhiteSpace(item.Type) ? item.Name : item.Type)</strong><small>@item.ClientName · @item.DateText</small></span>
                                                @if (item.Replaces is not null) { <span class="queue-tag">Re-upload</span> }
                                            </button>
                                        </li>
                                    }
                                </ul>

                                <section class="queue-detail" aria-live="polite">
                                    <div class="queue-detail-head">
                                        <div>
                                            <span class="queue-eyebrow">@(string.IsNullOrWhiteSpace(current.Type) ? "Document" : current.Type)@(string.IsNullOrWhiteSpace(current.PolicyName) ? "" : $" · {current.PolicyName}")</span>
                                            <h3>@current.ClientName</h3>
                                            <p>@current.Name · uploaded @current.DateText</p>
                                        </div>
                                        <span class="queue-position">@(queue.IndexOf(current) + 1) of @queue.Count</span>
                                    </div>

                                    @if (current.Replaces is not null)
                                    {
                                        <p class="queue-replaces">Replaces @current.Replaces.Name@(string.IsNullOrWhiteSpace(current.Replaces.ReviewNote) ? "" : $", which you sent back: \"{current.Replaces.ReviewNote}\"")</p>
                                    }

                                    <button type="button" class="queue-open" @onclick="() => DownloadDocumentAsync(current.Id)">
                                        <span class="document-icon file-@FileKind(current.Name)" aria-hidden="true">@FileExtension(current.Name)</span>
                                        <span><strong>Open document</strong><small>Check it before you decide</small></span>
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                                    </button>

                                    <label class="queue-note">
                                        <span>Note to the client <em>Required to send it back</em></span>
                                        <textarea maxlength="500" rows="3" placeholder="For example: the page is cut off, please upload a clearer copy."
                                                  @bind="ReviewNote" @bind:event="oninput" disabled="@IsSavingReview"></textarea>
                                    </label>

                                    @if (ReviewError is not null)
                                    {
                                        <p class="nx-alert nx-alert-danger" role="alert">@ReviewError</p>
                                    }

                                    <div class="queue-actions">
                                        <button type="button" class="queue-accept" disabled="@IsSavingReview" @onclick="() => SaveReviewAsync(current, DocumentReviewStatus.Accepted)">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
                                            @(IsSavingReview ? "Saving…" : queue.Count > 1 ? "Accept and next" : "Accept")
                                        </button>
                                        <button type="button" class="queue-reject" disabled="@(IsSavingReview || string.IsNullOrWhiteSpace(ReviewNote))"
                                                title="@(string.IsNullOrWhiteSpace(ReviewNote) ? "Add a note so the client knows what to fix" : null)"
                                                @onclick="() => SaveReviewAsync(current, DocumentReviewStatus.NeedsReplacement)">
                                            Needs replacement
                                        </button>
                                    </div>
                                </section>
                            </div>
                        }
                    }
                    else if (DocumentItems.Count > 0)
                    {
                        var clientGroups = VisibleGroups;

                        if (clientGroups.Count == 0)
                        {
                            <div class="empty-state">
                                <strong>No matching documents</strong>
                                @if (IsSearching)
                                {
                                    <span>Nothing matches "@SearchText". Try a client name or a file name.</span>
                                }
                                else
                                {
                                    <span>Nothing is in this view right now. Switch back to All to see every document.</span>
                                }
                            </div>
                        }
                        else
                        {
                            foreach (var clientGroup in clientGroups)
                            {
                                var expanded = IsExpanded(clientGroup.ClientId);

                                <section class="client-group" @key="clientGroup.ClientId">

                                    @* Clients only ever see their own documents, so only the advisor gets a heading per client. *@
                                    @if (IsAdvisorView)
                                    {
                                        <button type="button"
                                                class="client-group-header"
                                                aria-expanded="@(expanded ? "true" : "false")"
                                                @onclick="() => ToggleGroup(clientGroup.ClientId)">
                                            <span class="client-group-chevron @(expanded ? "is-open" : "")" aria-hidden="true">›</span>
                                            <span class="client-group-avatar" aria-hidden="true">@GetInitials(clientGroup.ClientName)</span>
                                            <span class="client-group-name">@clientGroup.ClientName</span>
                                            <span class="client-group-count">@FormatCount(clientGroup.Documents.Count)</span>
                                        </button>
                                    }

                                    @if (expanded)
                                    {
                                        <div class="client-group-body">
                                            @foreach (var document in clientGroup.Documents)
                                            {
                                                <div class="document-row" id="@($"document-{document.Id}")" @key="document.Id">

                                                    <div class="document-main">

                                                        <span class="document-icon file-@FileKind(document.Name)" aria-hidden="true">@FileExtension(document.Name)</span>

                                                        <div class="document-info">

                                                            <div class="document-title-line">
                                                                <strong>@document.Name</strong>
                                                                <span class="review-status review-@document.ReviewStatus.ToLowerInvariant()">@ReviewLabel(document)</span>
                                                            </div>
                                                            @if (document.Replaces is not null)
                                                            {
                                                                <a class="replacement-link" href="@($"#document-{document.Replaces.Id}")">Replacement for @document.Replaces.Name (#@document.Replaces.Id)</a>
                                                            }
                                                            @if (document.ReplacedBy is not null)
                                                            {
                                                                <a class="replacement-link" href="@($"#document-{document.ReplacedBy.Id}")">@(document.ReplacedBy.ReviewStatus == "Accepted" ? "Replacement accepted" : document.ReplacedBy.ReviewStatus == "NeedsReplacement" ? "Replacement also rejected" : "Replacement uploaded - awaiting review") <span>View upload #@document.ReplacedBy.Id</span></a>
                                                            }
                                                            @if (document.ReviewStatus == "NeedsReplacement" && !string.IsNullOrWhiteSpace(document.ReviewNote))
                                                            {
                                                                <p class="rejection-note"><b>Reason:</b> @document.ReviewNote</p>
                                                            }
                                                            @if (IsAdvisorView) { <DocumentReviewPanel @key="document.Id" DocumentId="document.Id" OnReviewed="LoadDocumentsAsync" /> }

                                                            <span>
                                                                @if (!string.IsNullOrWhiteSpace(document.Type))
                                                                {
                                                                    <span>@document.Type</span>
                                                                }

                                                                @if (!string.IsNullOrWhiteSpace(document.PolicyName))
                                                                {
                                                                    <span> · @document.PolicyName</span>
                                                                }

                                                                @if (!string.IsNullOrWhiteSpace(document.DateText))
                                                                {
                                                                    <span> · @document.DateText</span>
                                                                }
                                                            </span>

                                                        </div>

                                                    </div>


                                                    <div class="document-actions">

                                                        @if (!string.IsNullOrWhiteSpace(document.Status))
                                                        {
                                                            <span class="document-status @GetStatusClass(document.Status)">
                                                                <span class="status-dot"></span>
                                                                @document.Status
                                                            </span>
                                                        }

                                                        @if (IsAdvisorView && document.SignatureStatus == "Awaiting")
                                                        {
                                                            <button type="button"
                                                                    class="visibility-toggle-button"
                                                                    title="Mark this document as signed"
                                                                    disabled="@IsSavingSignature"
                                                                    @onclick="@(() => SetSignatureAsync(document.Id, "Signed"))">
                                                                Sign off
                                                            </button>
                                                            <button type="button"
                                                                    class="visibility-toggle-button"
                                                                    title="This document does not need a signature"
                                                                    disabled="@IsSavingSignature"
                                                                    @onclick="@(() => SetSignatureAsync(document.Id, "NotRequired"))">
                                                                Not needed
                                                            </button>
                                                        }
                                                        else if (IsAdvisorView && document.SignatureStatus != "Signed")
                                                        {
                                                            <button type="button"
                                                                    class="visibility-toggle-button"
                                                                    title="Mark this document as waiting for a signature"
                                                                    disabled="@IsSavingSignature"
                                                                    @onclick="@(() => SetSignatureAsync(document.Id, "Awaiting"))">
                                                                Needs signature
                                                            </button>
                                                        }

                                                        @if (CurrentUser.IsAdvisor)
                                                        {
                                                            <button type="button"
                                                                class="visibility-toggle-button"
                                                                title="@(document.VisibleToClient ? "Hide from client" : "Share with client")"
                                                                aria-label="@(document.VisibleToClient ? "Hide from client" : "Share with client")"
                                                                    @onclick="() => ToggleVisibilityAsync(document.Id)">
                                                                @(document.VisibleToClient ? "Hide" : "Share")
                                                                </button>
                                                        }

                                                        <button type="button"
                                                                class="download-button"
                                                                title="Download"
                                                                aria-label="Download document"
                                                                @onclick="() => DownloadDocumentAsync(document.Id)">
                                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                                                        </button>

                                                        @if (IsAdvisorView)
                                                        {
                                                            @if (ConfirmDeleteId == document.Id)
                                                            {
                                                                <button type="button"
                                                                        class="visibility-toggle-button delete-confirm-button"
                                                                        disabled="@(DeletingId is not null)"
                                                                        @onclick="() => DeleteDocumentAsync(document.Id)">
                                                                    @(DeletingId == document.Id ? "Deleting…" : "Confirm delete")
                                                                </button>

                                                                <button type="button"
                                                                        class="visibility-toggle-button"
                                                                        disabled="@(DeletingId is not null)"
                                                                        @onclick="CancelDelete">
                                                                    Keep
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                <button type="button"
                                                                        class="visibility-toggle-button"
                                                                        title="Delete this document permanently"
                                                                        disabled="@(DeletingId is not null)"
                                                                        @onclick="() => AskToDelete(document.Id)">
                                                                    Delete
                                                                </button>
                                                            }
                                                        }

                                                    </div>

                                                </div>
                                            }
                                        </div>
                                    }

                                </section>
                            }
                        }
                    }
                    else
                    {
                        <div class="empty-state">

                            <div class="empty-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6"/><path d="M9 17h4"/></svg></div>

                            <strong>No documents available</strong>

                            <span>
                                Generated and uploaded documents will appear here.
                            </span>

                        </div>
                    }
                </div>
                

            </article>

        </section>



    </main>

</div>


<RealtimeRefresh OnChanged="LoadDocumentsAsync" />

@code {

    // Lets the status filter be dragged as well as clicked (see Common/SegmentedDragBinding.cs).
    private ElementReference FilterRef;
    private SegmentedDragBinding? FilterDrag;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        FilterDrag ??= new SegmentedDragBinding(JS, PickFilterAsync);
        await FilterDrag.BindAsync(FilterRef);
    }

    private async Task PickFilterAsync(int index)
    {
        if (index < 0 || index >= StatusFilters.Length) return;
        SetStatusFilter(StatusFilters[index].Key);
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (FilterDrag is not null) await FilterDrag.DisposeAsync();
    }

    private List<DocumentItem> DocumentItems { get; set; } = new();

    private bool IsLoading { get; set; }
    // Background refreshes must preserve the keyed rows and any open review dialog.
    private bool HasLoadedDocuments;

    private string? ErrorMessage { get; set; }

    /// <summary>
    /// True when the advisor is looking at the page, which turns on grouping by client and the search box.
    /// </summary>
    private bool IsAdvisorView { get; set; }

    private string SearchText { get; set; } = string.Empty;

    private bool IsSearching => !string.IsNullOrWhiteSpace(SearchText);

    // Clients the advisor has collapsed. Kept by client id so it survives the list reloading.
    private readonly HashSet<int> CollapsedClients = new();

    // Upload panel (advisor only).
    private List<ClientProfile> UploadClients { get; set; } = new();

    private List<PolicySummary> UploadPolicies { get; set; } = new();

    private int UploadClientId { get; set; }

    private bool IsLoadingUploadPolicies { get; set; }

    private string? UploadError { get; set; }

    // The document the advisor has been asked to confirm deleting, and the one being deleted.
    private int? ConfirmDeleteId { get; set; }

    private int? DeletingId { get; set; }

    // True while a signature change is saving, so a second click can't send it twice.
    private bool IsSavingSignature { get; set; }

    /// <summary>
    /// The documents that match the search, grouped by client and sorted by client name.
    /// </summary>
    private List<ClientDocumentGroup> VisibleGroups
    {
        get
        {
            var term = (SearchText ?? string.Empty).Trim();

            IEnumerable<DocumentItem> items = DocumentItems;

            if (term.Length > 0)
            {
                items = items.Where(d => MatchesSearch(d, term));
            }

            if (IsFiltering)
            {
                items = items.Where(d => MatchesFilter(d, StatusFilter));
            }

            return items
                .GroupBy(d => d.ClientId)
                .Select(g => new ClientDocumentGroup
                {
                    ClientId = g.Key,
                    ClientName = g.First().ClientName,
                    Documents = g.ToList()
                })
                .OrderBy(g => g.ClientName, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
    }

    // Status filter above the list (advisor and client). Keys match MatchesFilter.
    private static readonly (string Key, string Label)[] StatusFilters =
    {
        ("review", "To review"),
        ("awaiting", "Awaiting signature"),
        ("signed", "Signed"),
        ("all", "All")
    };

    private string StatusFilter { get; set; } = "review";

    private bool IsFiltering => StatusFilter != "all";

    // Review queue (advisor, "To review" tab): one document at a time, oldest first.
    private bool ShowUpload;
    private bool IsReviewQueue => IsAdvisorView && StatusFilter == "review" && DocumentItems.Count > 0;
    private int? SelectedReviewId;
    private string? ReviewNote;
    private string? ReviewError;
    private bool IsSavingReview;

    private List<DocumentItem> ReviewQueue
    {
        get
        {
            var term = (SearchText ?? string.Empty).Trim();
            return DocumentItems
                .Where(d => MatchesFilter(d, "review") && (term.Length == 0 || MatchesSearch(d, term)))
                .OrderBy(d => d.Id)
                .ToList();
        }
    }

    private void SelectReview(int documentId)
    {
        if (IsSavingReview) return;
        SelectedReviewId = documentId;
        ReviewNote = null;
        ReviewError = null;
    }

    private async Task SaveReviewAsync(DocumentItem document, DocumentReviewStatus status)
    {
        if (IsSavingReview) return;
        IsSavingReview = true;
        ReviewError = null;

        try
        {
            // The API rejects a stale review, so read the current version first.
            var (review, error) = await Workflow.GetReviewAsync(document.Id);
            if (review is null) { ReviewError = error ?? "Unable to load this document."; return; }

            var (saved, saveError) = await Workflow.ReviewAsync(document.Id, new() { Status = status, Note = ReviewNote, ExpectedUpdatedAt = review.UpdatedAt });
            if (saved is null) { ReviewError = saveError ?? "Unable to save the review."; return; }

            var queue = ReviewQueue;
            var index = queue.FindIndex(d => d.Id == document.Id);
            SelectedReviewId = queue.Where((d, i) => i > index).Select(d => (int?)d.Id).FirstOrDefault()
                ?? queue.Where((d, i) => i < index).Select(d => (int?)d.Id).LastOrDefault();
            ReviewNote = null;
            await LoadDocumentsAsync();
        }
        finally
        {
            IsSavingReview = false;
        }
    }

    // Bulk document requests and CSV export (advisor view only).
    private bool ShowBulkRequest;
    private bool IsExporting;
    private string? ExportError;

    private async Task ExportDocumentsAsync()
    {
        if (IsExporting) return;
        IsExporting = true;
        ExportError = null;
        try { ExportError = await Insights.DownloadDocumentListAsync(); }
        finally { IsExporting = false; }
    }

    private void SetStatusFilter(string key)
    {
        StatusFilter = key;
    }

    private int FilterCount(string key) => DocumentItems.Count(d => MatchesFilter(d, key));

    private static bool MatchesFilter(DocumentItem document, string key) => key switch
    {
        "awaiting" => document.SignatureStatus == "Awaiting",
        "review" => document.ReviewStatus != "Accepted" && document.ReviewStatus != "NeedsReplacement",
        "signed" => document.SignatureStatus == "Signed",
        _ => true
    };

    private static string GetInitials(string? name)
    {
        var parts = (name ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        if (parts.Length == 0)
        {
            return "?";
        }

        return parts.Length == 1
            ? parts[0][..1].ToUpperInvariant()
            : $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    private static string FileExtension(string? fileName)
    {
        var extension = System.IO.Path.GetExtension(fileName ?? string.Empty).TrimStart('.');

        if (string.IsNullOrEmpty(extension))
        {
            return "FILE";
        }

        return (extension.Length > 4 ? extension[..4] : extension).ToUpperInvariant();
    }

    private static string FileKind(string? fileName) => FileExtension(fileName).ToLowerInvariant() switch
    {
        "pdf" => "pdf",
        "doc" or "docx" => "doc",
        "xls" or "xlsx" or "csv" => "xls",
        "jpg" or "jpeg" or "png" => "img",
        _ => "other"
    };

    private bool AnyGroupExpanded => DocumentItems.Any(d => !CollapsedClients.Contains(d.ClientId));


    /// <summary>
    /// Later, load documents, templates and documents awaiting
    /// signature from the application's service layer.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await LoadDocumentsAsync();

        if (IsAdvisorView)
        {
            await LoadUploadClientsAsync();
        }
    }

    private async Task LoadDocumentsAsync()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            await CurrentUser.EnsureRestoredAsync();

            if (CurrentUser.Id is null)
            {
                ErrorMessage = "You need to be signed in to view your documents.";
                return;
            }

            (List<DocumentSummary>? Documents, string? Error) result;

            if (CurrentUser.IsAdvisor)
            {
                IsAdvisorView = true;
                result = await Document.GetForAdvisorAsync(CurrentUser.Id.Value);
            }
            else if (CurrentUser.IsClient)
            {
                IsAdvisorView = false;
                result = await Document.GetForClientAsync(CurrentUser.Id.Value);
            }
            else
            {
                ErrorMessage = "Unknown user role.";
                return;
            }

            if (!string.IsNullOrWhiteSpace(result.Error))
            {
                ErrorMessage = result.Error;
                return;
            }

            var documents = result.Documents ?? new List<DocumentSummary>();
            var firstLoad = !HasLoadedDocuments;

            // All documents. The API sends the client and policy names with the advisor's list.
            DocumentItems = documents
                .Select(document => new DocumentItem
                {
                    Id = document.DocumentId,
                    ClientId = document.ClientId,
                    PolicyId = document.PolicyId,
                    ClientName = string.IsNullOrWhiteSpace(document.ClientName) ? $"Client {document.ClientId}" : document.ClientName,
                    PolicyName = document.PolicyName ?? string.Empty,
                    Name = document.FileName,
                    Type = document.DocumentType,
                    DateText = FormatDate(document.UpdateAt),
                    Status = GetDocumentStatus(document),
                    ReviewStatus = document.ReviewStatus,
                    ReviewNote = document.ReviewNote,
                    SignatureStatus = document.SignatureStatus ?? string.Empty,
                    VisibleToClient = document.VisibleToClient
                })
                .ToList();

            // Keep replacements within the same client, policy (including general), and type.
            // Identity order preserves upload order when reviews change UpdateAt.
            foreach (var scope in DocumentItems.Where(d => d.VisibleToClient).GroupBy(d => (d.ClientId, d.PolicyId, d.Type)))
            {
                var uploads = scope.OrderBy(d => d.Id).ToList();
                for (var i = 1; i < uploads.Count; i++)
                {
                    var previous = uploads[i - 1];
                    var current = uploads[i];
                    if (previous.ReviewStatus != "NeedsReplacement") continue;
                    previous.ReplacedBy = current;
                    current.Replaces = previous;
                }
            }

            // Open on the queue when there is something to review, otherwise on everything.
            if (firstLoad && (!IsAdvisorView || !DocumentItems.Any(d => MatchesFilter(d, "review"))))
            {
                StatusFilter = "all";
            }

        }
        catch (Exception ex)
        {
            ErrorMessage = $"Unable to load documents: {ex.Message}";
        }
        finally
        {
            HasLoadedDocuments = true;
            IsLoading = false;
        }
    }

    /// <summary>
    /// A document matches when the search text appears in its file name, client, type or policy.
    /// </summary>
    private static bool MatchesSearch(DocumentItem document, string term)
    {
        return document.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
            || document.ClientName.Contains(term, StringComparison.OrdinalIgnoreCase)
            || document.Type.Contains(term, StringComparison.OrdinalIgnoreCase)
            || document.PolicyName.Contains(term, StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>
    /// A client's documents show unless the advisor collapsed them. Searching opens every
    /// group so a match is never hidden.
    /// </summary>
    private bool IsExpanded(int clientId)
    {
        return !IsAdvisorView || IsSearching || IsFiltering || !CollapsedClients.Contains(clientId);
    }

    private void ToggleGroup(int clientId)
    {
        if (!CollapsedClients.Remove(clientId))
        {
            CollapsedClients.Add(clientId);
        }
    }

    private void ToggleAllGroups()
    {
        if (AnyGroupExpanded)
        {
            foreach (var clientId in DocumentItems.Select(d => d.ClientId).Distinct())
            {
                CollapsedClients.Add(clientId);
            }
        }
        else
        {
            CollapsedClients.Clear();
        }
    }

    /// <summary>
    /// Loads the advisor's clients for the upload panel's client list.
    /// </summary>
    private async Task LoadUploadClientsAsync()
    {
        var (clients, error) = await ClientApi.SearchAsync(null, null);

        UploadError = error;
        UploadClients = clients
            .OrderBy(client => GetClientName(client), StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    /// <summary>
    /// Every document is filed under one of the client's policies, so load them when a client is picked.
    /// </summary>
    private async Task OnUploadClientChangedAsync(ChangeEventArgs e)
    {
        UploadError = null;
        UploadPolicies = new List<PolicySummary>();
        UploadClientId = int.TryParse(e.Value?.ToString(), out var clientId) ? clientId : 0;

        if (UploadClientId <= 0)
        {
            return;
        }

        IsLoadingUploadPolicies = true;

        try
        {
            var (policies, error) = await PolicyApi.GetForClientAsync(UploadClientId);

            // The advisor may have picked a different client while this one was loading.
            if (UploadClientId != clientId)
            {
                return;
            }

            UploadError = error;
            UploadPolicies = policies;
        }
        finally
        {
            IsLoadingUploadPolicies = false;
        }
    }

    /// <summary>
    /// Shows the new document in the list straight away, with its client's group open.
    /// </summary>
    private async Task OnDocumentUploadedAsync(DocumentSummary document)
    {
        CollapsedClients.Remove(document.ClientId);
        await LoadDocumentsAsync();
    }

    private static string GetClientName(ClientProfile client)
    {
        return string.IsNullOrWhiteSpace(client.FullName)
            ? $"{client.FirstName} {client.LastName}".Trim()
            : client.FullName;
    }

    private static string FormatCount(int count)
    {
        return count == 1 ? "1 document" : $"{count} documents";
    }

    private static string FormatDate(DateTime? date)
    {
        return date.HasValue
            ? date.Value.ToLocalTime().ToString("dd MMM yyyy")
            : string.Empty;
    }

    private static string GetDocumentStatus(DocumentSummary d) => d.SignatureStatus switch
    {
        "Awaiting" => "Awaiting signature",
        "Signed" => "Signed",
        _ => d.VisibleToClient ? "Available" : "Private"
    };

    private static string GetStatusClass(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "signed" => "status-signed",
            "awaiting signature" => "status-awaiting",
            "expired" => "status-expired",
            "draft" => "status-draft",
            "available" => "status-signed",
            "private" => "status-neutral",
            _ => "status-neutral"
        };
    }

    private async Task DownloadDocumentAsync(int documentId)
    {
        var result = await Document.GetDownloadUrlAsync(documentId);

        if (!string.IsNullOrWhiteSpace(result.Error))
        {
            ErrorMessage = result.Error;
            return;
        }

        if (!string.IsNullOrWhiteSpace(result.Url))
        {
            Navigation.NavigateTo(result.Url, forceLoad: true);
        }
    }

    private async Task ToggleVisibilityAsync(int documentId)
    {
        var document = DocumentItems.FirstOrDefault(d => d.Id == documentId);

        if (document is null)
        {
            return;
        }

        var result = await Document.SetVisibilityAsync(documentId,!document.VisibleToClient);

        if (!string.IsNullOrWhiteSpace(result.Error))
        {
            ErrorMessage = result.Error;
            return;
        }

        await LoadDocumentsAsync();
    }


    public class ClientDocumentGroup
    {
        public int ClientId { get; set; }
        public int? PolicyId { get; set; }
        public DocumentItem? Replaces { get; set; }
        public DocumentItem? ReplacedBy { get; set; }

        public string ClientName { get; set; } = string.Empty;

        public List<DocumentItem> Documents { get; set; } = new();
    }

    /// <summary>
    /// Changes a document's signature status: "Awaiting" asks for a signature, "Signed" signs it off
    /// and "NotRequired" clears the request. Then reloads so the list and the side panel agree.
    /// </summary>
    private async Task SetSignatureAsync(int documentId, string signatureStatus)
    {
        if (IsSavingSignature)
        {
            return;
        }

        IsSavingSignature = true;

        try
        {
            var result = await Document.SetSignatureStatusAsync(documentId, signatureStatus);

            if (!string.IsNullOrWhiteSpace(result.Error))
            {
                ErrorMessage = result.Error;
                return;
            }

            await LoadDocumentsAsync();
        }
        finally
        {
            IsSavingSignature = false;
        }
    }


    private void AskToDelete(int documentId)
    {
        ConfirmDeleteId = documentId;
        ErrorMessage = null;
    }

    private void CancelDelete()
    {
        ConfirmDeleteId = null;
    }

    /// <summary>
    /// Deletes the document and its stored file. It only runs after the advisor confirms, because it can't be undone.
    /// </summary>
    private async Task DeleteDocumentAsync(int documentId)
    {
        if (DeletingId is not null)
        {
            return;
        }

        DeletingId = documentId;

        try
        {
            var error = await Document.DeleteAsync(documentId);

            if (!string.IsNullOrWhiteSpace(error))
            {
                ErrorMessage = error;
                return;
            }

            ConfirmDeleteId = null;
            await LoadDocumentsAsync();
        }
        finally
        {
            DeletingId = null;
        }
    }


    private static string ReviewLabel(DocumentItem document) => document.ReviewStatus switch
    {
        "NeedsReplacement" when document.ReplacedBy is not null => "Rejected - superseded",
        "NeedsReplacement" => "Rejected - replacement required",
        "Accepted" => "Accepted",
        _ => "Awaiting review"
    };

    public class DocumentItem
    {
        public int? PolicyId { get; set; }
        public DocumentItem? Replaces { get; set; }
        public DocumentItem? ReplacedBy { get; set; }
        public int Id { get; set; }

        public int ClientId { get; set; }

        public string ClientName { get; set; } = string.Empty;

        public string PolicyName { get; set; } = string.Empty;

        public string Name { get; set; } = string.Empty;

        public string Type { get; set; } = string.Empty;

        public string DateText { get; set; } = string.Empty;

        public string Status { get; set; } = string.Empty;

        public string ReviewStatus { get; set; } = "Received";
        public string? ReviewNote { get; set; }

        /// <summary>The raw status from the API: "Awaiting", "Signed" or "NotRequired".</summary>
        public string SignatureStatus { get; set; } = string.Empty;

        public bool VisibleToClient { get; set; }
    }

}

